{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "clean": "rm -rf dist tmp node_modules/.vite",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:integration": "./test-integration.sh",
    "screenshots": "npx tsx ../scripts/generate-documentation-screenshots.ts",
    "screenshots:desktop": "npx tsx ../scripts/generate-documentation-screenshots.ts desktop",
    "screenshots:mobile": "npx tsx ../scripts/generate-documentation-screenshots.ts mobile",
    "screenshots:features": "npx tsx ../scripts/generate-documentation-screenshots.ts features",
    "screenshots:blueprints": "npx tsx ../scripts/generate-documentation-screenshots.ts blueprints",
    "screenshots:states": "npx tsx ../scripts/generate-documentation-screenshots.ts states",
    "screenshots:all": "npx tsx ../scripts/generate-documentation-screenshots.ts all",
    "setup": "./setup-dev.sh",
    "start:dev": "./start-dev.sh",
    "start:prod": "./start-prod.sh"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.4",
    "@heroicons/react": "^2.2.0",
    "@monaco-editor/react": "^4.7.0",
    "axios": "^1.10.0",
    "framer-motion": "^11.15.0",
    "immer": "^10.1.1",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.2.6",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4"
  }
}
