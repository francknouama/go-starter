// GetMetrics returns current job queue metrics
func (jq *JobQueue) GetMetrics() JobMetrics {
	jq.metrics.mu.RLock()
	defer jq.metrics.mu.RUnlock()

	// Calculate current queue length
	jq.metrics.QueueLength = len(jq.jobs)
	jq.metrics.WorkerCount = jq.workers

	// Create a copy to avoid race conditions
	metrics := JobMetrics{
		JobsQueued:    jq.metrics.JobsQueued,
		JobsCompleted: jq.metrics.JobsCompleted,
		JobsFailed:    jq.metrics.JobsFailed,
		JobsRetried:   jq.metrics.JobsRetried,
		WorkerCount:   jq.metrics.WorkerCount,
		QueueLength:   jq.metrics.QueueLength,
		AverageTime:   jq.metrics.AverageTime,
		JobsByType:    make(map[string]int64),
	}

	// Copy job types map
	for k, v := range jq.metrics.JobsByType {
		metrics.JobsByType[k] = v
	}

	return metrics
}

// BaseJob provides a base implementation for jobs
type BaseJob struct {
	id         string
	maxRetries int
	retryDelay time.Duration
	retryable  bool
}

// NewBaseJob creates a new base job
func NewBaseJob(id string, maxRetries int, retryDelay time.Duration, retryable bool) *BaseJob {
	return &BaseJob{
		id:         id,
		maxRetries: maxRetries,
		retryDelay: retryDelay,
		retryable:  retryable,
	}
}

// ID returns the job ID
func (j *BaseJob) ID() string {
	return j.id
}

// Retry returns whether the job should be retried on failure
func (j *BaseJob) Retry() bool {
	return j.retryable
}

// MaxRetries returns the maximum number of retries
func (j *BaseJob) MaxRetries() int {
	return j.maxRetries
}

// Delay returns the delay between retries
func (j *BaseJob) Delay() time.Duration {
	return j.retryDelay
}

// EmailJob represents an email sending job
