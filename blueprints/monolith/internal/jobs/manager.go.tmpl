// ScheduledJobManager manages scheduled/cron jobs
type ScheduledJobManager struct {
	jobs     map[string]*ScheduledJob
	queue    *JobQueue
	ticker   *time.Ticker
	ctx      context.Context
	cancel   context.CancelFunc
	mu       sync.RWMutex
{{if eq .LoggerType "zap"}}
	logger   *zap.Logger
{{else if eq .LoggerType "logrus"}}
	logger   *logrus.Logger
{{else if eq .LoggerType "zerolog"}}
	// zerolog uses global logger
{{else}}
	logger   *slog.Logger
{{end}}
}

// ScheduledJob represents a job that runs on a schedule
type ScheduledJob struct {
	ID       string        `json:"id"`
	Job      Job           `json:"-"`
	Schedule time.Duration `json:"schedule"`
	LastRun  time.Time     `json:"last_run"`
	NextRun  time.Time     `json:"next_run"`
	Enabled  bool          `json:"enabled"`
}

// NewScheduledJobManager creates a new scheduled job manager
func NewScheduledJobManager(queue *JobQueue{{if eq .LoggerType "zap"}}, logger *zap.Logger{{else if eq .LoggerType "logrus"}}, logger *logrus.Logger{{else if eq .LoggerType "slog"}}, logger *slog.Logger{{end}}) *ScheduledJobManager {
	ctx, cancel := context.WithCancel(context.Background())
	
	return &ScheduledJobManager{
		jobs:   make(map[string]*ScheduledJob),
		queue:  queue,
		ticker: time.NewTicker(time.Minute), // Check every minute
		ctx:    ctx,
		cancel: cancel,
{{if ne .LoggerType "zerolog"}}
		logger: logger,
{{end}}
	}
}

// AddScheduledJob adds a scheduled job
func (sm *ScheduledJobManager) AddScheduledJob(id string, job Job, schedule time.Duration) {
	sm.mu.Lock()
	defer sm.mu.Unlock()

	scheduledJob := &ScheduledJob{
		ID:       id,
		Job:      job,
		Schedule: schedule,
		NextRun:  time.Now().Add(schedule),
		Enabled:  true,
	}

	sm.jobs[id] = scheduledJob

{{if eq .LoggerType "zap"}}
	sm.logger.Info("Scheduled job added",
		zap.String("job_id", id),
		zap.Duration("schedule", schedule),
		zap.Time("next_run", scheduledJob.NextRun))
{{else if eq .LoggerType "logrus"}}
	sm.logger.WithFields(logrus.Fields{
		"job_id":   id,
		"schedule": schedule,
		"next_run": scheduledJob.NextRun,
	}).Info("Scheduled job added")
{{else if eq .LoggerType "zerolog"}}
	log.Info().
		Str("job_id", id).
		Dur("schedule", schedule).
		Time("next_run", scheduledJob.NextRun).
		Msg("Scheduled job added")
{{else}}
	sm.logger.Info("Scheduled job added",
		"job_id", id,
		"schedule", schedule,
		"next_run", scheduledJob.NextRun)
{{end}}
}

// Start starts the scheduled job manager
func (sm *ScheduledJobManager) Start() {
	go func() {
		for {
			select {
			case <-sm.ticker.C:
				sm.checkScheduledJobs()
			case <-sm.ctx.Done():
				return
			}
		}
	}()

{{if eq .LoggerType "zap"}}
	sm.logger.Info("Scheduled job manager started")
{{else if eq .LoggerType "logrus"}}
	sm.logger.Info("Scheduled job manager started")
{{else if eq .LoggerType "zerolog"}}
	log.Info().Msg("Scheduled job manager started")
{{else}}
	sm.logger.Info("Scheduled job manager started")
{{end}}
}

// Stop stops the scheduled job manager
func (sm *ScheduledJobManager) Stop() {
	sm.ticker.Stop()
	sm.cancel()

{{if eq .LoggerType "zap"}}
	sm.logger.Info("Scheduled job manager stopped")
{{else if eq .LoggerType "logrus"}}
	sm.logger.Info("Scheduled job manager stopped")
{{else if eq .LoggerType "zerolog"}}
	log.Info().Msg("Scheduled job manager stopped")
{{else}}
	sm.logger.Info("Scheduled job manager stopped")
{{end}}
}

// checkScheduledJobs checks for jobs that need to run
func (sm *ScheduledJobManager) checkScheduledJobs() {
	now := time.Now()
	
	sm.mu.RLock()
	jobsToRun := make([]*ScheduledJob, 0)
	
	for _, job := range sm.jobs {
		if job.Enabled && now.After(job.NextRun) {
			jobsToRun = append(jobsToRun, job)
		}
	}
	sm.mu.RUnlock()

	// Submit jobs that need to run
	for _, scheduledJob := range jobsToRun {
		if err := sm.queue.Submit(scheduledJob.Job); err != nil {
{{if eq .LoggerType "zap"}}
			sm.logger.Error("Failed to submit scheduled job",
				zap.String("job_id", scheduledJob.ID),
				zap.Error(err))
{{else if eq .LoggerType "logrus"}}
			sm.logger.WithFields(logrus.Fields{
				"job_id": scheduledJob.ID,
				"error":  err,
			}).Error("Failed to submit scheduled job")
{{else if eq .LoggerType "zerolog"}}
			log.Error().
				Str("job_id", scheduledJob.ID).
				Err(err).
				Msg("Failed to submit scheduled job")
{{else}}
			sm.logger.Error("Failed to submit scheduled job",
				"job_id", scheduledJob.ID,
				"error", err)
{{end}}
		} else {
			// Update last run and next run times
			sm.mu.Lock()
			scheduledJob.LastRun = now
			scheduledJob.NextRun = now.Add(scheduledJob.Schedule)
			sm.mu.Unlock()

{{if eq .LoggerType "zap"}}
			sm.logger.Debug("Scheduled job submitted",
				zap.String("job_id", scheduledJob.ID),
				zap.Time("next_run", scheduledJob.NextRun))
{{else if eq .LoggerType "logrus"}}
			sm.logger.WithFields(logrus.Fields{
				"job_id":   scheduledJob.ID,
				"next_run": scheduledJob.NextRun,
			}).Debug("Scheduled job submitted")
{{else if eq .LoggerType "zerolog"}}
			log.Debug().
				Str("job_id", scheduledJob.ID).
				Time("next_run", scheduledJob.NextRun).
				Msg("Scheduled job submitted")
{{else}}
			sm.logger.Debug("Scheduled job submitted",
				"job_id", scheduledJob.ID,
				"next_run", scheduledJob.NextRun)
{{end}}
		}
	}
}