func (e *EmailJob) Execute(ctx context.Context) error {
	// Simulate email sending
	// In a real implementation, you would use an email service
	select {
	case <-time.After(100 * time.Millisecond):
		// Email sent successfully
		return nil
	case <-ctx.Done():
		return ctx.Err()
	}
