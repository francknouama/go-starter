package logger

import (
	"io"
)

// Fields represents structured logging fields
type Fields map[string]interface{}

// Logger defines the minimal interface for logging in Chi applications
// This interface provides flexibility while keeping the API simple and focused
type Logger interface {
	Debug(msg string, args ...interface{})
	Info(msg string, args ...interface{})
	Warn(msg string, args ...interface{})
	Error(msg string, args ...interface{})
	
	// For structured logging
	WithFields(fields Fields) func(string, ...interface{})
}

// Config represents logger configuration
type Config struct {
	Level  string `yaml:"level" json:"level"`
	Format string `yaml:"format" json:"format"` // json, text
}

// New creates a new logger instance with the specified type
func New(config Config) (Logger, error) {
	// Set default log level if not specified
	if config.Level == "" {
		config.Level = "info"
	}
	
	// Initialize the package-level logger
	SetLevel(config.Level)
	
	return &defaultLogger{}, nil
}

// defaultLogger wraps our package-level functions to implement the Logger interface
type defaultLogger struct{}

// GetLogger returns a Logger interface implementation
func GetLogger() Logger {
	return &defaultLogger{}
}

// GetWriter returns an io.Writer for Chi middleware integration
func GetWriter() io.Writer {
	return &loggerWriter{}
}

// loggerWriter implements io.Writer to route Chi logs through our logger
type loggerWriter struct{}

func (w *loggerWriter) Write(p []byte) (n int, err error) {
	// Remove trailing newline if present
	msg := string(p)
	if len(msg) > 0 && msg[len(msg)-1] == '\n' {
		msg = msg[:len(msg)-1]
	}
	Info(msg)
	return len(p), nil
}

func (l *defaultLogger) Debug(msg string, args ...interface{}) {
	Debug(msg, args...)
}

func (l *defaultLogger) Info(msg string, args ...interface{}) {
	Info(msg, args...)
}

func (l *defaultLogger) Warn(msg string, args ...interface{}) {
	Warn(msg, args...)
}

func (l *defaultLogger) Error(msg string, args ...interface{}) {
	Error(msg, args...)
}

func (l *defaultLogger) WithFields(fields Fields) func(string, ...interface{}) {
	return WithFields(fields)
}