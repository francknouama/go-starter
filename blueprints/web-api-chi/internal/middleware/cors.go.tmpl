package middleware

import (
	"net/http"

	"github.com/go-chi/cors"
)

// CORS creates a Chi-compatible CORS middleware with default settings
func CORS() func(next http.Handler) http.Handler {
	return cors.Handler(cors.Options{
		AllowedOrigins:   []string{"*"}, // In production, specify actual origins
		AllowedMethods:   []string{"GET", "POST", "PUT", "DELETE", "OPTIONS"},
		AllowedHeaders:   []string{"Accept", "Authorization", "Content-Type", "X-CSRF-Token"},
		ExposedHeaders:   []string{"Link"},
		AllowCredentials: false,
		MaxAge:          300, // Maximum value not ignored by any of major browsers
	})
}

// CORSWithConfig creates a Chi-compatible CORS middleware with custom configuration
func CORSWithConfig(config cors.Options) func(next http.Handler) http.Handler {
	return cors.Handler(config)
}