// testHandler is a simple handler for testing middleware
func testHandler(w http.ResponseWriter, r *http.Request) {
	w.WriteHeader(http.StatusOK)
	w.Write([]byte("test response"))
}

// TestSecurityMiddleware tests the security headers middleware
func TestSecurityMiddleware(t *testing.T) {
	// Create middleware
	securityMiddleware := middleware.Security()

	// Create test handler
	handler := securityMiddleware(http.HandlerFunc(testHandler))

	// Create request
	req := httptest.NewRequest(http.MethodGet, "/test", nil)
	rec := httptest.NewRecorder()

	// Execute handler
	handler.ServeHTTP(rec, req)

	// Assert security headers are set
	assert.Equal(t, "nosniff", rec.Header().Get("X-Content-Type-Options"))
	assert.Equal(t, "DENY", rec.Header().Get("X-Frame-Options"))
	assert.Equal(t, "1; mode=block", rec.Header().Get("X-XSS-Protection"))
	assert.Contains(t, rec.Header().Get("Strict-Transport-Security"), "max-age=31536000")
	assert.Equal(t, "strict-origin-when-cross-origin", rec.Header().Get("Referrer-Policy"))
	assert.Equal(t, "default-src 'self'", rec.Header().Get("Content-Security-Policy"))

	// Assert response is still correct
	assert.Equal(t, http.StatusOK, rec.Code)
	assert.Equal(t, "test response", rec.Body.String())
}

// TestSecurityMiddlewareWithCustomHeaders tests security middleware with custom headers
func TestSecurityMiddlewareWithCustomHeaders(t *testing.T) {
	customHeaders := map[string]string{
		"X-Custom-Header": "custom-value",
		"X-Frame-Options": "SAMEORIGIN", // Override default
	}

	// Create middleware with custom headers
	securityMiddleware := middleware.SecureWithConfig(customHeaders)

	// Create test handler
	handler := securityMiddleware(http.HandlerFunc(testHandler))

	// Create request
	req := httptest.NewRequest(http.MethodGet, "/test", nil)
	rec := httptest.NewRecorder()

	// Execute handler
	handler.ServeHTTP(rec, req)

	// Assert custom headers are set
	assert.Equal(t, "custom-value", rec.Header().Get("X-Custom-Header"))
	assert.Equal(t, "SAMEORIGIN", rec.Header().Get("X-Frame-Options"))

	// Assert response is still correct
	assert.Equal(t, http.StatusOK, rec.Code)
	assert.Equal(t, "test response", rec.Body.String())
}

