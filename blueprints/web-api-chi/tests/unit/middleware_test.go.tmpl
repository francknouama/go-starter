// TestRecoveryMiddleware tests the panic recovery middleware
func TestRecoveryMiddleware(t *testing.T) {
	// Initialize test logger
	testLogger, err := logger.New(logger.Config{Level: "error"})
	require.NoError(t, err)

	// Create middleware
	recoveryMiddleware := middleware.Recovery(testLogger)

	// Create panicking handler
	panicHandler := func(w http.ResponseWriter, r *http.Request) {
		panic("test panic")
	}

	// Create test handler with recovery middleware
	handler := recoveryMiddleware(http.HandlerFunc(panicHandler))

	// Create request
	req := httptest.NewRequest(http.MethodGet, "/test", nil)
	rec := httptest.NewRecorder()

	// Execute handler (should not panic)
	assert.NotPanics(t, func() {
		handler.ServeHTTP(rec, req)
	})

	// Assert error response
	assert.Equal(t, http.StatusInternalServerError, rec.Code)
	assert.Equal(t, "application/json", rec.Header().Get("Content-Type"))
	assert.Contains(t, rec.Body.String(), "Internal server error")
}

