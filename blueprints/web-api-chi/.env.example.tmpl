# {{.ProjectName}} Environment Configuration
# Copy this file to .env and update the values

# Server Configuration
PORT=8080
LOG_LEVEL=info

{{- if ne .DatabaseDriver ""}}
# Database Configuration
{{- if eq .DatabaseDriver "postgres"}}
DB_HOST=localhost
DB_PORT=5432
DB_USER={{.ProjectName}}
DB_PASSWORD=password
DB_NAME={{.ProjectName}}_dev
DB_SSL_MODE=disable
{{- else if eq .DatabaseDriver "mysql"}}
DB_HOST=localhost
DB_PORT=3306
DB_USER={{.ProjectName}}
DB_PASSWORD=password
DB_NAME={{.ProjectName}}_dev
{{- else if eq .DatabaseDriver "sqlite"}}
DB_NAME={{.ProjectName}}_dev.db
{{- end}}

# Alternative: Full database URL (takes precedence over individual settings)
# DATABASE_URL={{if eq .DatabaseDriver "postgres"}}postgres://{{.ProjectName}}:password@localhost:5432/{{.ProjectName}}_dev?sslmode=disable{{else if eq .DatabaseDriver "mysql"}}mysql://{{.ProjectName}}:password@localhost:3306/{{.ProjectName}}_dev{{else if eq .DatabaseDriver "sqlite"}}sqlite://{{.ProjectName}}_dev.db{{end}}
{{- end}}

{{- if and (ne .AuthType "") (ne .AuthType "none")}}
# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
{{- end}}

# CORS Configuration (optional - can also be set in config files)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

{{- if .EnableMetrics}}
# Metrics Configuration
METRICS_ENABLED=true
METRICS_PORT=9090
{{- end}}

{{- if .EnableTracing}}
# Tracing Configuration
TRACING_ENABLED=true
TRACING_ENDPOINT=http://localhost:14268/api/traces
TRACING_SAMPLE_RATE=1.0
{{- end}}

# Development Settings
ENVIRONMENT=development