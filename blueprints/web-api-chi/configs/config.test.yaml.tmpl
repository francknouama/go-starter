environment: test

server:
  address: ""
  port: 8081
  timeout: 10
  read_timeout: 5
  write_timeout: 5
  idle_timeout: 30

logger:
  level: warn
  format: json

{{- if ne .DatabaseDriver ""}}
database:
  driver: {{.DatabaseDriver}}
{{- if eq .DatabaseDriver "postgres"}}
  host: localhost
  port: 5432
  username: {{.ProjectName}}_test
  password: test_password
  database: {{.ProjectName}}_test
  ssl_mode: disable
{{- else if eq .DatabaseDriver "mysql"}}
  host: localhost
  port: 3306
  username: {{.ProjectName}}_test
  password: test_password
  database: {{.ProjectName}}_test
{{- else if eq .DatabaseDriver "sqlite"}}
  database: ":memory:"  # Use in-memory database for tests
{{- end}}
  max_open_conns: 10
  max_idle_conns: 5
  conn_max_lifetime: 300
{{- end}}

{{- if and (ne .AuthType "") (ne .AuthType "none")}}
jwt:
  secret: "test-secret-key-not-for-production"
  access_token_ttl: 300     # 5 minutes
  refresh_token_ttl: 1800   # 30 minutes
  issuer: "{{.ProjectName}}-test"
{{- end}}

cors:
  allowed_origins: ["*"]
  allowed_methods:
    - "GET"
    - "POST"
    - "PUT"
    - "DELETE"
    - "OPTIONS"
  allowed_headers:
    - "Accept"
    - "Authorization"
    - "Content-Type"
    - "X-CSRF-Token"
  exposed_headers:
    - "Link"
  allow_credentials: false
  max_age: 300

{{- if .EnableMetrics}}
metrics:
  enabled: false
  path: "/metrics"
  port: 9091
{{- end}}

{{- if .EnableTracing}}
tracing:
  enabled: false
  service_name: "{{.ProjectName}}-test"
  endpoint: "http://localhost:14268/api/traces"
  sample_rate: 0.0  # No tracing in tests
{{- end}}