environment: production

server:
  address: ""
  port: 8080
  timeout: 30
  read_timeout: 15
  write_timeout: 15
  idle_timeout: 60

logger:
  level: info
  format: json

{{- if ne .DatabaseDriver ""}}
database:
  driver: {{.DatabaseDriver}}
  # Production database settings should be set via environment variables
  # host: ${DB_HOST}
  # port: ${DB_PORT}
  # username: ${DB_USER}
  # password: ${DB_PASSWORD}
  # database: ${DB_NAME}
{{- if eq .DatabaseDriver "postgres"}}
  ssl_mode: require
{{- end}}
  max_open_conns: 100
  max_idle_conns: 50
  conn_max_lifetime: 3600
{{- end}}

{{- if and (ne .AuthType "") (ne .AuthType "none")}}
jwt:
  # JWT secret should be set via environment variable: JWT_SECRET
  secret: "${JWT_SECRET}"
  access_token_ttl: 3600    # 1 hour
  refresh_token_ttl: 604800 # 7 days
  issuer: "{{.ProjectName}}"
{{- end}}

cors:
  allowed_origins: 
    - "https://yourdomain.com"
    - "https://www.yourdomain.com"
  allowed_methods:
    - "GET"
    - "POST"
    - "PUT"
    - "DELETE"
    - "OPTIONS"
  allowed_headers:
    - "Accept"
    - "Authorization"
    - "Content-Type"
    - "X-CSRF-Token"
    - "X-Request-ID"
  exposed_headers:
    - "Link"
    - "X-Request-ID"
  allow_credentials: true
  max_age: 86400

{{- if .EnableMetrics}}
metrics:
  enabled: true
  path: "/metrics"
  port: 9090
{{- end}}

{{- if .EnableTracing}}
tracing:
  enabled: true
  service_name: "{{.ProjectName}}"
  endpoint: "${TRACING_ENDPOINT}"
  sample_rate: 0.1  # 10% sampling in production
{{- end}}