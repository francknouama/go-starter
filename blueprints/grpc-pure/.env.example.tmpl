# {{.ProjectName}} gRPC Service Environment Configuration
# Copy this file to .env and update the values

# Server Configuration
GRPC_PORT={{.GrpcPort | default 50051}}
{{- if .MetricsEnabled}}
METRICS_PORT={{.MetricsPort | default 8080}}
{{- end}}
LOG_LEVEL=info
ENVIRONMENT=development

{{- if ne .DatabaseDriver ""}}
# Database Configuration
{{- if eq .DatabaseDriver "postgres"}}
DB_HOST=localhost
DB_PORT=5432
DB_USER={{.ProjectName | lower}}
DB_PASSWORD=password
DB_NAME={{.ProjectName | lower}}_dev
DB_SSL_MODE=disable
{{- else if eq .DatabaseDriver "mysql"}}
DB_HOST=localhost
DB_PORT=3306
DB_USER={{.ProjectName | lower}}
DB_PASSWORD=password
DB_NAME={{.ProjectName | lower}}_dev
{{- else if eq .DatabaseDriver "sqlite"}}
DB_NAME={{.ProjectName | lower}}_dev.db
{{- end}}

# Alternative: Full database URL (takes precedence over individual settings)
# DATABASE_URL={{if eq .DatabaseDriver "postgres"}}postgres://{{.ProjectName | lower}}:password@localhost:5432/{{.ProjectName | lower}}_dev?sslmode=disable{{else if eq .DatabaseDriver "mysql"}}mysql://{{.ProjectName | lower}}:password@localhost:3306/{{.ProjectName | lower}}_dev{{else if eq .DatabaseDriver "sqlite"}}sqlite://{{.ProjectName | lower}}_dev.db{{end}}
{{- end}}

# gRPC Configuration
GRPC_REFLECTION_ENABLED={{.ReflectionEnabled | default false}}
GRPC_MAX_RECV_MSG_SIZE=4194304  # 4MB
GRPC_MAX_SEND_MSG_SIZE=4194304  # 4MB
GRPC_KEEPALIVE_TIME=30s
GRPC_KEEPALIVE_TIMEOUT=5s
GRPC_MAX_CONNECTION_IDLE=60s

# TLS Configuration
TLS_ENABLED=true
TLS_CERT_FILE=./certs/server.crt
TLS_KEY_FILE=./certs/server.key
TLS_CA_FILE=./certs/ca.crt
TLS_MIN_VERSION=1.3
TLS_SERVER_NAME=localhost

{{- if ne .AuthType ""}}
# Authentication Configuration
{{- if eq .AuthType "jwt"}}
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ISSUER={{.ProjectName}}
JWT_AUDIENCE={{.ProjectName}}-clients
JWT_EXPIRY=24h
{{- else if eq .AuthType "oauth2"}}
OAUTH2_CLIENT_ID=your-oauth2-client-id
OAUTH2_CLIENT_SECRET=your-oauth2-client-secret
OAUTH2_REDIRECT_URL=http://localhost:{{.MetricsPort | default 8080}}/auth/callback
OAUTH2_PROVIDER_URL=https://your-oauth-provider.com
{{- else if eq .AuthType "mtls"}}
MTLS_CLIENT_CA_FILE=./certs/client-ca.crt
MTLS_VERIFY_CLIENT_CERT=true
{{- end}}
{{- end}}

{{- if .MetricsEnabled}}
# Metrics Configuration
METRICS_ENABLED=true
METRICS_PATH=/metrics
PROMETHEUS_NAMESPACE={{.ProjectName | lower}}
{{- end}}

{{- if .TracingEnabled}}
# Tracing Configuration
TRACING_ENABLED=true
TRACING_SERVICE_NAME={{.ProjectName}}
TRACING_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
TRACING_SAMPLE_RATE=1.0
{{- end}}

{{- if ne .ServiceDiscovery ""}}
# Service Discovery Configuration
{{- if eq .ServiceDiscovery "consul"}}
CONSUL_ADDRESS=127.0.0.1:8500
CONSUL_SERVICE_NAME={{.ProjectName | lower}}
CONSUL_SERVICE_ID={{.ProjectName | lower}}-1
CONSUL_HEALTH_CHECK_INTERVAL=10s
{{- else if eq .ServiceDiscovery "etcd"}}
ETCD_ENDPOINTS=127.0.0.1:2379
ETCD_SERVICE_PREFIX=/services/{{.ProjectName | lower}}
ETCD_LEASE_TTL=30s
{{- else if eq .ServiceDiscovery "kubernetes"}}
K8S_NAMESPACE=default
K8S_SERVICE_NAME={{.ProjectName | lower}}
K8S_ENDPOINT_NAME={{.ProjectName | lower}}-endpoints
{{- end}}
{{- end}}

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_SECOND=100
RATE_LIMIT_BURST=200

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=5s

# Graceful Shutdown Configuration
SHUTDOWN_TIMEOUT=30s
SHUTDOWN_GRACE_PERIOD=10s

# Development Settings
DEBUG_MODE=false
PROFILING_ENABLED=false
PROFILING_PORT=6060

# Logging Configuration (if using structured logging)
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_ENABLE_CALLER=true
LOG_ENABLE_STACKTRACE=false