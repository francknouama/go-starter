version: v1
managed:
  enabled: true
  go_package_prefix:
    default: {{.ModulePath}}/gen/proto
    except:
      - buf.build/googleapis/googleapis
      - buf.build/grpc-ecosystem/grpc-gateway

plugins:
  # Generate Go protobuf code
  - plugin: buf.build/protocolbuffers/go:v1.31.0
    out: gen/proto
    opt:
      - paths=source_relative

  # Generate Go gRPC code
  - plugin: buf.build/grpc/go:v1.3.0
    out: gen/proto
    opt:
      - paths=source_relative

  # Generate Go gRPC gateway code (optional HTTP REST gateway)
  - plugin: buf.build/grpc-ecosystem/grpc-gateway:v2.18.0
    out: gen/proto
    opt:
      - paths=source_relative
      - generate_unbound_methods=true

  # Generate OpenAPI documentation
  - plugin: buf.build/grpc-ecosystem/openapiv2:v2.18.0
    out: docs/openapi
    opt:
      - generate_unbound_methods=true
      - use_go_templates=true