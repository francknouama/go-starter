#!/bin/bash

# {{.ProjectName}} - Test Runner Script
# This script runs the complete test suite including unit, integration, and load tests

set -e

echo "🧪 Running {{.ProjectName}} test suite..."

# Parse command line arguments
VERBOSE=false
COVERAGE=false
LOAD_TESTS=false
INTEGRATION_TESTS=true
UNIT_TESTS=true

while [[ $# -gt 0 ]]; do
    case $1 in
        -v|--verbose)
            VERBOSE=true
            shift
            ;;
        -c|--coverage)
            COVERAGE=true
            shift
            ;;
        -l|--load)
            LOAD_TESTS=true
            shift
            ;;
        --unit-only)
            INTEGRATION_TESTS=false
            LOAD_TESTS=false
            shift
            ;;
        --integration-only)
            UNIT_TESTS=false
            LOAD_TESTS=false
            shift
            ;;
        -h|--help)
            echo "Usage: $0 [OPTIONS]"
            echo "Options:"
            echo "  -v, --verbose       Enable verbose output"
            echo "  -c, --coverage      Generate coverage report"
            echo "  -l, --load          Run load tests"
            echo "  --unit-only         Run only unit tests"
            echo "  --integration-only  Run only integration tests"
            echo "  -h, --help          Show this help message"
            exit 0
            ;;
        *)
            echo "Unknown option $1"
            exit 1
            ;;
    esac
done

# Set test environment variables
export ENVIRONMENT=test
export GRPC_PORT=0  # Use random available port for tests
export METRICS_PORT=0
export LOG_LEVEL=error

# Generate protobuf code if needed
if [ ! -d "pkg/proto" ] || [ -z "$(find pkg/proto -name '*.pb.go' 2>/dev/null)" ]; then
    echo "📦 Generating protocol buffer code for tests..."
    make generate
fi

# Build test flags
TEST_FLAGS=""
if [ "$VERBOSE" = true ]; then
    TEST_FLAGS="$TEST_FLAGS -v"
fi

if [ "$COVERAGE" = true ]; then
    TEST_FLAGS="$TEST_FLAGS -coverprofile=coverage.out -covermode=atomic"
    echo "📊 Coverage reporting enabled"
fi

# Run unit tests
if [ "$UNIT_TESTS" = true ]; then
    echo "🔬 Running unit tests..."
    go test $TEST_FLAGS ./internal/... ./pkg/...
    if [ $? -ne 0 ]; then
        echo "❌ Unit tests failed!"
        exit 1
    fi
    echo "✅ Unit tests passed!"
fi

# Run integration tests
if [ "$INTEGRATION_TESTS" = true ]; then
    echo "🔗 Running integration tests..."
    go test $TEST_FLAGS ./tests/integration/...
    if [ $? -ne 0 ]; then
        echo "❌ Integration tests failed!"
        exit 1
    fi
    echo "✅ Integration tests passed!"
fi

# Run load tests
if [ "$LOAD_TESTS" = true ]; then
    echo "⚡ Running load tests..."
    go test $TEST_FLAGS ./tests/load/...
    if [ $? -ne 0 ]; then
        echo "❌ Load tests failed!"
        exit 1
    fi
    echo "✅ Load tests passed!"
fi

# Generate coverage report
if [ "$COVERAGE" = true ] && [ -f coverage.out ]; then
    echo "📈 Generating coverage report..."
    go tool cover -html=coverage.out -o coverage.html
    COVERAGE_PERCENT=$(go tool cover -func=coverage.out | grep total | awk '{print $3}')
    echo "📊 Test coverage: $COVERAGE_PERCENT"
    echo "📄 Coverage report generated: coverage.html"
fi

echo "🎉 All tests completed successfully!"