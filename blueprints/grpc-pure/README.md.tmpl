### Kubernetes Deployment
```yaml
# Basic Kubernetes deployment example
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{.ProjectName | lower}}
spec:
  replicas: 3
  selector:
    matchLabels:
      app: {{.ProjectName | lower}}
  template:
    metadata:
      labels:
        app: {{.ProjectName | lower}}
    spec:
      containers:
      - name: {{.ProjectName | lower}}
        image: {{.ProjectName | lower}}:latest
        ports:
        - containerPort: {{.GrpcPort}}
        - containerPort: {{.MetricsPort}}
