# {{.ProjectName}} gRPC Service Makefile
# Generated by go-starter

# Go parameters
GOCMD=go
GOBUILD=$(GOCMD) build
GOCLEAN=$(GOCMD) clean
GOTEST=$(GOCMD) test
GOGET=$(GOCMD) get
GOMOD=$(GOCMD) mod
GOGENERATE=$(GOCMD) generate

# Binary info
BINARY_NAME={{.ProjectName | lower}}-server
BINARY_PATH=./bin/$(BINARY_NAME)
MAIN_PATH=./cmd/server

# Protocol buffer tools
BUF_CMD=buf
PROTOC_CMD=protoc

# Build flags
BUILD_FLAGS=-ldflags="-w -s"
DEV_BUILD_FLAGS=-race

# Test flags
TEST_FLAGS=-v -race -coverprofile=coverage.out
INTEGRATION_TEST_FLAGS=-tags=integration

# Docker settings
DOCKER_IMAGE={{.ProjectName | lower}}-grpc
DOCKER_TAG=latest

.PHONY: all build clean test coverage deps generate format lint docker run dev help

# Default target
all: clean deps generate build test

# Help target
help: ## Display this help message
	@echo "{{.ProjectName}} gRPC Service - Available Make targets:"
	@echo ""
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  %-20s %s\n", $$1, $$2}'

# Build the application
build: ## Build the server binary
	@echo "Building $(BINARY_NAME)..."
	@mkdir -p bin
	$(GOBUILD) $(BUILD_FLAGS) -o $(BINARY_PATH) $(MAIN_PATH)
	@echo "✓ Build complete: $(BINARY_PATH)"

# Build for development with race detection
build-dev: ## Build with race detection for development
	@echo "Building $(BINARY_NAME) for development..."
	@mkdir -p bin
	$(GOBUILD) $(DEV_BUILD_FLAGS) -o $(BINARY_PATH) $(MAIN_PATH)
	@echo "✓ Development build complete: $(BINARY_PATH)"

# Clean build artifacts
clean: ## Clean build artifacts and caches
	@echo "Cleaning up..."
	$(GOCLEAN)
	@rm -rf bin/
	@rm -rf tmp/
	@rm -f coverage.out
	@rm -f coverage.html
	@echo "✓ Clean complete"

# Download dependencies
deps: ## Download and verify dependencies
	@echo "Downloading dependencies..."
	$(GOMOD) download
	$(GOMOD) verify
	@echo "✓ Dependencies updated"

# Tidy up dependencies
deps-tidy: ## Tidy up go.mod and go.sum
	@echo "Tidying dependencies..."
	$(GOMOD) tidy
	@echo "✓ Dependencies tidied"

# Generate protocol buffer code
generate: ## Generate protobuf and gRPC code
	@echo "Generating protobuf code..."
	@if command -v $(BUF_CMD) >/dev/null 2>&1; then \
		$(BUF_CMD) generate; \
	else \
		echo "Warning: buf not found, falling back to protoc..."; \
		@if command -v $(PROTOC_CMD) >/dev/null 2>&1; then \
			find ./proto -name "*.proto" -exec $(PROTOC_CMD) --go_out=. --go_opt=paths=source_relative --go-grpc_out=. --go-grpc_opt=paths=source_relative {} \;; \
		else \
			echo "Error: Neither buf nor protoc found. Please install buf or protoc."; \
			exit 1; \
		fi \
	fi
	$(GOGENERATE) ./...
	@echo "✓ Code generation complete"

# Run tests
test: ## Run unit tests
	@echo "Running tests..."
	$(GOTEST) $(TEST_FLAGS) ./...
	@echo "✓ Tests complete"

# Run unit tests only
test-unit: ## Run unit tests only
	@echo "Running unit tests..."
	$(GOTEST) $(TEST_FLAGS) ./internal/... ./cmd/...
	@echo "✓ Unit tests complete"

# Run integration tests
test-integration: ## Run integration tests
	@echo "Running integration tests..."
	$(GOTEST) $(TEST_FLAGS) $(INTEGRATION_TEST_FLAGS) ./tests/integration/...
	@echo "✓ Integration tests complete"

# Run load tests
test-load: ## Run load tests
	@echo "Running load tests..."
	$(GOTEST) $(TEST_FLAGS) ./tests/load/...
	@echo "✓ Load tests complete"

# Generate test coverage report
coverage: test ## Generate and display test coverage
	@echo "Generating coverage report..."
	$(GOCMD) tool cover -html=coverage.out -o coverage.html
	@echo "✓ Coverage report generated: coverage.html"

# Format code
format: ## Format Go code
	@echo "Formatting code..."
	$(GOCMD) fmt ./...
	@echo "✓ Code formatted"

# Run linting
lint: ## Run golangci-lint
	@echo "Running linters..."
	@if command -v golangci-lint >/dev/null 2>&1; then \
		golangci-lint run; \
	else \
		echo "Warning: golangci-lint not found, running go vet..."; \
		$(GOCMD) vet ./...; \
	fi
	@echo "✓ Linting complete"

# Security check
security: ## Run security checks
	@echo "Running security checks..."
	@if command -v gosec >/dev/null 2>&1; then \
		gosec ./...; \
	else \
		echo "Warning: gosec not found, skipping security checks"; \
	fi
	@echo "✓ Security checks complete"

# Install development tools
install-tools: ## Install development tools
	@echo "Installing development tools..."
	$(GOGET) github.com/golangci/golangci-lint/cmd/golangci-lint@latest
	$(GOGET) github.com/securecodewarrior/gosec/v2/cmd/gosec@latest
	@if ! command -v buf >/dev/null 2>&1; then \
		echo "Installing buf..."; \
		curl -sSL "https://github.com/bufbuild/buf/releases/latest/download/buf-$(shell uname -s)-$(shell uname -m)" -o /usr/local/bin/buf; \
		chmod +x /usr/local/bin/buf; \
	fi
	@echo "✓ Development tools installed"

# Run the server
run: build ## Build and run the server
	@echo "Starting {{.ProjectName}} server..."
	$(BINARY_PATH)

# Run in development mode
dev: ## Run in development mode with live reload
	@echo "Starting development server..."
	@if command -v air >/dev/null 2>&1; then \
		air; \
	else \
		echo "Warning: air not found, running without live reload..."; \
		$(MAKE) build-dev && $(BINARY_PATH); \
	fi

# Docker operations
docker-build: ## Build Docker image
	@echo "Building Docker image..."
	docker build -t $(DOCKER_IMAGE):$(DOCKER_TAG) .
	@echo "✓ Docker image built: $(DOCKER_IMAGE):$(DOCKER_TAG)"

docker-run: docker-build ## Run Docker container
	@echo "Running Docker container..."
	docker run -p {{.GrpcPort}}:{{.GrpcPort}} -p {{.MetricsPort}}:{{.MetricsPort}} $(DOCKER_IMAGE):$(DOCKER_TAG)

docker-compose-up: ## Start services with docker-compose
	@echo "Starting services with docker-compose..."
	docker-compose up -d

docker-compose-down: ## Stop services with docker-compose
	@echo "Stopping services with docker-compose..."
	docker-compose down

docker-compose-logs: ## View docker-compose logs
	docker-compose logs -f

# Database operations{{if ne .DatabaseDriver ""}}
migrate-up: ## Run database migrations up
	@echo "Running database migrations up..."
	@if command -v migrate >/dev/null 2>&1; then \
		migrate -path ./migrations -database "{{.DatabaseDriver}}://localhost/{{.ProjectName | lower}}" up; \
	else \
		echo "Warning: migrate tool not found"; \
	fi

migrate-down: ## Run database migrations down
	@echo "Running database migrations down..."
	@if command -v migrate >/dev/null 2>&1; then \
		migrate -path ./migrations -database "{{.DatabaseDriver}}://localhost/{{.ProjectName | lower}}" down; \
	else \
		echo "Warning: migrate tool not found"; \
	fi

migrate-create: ## Create new migration (usage: make migrate-create NAME=migration_name)
	@if [ -z "$(NAME)" ]; then \
		echo "Error: NAME is required. Usage: make migrate-create NAME=migration_name"; \
		exit 1; \
	fi
	@if command -v migrate >/dev/null 2>&1; then \
		migrate create -ext sql -dir migrations $(NAME); \
	else \
		echo "Warning: migrate tool not found"; \
	fi{{end}}

# gRPC operations
grpc-test: ## Test gRPC endpoints with grpcurl
	@echo "Testing gRPC health endpoint..."
	@if command -v grpcurl >/dev/null 2>&1; then \
		grpcurl -plaintext localhost:{{.GrpcPort}} grpc.health.v1.Health/Check; \
	else \
		echo "Warning: grpcurl not found, install with: go install github.com/fullstorydev/grpcurl/cmd/grpcurl@latest"; \
	fi

grpc-list: ## List available gRPC services
	@echo "Listing gRPC services..."
	@if command -v grpcurl >/dev/null 2>&1; then \
		grpcurl -plaintext localhost:{{.GrpcPort}} list; \
	else \
		echo "Warning: grpcurl not found"; \
	fi

grpc-describe: ## Describe gRPC service (usage: make grpc-describe SERVICE=service.name)
	@if [ -z "$(SERVICE)" ]; then \
		echo "Error: SERVICE is required. Usage: make grpc-describe SERVICE=service.name"; \
		exit 1; \
	fi
	@if command -v grpcurl >/dev/null 2>&1; then \
		grpcurl -plaintext localhost:{{.GrpcPort}} describe $(SERVICE); \
	else \
		echo "Warning: grpcurl not found"; \
	fi

# Monitoring{{if .MetricsEnabled}}
metrics: ## View Prometheus metrics
	@echo "Fetching Prometheus metrics..."
	@curl -s http://localhost:{{.MetricsPort}}/metrics || echo "Metrics endpoint not available"{{end}}

health: ## Check service health
	@echo "Checking service health..."
	@curl -s http://localhost:{{.MetricsPort}}/health || echo "Health endpoint not available"

# Full pipeline
ci: ## Run CI pipeline (format, lint, test, build)
	$(MAKE) format
	$(MAKE) lint
	$(MAKE) generate
	$(MAKE) test
	$(MAKE) build
	@echo "✓ CI pipeline complete"

# Development setup
setup: ## Setup development environment
	$(MAKE) install-tools
	$(MAKE) deps
	$(MAKE) generate
	@echo "✓ Development environment setup complete"

# Check for common issues
verify: ## Verify the setup
	@echo "Verifying setup..."
	@$(GOCMD) version
	@echo "✓ Go installed"
	@if command -v $(BUF_CMD) >/dev/null 2>&1; then echo "✓ buf installed"; else echo "⚠ buf not found"; fi
	@if command -v docker >/dev/null 2>&1; then echo "✓ Docker installed"; else echo "⚠ Docker not found"; fi
	@if command -v golangci-lint >/dev/null 2>&1; then echo "✓ golangci-lint installed"; else echo "⚠ golangci-lint not found"; fi
	@echo "Verification complete"