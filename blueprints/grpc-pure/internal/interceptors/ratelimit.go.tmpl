package interceptors

import (
	"context"
	"sync"
	"time"

	"{{.ModulePath}}/internal/config"

	"golang.org/x/time/rate"
	"google.golang.org/grpc"
	"google.golang.org/grpc/codes"
	"google.golang.org/grpc/metadata"
	"google.golang.org/grpc/peer"
	"google.golang.org/grpc/status"
)

// RateLimitInterceptor provides rate limiting for gRPC requests
type RateLimitInterceptor struct {
	config       config.RateLimitConfig
	limiters     map[string]*rate.Limiter
	mu           sync.RWMutex
	cleanupTicker *time.Ticker
	lastCleanup   time.Time
}

// NewRateLimitInterceptor creates a new rate limiting interceptor
func NewRateLimitInterceptor(cfg config.RateLimitConfig) *RateLimitInterceptor {
	interceptor := &RateLimitInterceptor{
		config:      cfg,
		limiters:    make(map[string]*rate.Limiter),
		lastCleanup: time.Now(),
	}

	// Start cleanup routine if enabled
	if cfg.Enabled && cfg.CleanupInterval > 0 {
		interceptor.cleanupTicker = time.NewTicker(cfg.CleanupInterval)
		go interceptor.cleanupRoutine()
	}

	return interceptor
}

// UnaryServerInterceptor returns a unary server interceptor for rate limiting
func (r *RateLimitInterceptor) UnaryServerInterceptor() grpc.UnaryServerInterceptor {
	return func(
		ctx context.Context,
		req interface{},
		info *grpc.UnaryServerInfo,
		handler grpc.UnaryHandler,
	) (interface{}, error) {
		if !r.config.Enabled {
			return handler(ctx, req)
		}

		// Get client identifier
		clientID := r.getClientIdentifier(ctx)

		// Check rate limit
		if !r.allow(clientID) {
			return nil, status.Errorf(codes.ResourceExhausted, 
				"Rate limit exceeded for client %s", clientID)
		}

		return handler(ctx, req)
	}
}

// StreamServerInterceptor returns a stream server interceptor for rate limiting
func (r *RateLimitInterceptor) StreamServerInterceptor() grpc.StreamServerInterceptor {
	return func(
		srv interface{},
		stream grpc.ServerStream,
		info *grpc.StreamServerInfo,
		handler grpc.StreamHandler,
	) error {
		if !r.config.Enabled {
			return handler(srv, stream)
		}

		// Get client identifier
		clientID := r.getClientIdentifier(stream.Context())

		// Check rate limit
		if !r.allow(clientID) {
			return status.Errorf(codes.ResourceExhausted, 
				"Rate limit exceeded for client %s", clientID)
		}

		return handler(srv, stream)
	}
}

// allow checks if the client is allowed to make a request based on rate limiting
func (r *RateLimitInterceptor) allow(clientID string) bool {
	limiter := r.getLimiter(clientID)
	return limiter.Allow()
}

// getLimiter gets or creates a rate limiter for the given client
func (r *RateLimitInterceptor) getLimiter(clientID string) *rate.Limiter {
	r.mu.RLock()
	limiter, exists := r.limiters[clientID]
	r.mu.RUnlock()

	if exists {
		return limiter
	}

	// Create new limiter
	r.mu.Lock()
	defer r.mu.Unlock()

	// Double-check in case another goroutine created it
	if limiter, exists := r.limiters[clientID]; exists {
		return limiter
	}

	// Create new rate limiter
	limiter = rate.NewLimiter(
		rate.Limit(r.config.RequestsPerSecond),
		r.config.BurstSize,
	)
	r.limiters[clientID] = limiter

	return limiter
}

// getClientIdentifier extracts a client identifier from the gRPC context
func (r *RateLimitInterceptor) getClientIdentifier(ctx context.Context) string {
	// Try to get client IP from peer
	if p, ok := peer.FromContext(ctx); ok {
		return p.Addr.String()
	}

	// Try to get client ID from metadata
	if md, ok := metadata.FromIncomingContext(ctx); ok {
		if clientIDs := md.Get("client-id"); len(clientIDs) > 0 {
			return clientIDs[0]
		}
		
		// Try to get from user agent
		if userAgents := md.Get("user-agent"); len(userAgents) > 0 {
			return userAgents[0]
		}
	}

	// Fallback to default
	return "unknown"
}

// cleanupRoutine periodically removes unused rate limiters
func (r *RateLimitInterceptor) cleanupRoutine() {
	for range r.cleanupTicker.C {
		r.cleanupLimiters()
	}
}

// cleanupLimiters removes rate limiters that haven't been used recently
func (r *RateLimitInterceptor) cleanupLimiters() {
	r.mu.Lock()
	defer r.mu.Unlock()

	// Simple cleanup: remove all limiters periodically
	// In a production system, you might want to track last access time
	// and only remove limiters that haven't been used recently
	
	// For now, we'll keep it simple and just limit the total number
	if len(r.limiters) > 10000 { // Arbitrary limit
		// Clear half of the limiters
		count := 0
		for key := range r.limiters {
			delete(r.limiters, key)
			count++
			if count >= len(r.limiters)/2 {
				break
			}
		}
	}

	r.lastCleanup = time.Now()
}

// Close stops the cleanup routine
func (r *RateLimitInterceptor) Close() {
	if r.cleanupTicker != nil {
		r.cleanupTicker.Stop()
	}
}

// GetStats returns rate limiting statistics
func (r *RateLimitInterceptor) GetStats() map[string]interface{} {
	r.mu.RLock()
	defer r.mu.RUnlock()

	return map[string]interface{}{
		"enabled":           r.config.Enabled,
		"requests_per_second": r.config.RequestsPerSecond,
		"burst_size":        r.config.BurstSize,
		"active_limiters":   len(r.limiters),
		"last_cleanup":      r.lastCleanup,
	}
}