package interceptors

import (
	"context"
	"fmt"

	"go.opentelemetry.io/otel"
	"go.opentelemetry.io/otel/attribute"
	"go.opentelemetry.io/otel/codes"
	"go.opentelemetry.io/otel/trace"
	"google.golang.org/grpc"
	"google.golang.org/grpc/metadata"
	"google.golang.org/grpc/peer"
	grpcCodes "google.golang.org/grpc/codes"
	"google.golang.org/grpc/status"
)

const (
	// Tracing attributes
	GRPCMethodAttribute     = "rpc.method"
	GRPCServiceAttribute    = "rpc.service"
	GRPCSystemAttribute     = "rpc.system"
	GRPCStatusCodeAttribute = "rpc.grpc.status_code"
	ClientIPAttribute       = "client.ip"
	UserAgentAttribute      = "user_agent.original"
)

// TracingInterceptor provides OpenTelemetry tracing for gRPC requests
type TracingInterceptor struct {
	tracer trace.Tracer
}

// NewTracingInterceptor creates a new tracing interceptor
func NewTracingInterceptor(serviceName string) *TracingInterceptor {
	tracer := otel.Tracer(serviceName)
	return &TracingInterceptor{
		tracer: tracer,
	}
}

// UnaryServerInterceptor returns a unary server interceptor for tracing
func (t *TracingInterceptor) UnaryServerInterceptor() grpc.UnaryServerInterceptor {
	return func(
		ctx context.Context,
		req interface{},
		info *grpc.UnaryServerInfo,
		handler grpc.UnaryHandler,
	) (interface{}, error) {
		// Extract span context from incoming metadata
		ctx = t.extractSpanContext(ctx)

		// Start a new span
		spanName := fmt.Sprintf("grpc.%s", info.FullMethod)
		ctx, span := t.tracer.Start(ctx, spanName, trace.WithSpanKind(trace.SpanKindServer))
		defer span.End()

		// Set span attributes
		t.setSpanAttributes(span, ctx, info.FullMethod)

		// Call the handler
		resp, err := handler(ctx, req)

		// Set span status based on error
		t.setSpanStatus(span, err)

		return resp, err
	}
}

// StreamServerInterceptor returns a stream server interceptor for tracing
func (t *TracingInterceptor) StreamServerInterceptor() grpc.StreamServerInterceptor {
	return func(
		srv interface{},
		stream grpc.ServerStream,
		info *grpc.StreamServerInfo,
		handler grpc.StreamHandler,
	) error {
		// Extract span context from incoming metadata
		ctx := t.extractSpanContext(stream.Context())

		// Start a new span
		spanName := fmt.Sprintf("grpc.%s", info.FullMethod)
		ctx, span := t.tracer.Start(ctx, spanName, trace.WithSpanKind(trace.SpanKindServer))
		defer span.End()

		// Set span attributes
		t.setSpanAttributes(span, ctx, info.FullMethod)

		// Add stream-specific attributes
		span.SetAttributes(
			attribute.Bool("rpc.grpc.client_stream", info.IsClientStream),
			attribute.Bool("rpc.grpc.server_stream", info.IsServerStream),
		)

		// Create a wrapped stream with the traced context
		wrappedStream := &tracingServerStream{
			ServerStream: stream,
			ctx:          ctx,
			span:         span,
		}

		// Call the handler
		err := handler(srv, wrappedStream)

		// Set span status based on error
		t.setSpanStatus(span, err)

		return err
	}
}

// extractSpanContext extracts the span context from gRPC metadata
func (t *TracingInterceptor) extractSpanContext(ctx context.Context) context.Context {
	md, ok := metadata.FromIncomingContext(ctx)
	if !ok {
		return ctx
	}

	// Extract trace context from metadata
	return otel.GetTextMapPropagator().Extract(ctx, &metadataCarrier{md: md})
}

// setSpanAttributes sets common span attributes
func (t *TracingInterceptor) setSpanAttributes(span trace.Span, ctx context.Context, fullMethod string) {
	// Parse method and service from full method
	service, method := parseFullMethod(fullMethod)

	// Set RPC attributes
	span.SetAttributes(
		attribute.String(GRPCSystemAttribute, "grpc"),
		attribute.String(GRPCServiceAttribute, service),
		attribute.String(GRPCMethodAttribute, method),
	)

	// Extract client information
	if p, ok := peer.FromContext(ctx); ok {
		span.SetAttributes(
			attribute.String(ClientIPAttribute, p.Addr.String()),
		)
	}

	// Extract user agent from metadata
	if md, ok := metadata.FromIncomingContext(ctx); ok {
		if userAgents := md.Get("user-agent"); len(userAgents) > 0 {
			span.SetAttributes(
				attribute.String(UserAgentAttribute, userAgents[0]),
			)
		}

		// Add custom headers as attributes (be careful about sensitive data)
		if requestIds := md.Get("x-request-id"); len(requestIds) > 0 {
			span.SetAttributes(
				attribute.String("request.id", requestIds[0]),
			)
		}
	}
}

// setSpanStatus sets the span status based on the gRPC error
func (t *TracingInterceptor) setSpanStatus(span trace.Span, err error) {
	if err == nil {
		span.SetStatus(codes.Ok, "")
		span.SetAttributes(
			attribute.String(GRPCStatusCodeAttribute, grpcCodes.OK.String()),
		)
		return
	}

	// Get gRPC status code
	grpcStatus := status.Convert(err)
	grpcCode := grpcStatus.Code()

	span.SetAttributes(
		attribute.String(GRPCStatusCodeAttribute, grpcCode.String()),
	)

	// Map gRPC codes to OpenTelemetry span status
	switch grpcCode {
	case grpcCodes.OK:
		span.SetStatus(codes.Ok, "")
	case grpcCodes.Canceled:
		span.SetStatus(codes.Error, grpcStatus.Message())
	case grpcCodes.Unknown:
		span.SetStatus(codes.Error, grpcStatus.Message())
	case grpcCodes.InvalidArgument:
		span.SetStatus(codes.Error, grpcStatus.Message())
	case grpcCodes.DeadlineExceeded:
		span.SetStatus(codes.Error, grpcStatus.Message())
	case grpcCodes.NotFound:
		span.SetStatus(codes.Error, grpcStatus.Message())
	case grpcCodes.AlreadyExists:
		span.SetStatus(codes.Error, grpcStatus.Message())
	case grpcCodes.PermissionDenied:
		span.SetStatus(codes.Error, grpcStatus.Message())
	case grpcCodes.ResourceExhausted:
		span.SetStatus(codes.Error, grpcStatus.Message())
	case grpcCodes.FailedPrecondition:
		span.SetStatus(codes.Error, grpcStatus.Message())
	case grpcCodes.Aborted:
		span.SetStatus(codes.Error, grpcStatus.Message())
	case grpcCodes.OutOfRange:
		span.SetStatus(codes.Error, grpcStatus.Message())
	case grpcCodes.Unimplemented:
		span.SetStatus(codes.Error, grpcStatus.Message())
	case grpcCodes.Internal:
		span.SetStatus(codes.Error, grpcStatus.Message())
	case grpcCodes.Unavailable:
		span.SetStatus(codes.Error, grpcStatus.Message())
	case grpcCodes.DataLoss:
		span.SetStatus(codes.Error, grpcStatus.Message())
	case grpcCodes.Unauthenticated:
		span.SetStatus(codes.Error, grpcStatus.Message())
	default:
		span.SetStatus(codes.Error, grpcStatus.Message())
	}

	// Record the error
	span.RecordError(err)
}

// tracingServerStream wraps a gRPC server stream with tracing context
type tracingServerStream struct {
	grpc.ServerStream
	ctx  context.Context
	span trace.Span
}

// Context returns the traced context
func (s *tracingServerStream) Context() context.Context {
	return s.ctx
}

// SendMsg traces outgoing messages
func (s *tracingServerStream) SendMsg(m interface{}) error {
	// Add event for message sent
	s.span.AddEvent("message.sent")
	return s.ServerStream.SendMsg(m)
}

// RecvMsg traces incoming messages
func (s *tracingServerStream) RecvMsg(m interface{}) error {
	// Add event for message received
	s.span.AddEvent("message.received")
	return s.ServerStream.RecvMsg(m)
}

// metadataCarrier implements the TextMapCarrier interface for gRPC metadata
type metadataCarrier struct {
	md metadata.MD
}

// Get retrieves a value from the metadata
func (mc *metadataCarrier) Get(key string) string {
	values := mc.md.Get(key)
	if len(values) == 0 {
		return ""
	}
	return values[0]
}

// Set sets a value in the metadata
func (mc *metadataCarrier) Set(key, value string) {
	mc.md.Set(key, value)
}

// Keys returns all keys in the metadata
func (mc *metadataCarrier) Keys() []string {
	keys := make([]string, 0, len(mc.md))
	for key := range mc.md {
		keys = append(keys, key)
	}
	return keys
}

// parseFullMethod parses a gRPC full method into service and method components
func parseFullMethod(fullMethod string) (service, method string) {
	// fullMethod format: "/package.service/method"
	if len(fullMethod) == 0 || fullMethod[0] != '/' {
		return "unknown", "unknown"
	}

	fullMethod = fullMethod[1:] // Remove leading '/'
	
	lastSlash := -1
	for i := len(fullMethod) - 1; i >= 0; i-- {
		if fullMethod[i] == '/' {
			lastSlash = i
			break
		}
	}

	if lastSlash == -1 {
		return "unknown", fullMethod
	}

	return fullMethod[:lastSlash], fullMethod[lastSlash+1:]
}

// InjectSpanContext injects the span context into outgoing gRPC metadata (for client calls)
func InjectSpanContext(ctx context.Context, md metadata.MD) context.Context {
	otel.GetTextMapPropagator().Inject(ctx, &metadataCarrier{md: md})
	return metadata.NewOutgoingContext(ctx, md)
}

// StartSpan starts a new span with the given name (utility function)
func StartSpan(ctx context.Context, name string, opts ...trace.SpanStartOption) (context.Context, trace.Span) {
	tracer := otel.Tracer("grpc-client")
	return tracer.Start(ctx, name, opts...)
}