// sqlxUserRepository implements UserRepository using SQLX
type sqlxUserRepository struct {
	db *sqlx.DB
}

// NewSqlxUserRepository creates a new SQLX-based user repository
func NewSqlxUserRepository(db *sqlx.DB) UserRepository {
	return &sqlxUserRepository{
		db: db,
	}
}

// Create creates a new user
func (r *sqlxUserRepository) Create(ctx context.Context, user *models.User) error {
	query := `
		INSERT INTO users (username, email, name, password_hash, active, verified, first_name, last_name, phone_number, roles, permissions, provider, provider_id, created_at, updated_at)
		VALUES (:username, :email, :name, :password_hash, :active, :verified, :first_name, :last_name, :phone_number, :roles, :permissions, :provider, :provider_id, :created_at, :updated_at)
		RETURNING id
	`
	
	user.CreatedAt = time.Now()
	user.UpdatedAt = time.Now()
	
	rows, err := r.db.NamedQueryContext(ctx, query, user)
	if err != nil {
		if strings.Contains(err.Error(), "duplicate") || strings.Contains(err.Error(), "unique") {
			return NewRepositoryError(ErrorTypeDuplicate, "user already exists", err)
		}
		return NewRepositoryError(ErrorTypeUnknown, "failed to create user", err)
	}
	defer rows.Close()
	
	if rows.Next() {
		if err := rows.Scan(&user.ID); err != nil {
			return NewRepositoryError(ErrorTypeUnknown, "failed to scan user ID", err)
		}
	}
	
	return nil
}

// CreateBatch creates multiple users in a batch
func (r *sqlxUserRepository) CreateBatch(ctx context.Context, users []*models.User) error {
	if len(users) == 0 {
		return nil
	}
	
	query := `
		INSERT INTO users (username, email, name, password_hash, active, verified, first_name, last_name, phone_number, roles, permissions, provider, provider_id, created_at, updated_at)
		VALUES (:username, :email, :name, :password_hash, :active, :verified, :first_name, :last_name, :phone_number, :roles, :permissions, :provider, :provider_id, :created_at, :updated_at)
	`
	
	now := time.Now()
	for _, user := range users {
		user.CreatedAt = now
		user.UpdatedAt = now
	}
	
	if _, err := r.db.NamedExecContext(ctx, query, users); err != nil {
		return NewRepositoryError(ErrorTypeUnknown, "failed to create users batch", err)
	}
	
	return nil
}

