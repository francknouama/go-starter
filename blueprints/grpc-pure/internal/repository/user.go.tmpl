// UnlockUser unlocks a user account
func (r *gormUserRepository) UnlockUser(ctx context.Context, userID int64) error {
	return r.UpdateByID(ctx, userID, map[string]interface{}{
		"locked_until": nil,
		"failed_logins": 0,
		"updated_at":   time.Now(),
	})
