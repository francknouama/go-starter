// UpdatePassword updates user password
func (r *gormUserRepository) UpdatePassword(ctx context.Context, userID int64, passwordHash string) error {
	return r.UpdateByID(ctx, userID, map[string]interface{}{
		"password_hash": passwordHash,
		"updated_at":    time.Now(),
	})
}

// UpdateLastLogin updates last login time
func (r *gormUserRepository) UpdateLastLogin(ctx context.Context, userID int64) error {
	now := time.Now()
	return r.UpdateByID(ctx, userID, map[string]interface{}{
		"last_login_at": &now,
		"login_count":   gorm.Expr("login_count + 1"),
		"failed_logins": 0,
		"updated_at":    now,
	})
}

// IncrementFailedLogins increments failed login count
func (r *gormUserRepository) IncrementFailedLogins(ctx context.Context, userID int64) error {
	return r.UpdateByID(ctx, userID, map[string]interface{}{
		"failed_logins": gorm.Expr("failed_logins + 1"),
		"updated_at":    time.Now(),
	})
}

