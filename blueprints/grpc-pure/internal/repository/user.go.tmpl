	if err := r.db.WithContext(ctx).Model(&models.User{}).Where("email = ?", email).Count(&count).Error; err != nil {
		return false, NewRepositoryError(ErrorTypeUnknown, "failed to check email existence", err)
	}
	return count > 0, nil
