// Search searches users by query
func (r *gormUserRepository) Search(ctx context.Context, query string, limit, offset int) ([]*models.User, error) {
	var users []*models.User
	searchPattern := "%" + query + "%"
	
	err := r.db.WithContext(ctx).Where(
		"username ILIKE ? OR email ILIKE ? OR name ILIKE ? OR first_name ILIKE ? OR last_name ILIKE ?",
		searchPattern, searchPattern, searchPattern, searchPattern, searchPattern,
	).Limit(limit).Offset(offset).Find(&users).Error
	
	if err != nil {
		return nil, NewRepositoryError(ErrorTypeUnknown, "failed to search users", err)
	}
	
	return users, nil
}

