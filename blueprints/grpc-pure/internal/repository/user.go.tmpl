// WithTransaction executes a function within a transaction
func (r *gormUserRepository) WithTransaction(ctx context.Context, fn func(ctx context.Context, repo UserRepository) error) error {
	return r.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
		txRepo := &gormUserRepository{db: tx}
		return fn(ctx, txRepo)
	})
}

// HealthCheck checks repository health
func (r *gormUserRepository) HealthCheck(ctx context.Context) error {
	var result int
	if err := r.db.WithContext(ctx).Raw("SELECT 1").Scan(&result).Error; err != nil {
		return NewRepositoryError(ErrorTypeConnection, "health check failed", err)
	}
	return nil
}

// CleanupExpiredLocks removes expired account locks
func (r *gormUserRepository) CleanupExpiredLocks(ctx context.Context) error {
	if err := r.db.WithContext(ctx).Model(&models.User{}).
		Where("locked_until IS NOT NULL AND locked_until < ?", time.Now()).
		Updates(map[string]interface{}{
			"locked_until":  nil,
			"failed_logins": 0,
		}).Error; err != nil {
		return NewRepositoryError(ErrorTypeUnknown, "failed to cleanup expired locks", err)
	}
	return nil
}

// CleanupSoftDeleted removes soft deleted records older than specified time
func (r *gormUserRepository) CleanupSoftDeleted(ctx context.Context, olderThan time.Time) error {
	if err := r.db.WithContext(ctx).Unscoped().
		Where("deleted_at IS NOT NULL AND deleted_at < ?", olderThan).
		Delete(&models.User{}).Error; err != nil {
		return NewRepositoryError(ErrorTypeUnknown, "failed to cleanup soft deleted users", err)
	}
	return nil
}

// Helper method to apply user filters
func (r *gormUserRepository) applyUserFilters(query *gorm.DB, filter models.UserFilter) *gorm.DB {
	if filter.Active != nil {
		query = query.Where("active = ?", *filter.Active)
	}
	
	if filter.Verified != nil {
		query = query.Where("verified = ?", *filter.Verified)
	}
	
	if filter.Provider != nil {
		if *filter.Provider == "" {
			query = query.Where("(provider IS NULL OR provider = '')")
		} else {
			query = query.Where("provider = ?", *filter.Provider)
		}
	}
	
	if filter.Role != nil {
		query = query.Where("roles LIKE ?", "%"+*filter.Role+"%")
	}
	
	if filter.Search != nil && *filter.Search != "" {
		searchPattern := "%" + *filter.Search + "%"
		query = query.Where(
			"username ILIKE ? OR email ILIKE ? OR name ILIKE ? OR first_name ILIKE ? OR last_name ILIKE ?",
			searchPattern, searchPattern, searchPattern, searchPattern, searchPattern,
		)
	}
	
	return query
}

