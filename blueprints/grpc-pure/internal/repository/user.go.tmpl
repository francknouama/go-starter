// List retrieves users with filtering
func (r *gormUserRepository) List(ctx context.Context, filter models.UserFilter) ([]*models.User, error) {
	query := r.db.WithContext(ctx).Model(&models.User{})
	
	// Apply filters
	query = r.applyUserFilters(query, filter)
	
	// Apply sorting
	if filter.SortBy != "" {
		order := filter.SortBy
		if filter.SortOrder == "desc" {
			order += " DESC"
		}
		query = query.Order(order)
	}
	
	// Apply pagination
	if filter.Limit > 0 {
		query = query.Limit(filter.Limit)
	}
	if filter.Offset > 0 {
		query = query.Offset(filter.Offset)
	}
	
	var users []*models.User
	if err := query.Find(&users).Error; err != nil {
		return nil, NewRepositoryError(ErrorTypeUnknown, "failed to list users", err)
	}
	
	return users, nil
}

// Count counts users with filtering
func (r *gormUserRepository) Count(ctx context.Context, filter models.UserFilter) (int64, error) {
	query := r.db.WithContext(ctx).Model(&models.User{})
	query = r.applyUserFilters(query, filter)
	
	var count int64
	if err := query.Count(&count).Error; err != nil {
		return 0, NewRepositoryError(ErrorTypeUnknown, "failed to count users", err)
	}
	
	return count, nil
}

// Update updates a user
func (r *gormUserRepository) Update(ctx context.Context, user *models.User) error {
	if err := r.db.WithContext(ctx).Save(user).Error; err != nil {
		return NewRepositoryError(ErrorTypeUnknown, "failed to update user", err)
