			Timestamp: timestamppb.Now(),
		},
	}

	return response, nil
}

// StreamEcho implements a bidirectional streaming echo service
func (s *{{.ProjectName}}Service) StreamEcho(stream {{.ProjectName | lower}}v1.{{.ProjectName}}Service_StreamEchoServer) error {
	s.logger.Info("StreamEcho started")

	for {
		req, err := stream.Recv()
		if err != nil {
			if err.Error() == "EOF" {
				s.logger.Info("StreamEcho ended")
				return nil
			}
			s.logger.Error("StreamEcho receive error", "error", err)
			return err
		}

		s.logger.Debug("StreamEcho received", "message", req.Message)

		response := &{{.ProjectName | lower}}v1.EchoResponse{
			Message: fmt.Sprintf("Stream Echo: %s", req.Message),
			Status: &commonv1.Status{
				Code:      commonv1.StatusCode_STATUS_CODE_OK,
				Message:   "Stream echo successful",
				Timestamp: timestamppb.Now(),
			},
		}

		if err := stream.Send(response); err != nil {
			s.logger.Error("StreamEcho send error", "error", err)
			return err
		}
	}
}