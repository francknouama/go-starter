// CreateUser creates a new user
func (s *{{.ProjectName}}Service) CreateUser(ctx context.Context, req *{{.ProjectName | lower}}v1.CreateUserRequest) (*{{.ProjectName | lower}}v1.CreateUserResponse, error) {
	s.logger.Info("CreateUser called", "email", req.Email)

	// Validate request
	if err := s.validateCreateUserRequest(req); err != nil {
		return nil, status.Errorf(codes.InvalidArgument, "Invalid request: %v", err)
	}

	// Create user via repository
	user, err := s.userRepo.Create(ctx, req.Name, req.Email)
	if err != nil {
		s.logger.Error("Failed to create user", "error", err, "email", req.Email)
		return nil, status.Errorf(codes.Internal, "Failed to create user: %v", err)
	}

	response := &{{.ProjectName | lower}}v1.CreateUserResponse{
		User: &{{.ProjectName | lower}}v1.User{
			Id:        fmt.Sprintf("%d", user.ID),
			Name:      user.Name,
			Email:     user.Email,
			CreatedAt: timestamppb.New(user.CreatedAt),
			UpdatedAt: timestamppb.New(user.UpdatedAt),
		},
		Status: &commonv1.Status{
			Code:      commonv1.StatusCode_STATUS_CODE_OK,
			Message:   "User created successfully",
			Timestamp: timestamppb.Now(),
		},
	}

	s.logger.Info("User created successfully", "user_id", user.ID, "email", user.Email)
	return response, nil
}

// GetUser retrieves a user by ID
func (s *{{.ProjectName}}Service) GetUser(ctx context.Context, req *{{.ProjectName | lower}}v1.GetUserRequest) (*{{.ProjectName | lower}}v1.GetUserResponse, error) {
	s.logger.Info("GetUser called", "user_id", req.Id)

	// Validate request
	if req.Id == "" {
		return nil, status.Errorf(codes.InvalidArgument, "User ID is required")
	}

	// Get user via repository
	user, err := s.userRepo.GetByID(ctx, req.Id)
	if err != nil {
		s.logger.Error("Failed to get user", "error", err, "user_id", req.Id)
		if err.Error() == "user not found" {
			return nil, status.Errorf(codes.NotFound, "User not found")
		}
		return nil, status.Errorf(codes.Internal, "Failed to get user: %v", err)
	}

	response := &{{.ProjectName | lower}}v1.GetUserResponse{
		User: &{{.ProjectName | lower}}v1.User{
			Id:        fmt.Sprintf("%d", user.ID),
			Name:      user.Name,
			Email:     user.Email,
			CreatedAt: timestamppb.New(user.CreatedAt),
			UpdatedAt: timestamppb.New(user.UpdatedAt),
		},
		Status: &commonv1.Status{
			Code:      commonv1.StatusCode_STATUS_CODE_OK,
			Message:   "User retrieved successfully",
			Timestamp: timestamppb.Now(),
		},
	}

	s.logger.Info("User retrieved successfully", "user_id", user.ID)
	return response, nil
}

// ListUsers retrieves a list of users with pagination
func (s *{{.ProjectName}}Service) ListUsers(ctx context.Context, req *{{.ProjectName | lower}}v1.ListUsersRequest) (*{{.ProjectName | lower}}v1.ListUsersResponse, error) {
	s.logger.Info("ListUsers called", "page", req.Page, "page_size", req.PageSize)

	// Set defaults for pagination
	page := req.Page
	if page <= 0 {
		page = 1
	}
	pageSize := req.PageSize
	if pageSize <= 0 {
		pageSize = 10
	}
	if pageSize > 100 {
		pageSize = 100 // Limit maximum page size
	}

	// Get users via repository
	users, total, err := s.userRepo.List(ctx, int(page), int(pageSize))
	if err != nil {
		s.logger.Error("Failed to list users", "error", err)
		return nil, status.Errorf(codes.Internal, "Failed to list users: %v", err)
	}

	// Convert to protobuf format
	protoUsers := make([]*{{.ProjectName | lower}}v1.User, 0, len(users))
	for _, user := range users {
		protoUsers = append(protoUsers, &{{.ProjectName | lower}}v1.User{
			Id:        fmt.Sprintf("%d", user.ID),
			Name:      user.Name,
			Email:     user.Email,
			CreatedAt: timestamppb.New(user.CreatedAt),
			UpdatedAt: timestamppb.New(user.UpdatedAt),
		})
	}

	response := &{{.ProjectName | lower}}v1.ListUsersResponse{
		Users: protoUsers,
		Pagination: &commonv1.PaginationResponse{
			Page:       page,
			PageSize:   pageSize,
			Total:      int64(total),
			TotalPages: int64((total + int(pageSize) - 1) / int(pageSize)),
		},
		Status: &commonv1.Status{
			Code:      commonv1.StatusCode_STATUS_CODE_OK,
			Message:   fmt.Sprintf("Retrieved %d users", len(users)),
			Timestamp: timestamppb.Now(),
		},
	}

	s.logger.Info("Users listed successfully", "count", len(users), "total", total)
	return response, nil
}

