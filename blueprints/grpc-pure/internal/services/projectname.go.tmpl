{{- if ne .ServiceDiscovery ""}}
// DiscoverServices discovers other service instances
func (s *{{.ProjectName}}Service) DiscoverServices(ctx context.Context, req *{{.ProjectName | lower}}v1.DiscoverServicesRequest) (*{{.ProjectName | lower}}v1.DiscoverServicesResponse, error) {
	s.logger.Info("DiscoverServices called", "service_name", req.ServiceName)

	if req.ServiceName == "" {
		return nil, status.Errorf(codes.InvalidArgument, "Service name is required")
	}

	// Discover instances via service discovery
	instances, err := s.discovery.Discover(req.ServiceName)
	if err != nil {
		s.logger.Error("Failed to discover services", "error", err, "service_name", req.ServiceName)
		return nil, status.Errorf(codes.Internal, "Failed to discover services: %v", err)
	}

	// Convert to protobuf format
	protoInstances := make([]*{{.ProjectName | lower}}v1.ServiceInstance, 0, len(instances))
	for _, instance := range instances {
		protoInstances = append(protoInstances, &{{.ProjectName | lower}}v1.ServiceInstance{
			Id:      instance.ID,
			Name:    instance.Name,
			Address: instance.Address,
			Port:    int32(instance.Port),
			Tags:    instance.Tags,
			Meta:    instance.Meta,
			Health:  string(instance.Health),
		})
	}

	response := &{{.ProjectName | lower}}v1.DiscoverServicesResponse{
		Instances: protoInstances,
		Status: &commonv1.Status{
			Code:      commonv1.StatusCode_STATUS_CODE_OK,
			Message:   fmt.Sprintf("Discovered %d instances", len(instances)),
			Timestamp: timestamppb.Now(),
		},
	}

	s.logger.Info("Services discovered successfully", "service_name", req.ServiceName, "count", len(instances))
	return response, nil
}
