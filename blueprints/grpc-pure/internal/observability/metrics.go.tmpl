func (bm *BusinessMetrics) Reset() {
	bm.operationCounter.Reset()
	bm.operationDuration.Reset()
	bm.operationGauge.Reset()
	bm.resourceUsage.Reset()
	bm.resourceErrors.Reset()
	bm.cacheHits.Reset()
	bm.cacheMisses.Reset()
	bm.cacheOperations.Reset()
	bm.queueSize.Reset()
	bm.queueProcessing.Reset()
	bm.queueErrors.Reset()
	
	{{if ne .DatabaseDriver ""}}bm.dbConnections.Reset()
	bm.dbQueries.Reset()
	bm.dbQueryDuration.Reset()
	bm.dbTransactions.Reset(){{end}}
	
	{{if eq .Logger "slog"}}bm.logger.Info("Business metrics reset"){{else if eq .Logger "zap"}}bm.logger.Info("Business metrics reset"){{else if eq .Logger "logrus"}}bm.logger.Info("Business metrics reset"){{else if eq .Logger "zerolog"}}bm.logger.Info().Msg("Business metrics reset"){{end}}
}
