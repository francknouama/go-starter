	bm.dbQueries.WithLabelValues(database, operation, table, status).Inc()
	bm.dbQueryDuration.WithLabelValues(database, operation, table).Observe(duration.Seconds())
}

// RecordDatabaseTransaction records a database transaction
func (bm *BusinessMetrics) RecordDatabaseTransaction(database, status string) {
	bm.dbTransactions.WithLabelValues(database, status).Inc()
}{{end}}

