}

// Custom Metrics Management

// RegisterCustomCounter creates and registers a custom counter metric
func (bm *BusinessMetrics) RegisterCustomCounter(name, help string, labels []string) (*prometheus.CounterVec, error) {
	bm.mu.Lock()
	defer bm.mu.Unlock()
	
	if _, exists := bm.customMetrics[name]; exists {
		return nil, prometheus.ErrAlreadyReg
	}
	
	counter := prometheus.NewCounterVec(
		prometheus.CounterOpts{
			Name: name,
			Help: help,
		},
		labels,
	)
	
	if err := bm.registry.Register(counter); err != nil {
		return nil, err
	}
	
	bm.customMetrics[name] = counter
	{{if eq .Logger "slog"}}bm.logger.Info("Custom counter registered", "name", name){{else if eq .Logger "zap"}}bm.logger.Info("Custom counter registered", zap.String("name", name)){{else if eq .Logger "logrus"}}bm.logger.WithField("name", name).Info("Custom counter registered"){{else if eq .Logger "zerolog"}}bm.logger.Info().Str("name", name).Msg("Custom counter registered"){{end}}
	
	return counter, nil
}

// RegisterCustomGauge creates and registers a custom gauge metric
func (bm *BusinessMetrics) RegisterCustomGauge(name, help string, labels []string) (*prometheus.GaugeVec, error) {
	bm.mu.Lock()
	defer bm.mu.Unlock()
	
	if _, exists := bm.customMetrics[name]; exists {
		return nil, prometheus.ErrAlreadyReg
	}
	
	gauge := prometheus.NewGaugeVec(
		prometheus.GaugeOpts{
			Name: name,
			Help: help,
		},
		labels,
	)
	
	if err := bm.registry.Register(gauge); err != nil {
		return nil, err
	}
	
	bm.customMetrics[name] = gauge
	{{if eq .Logger "slog"}}bm.logger.Info("Custom gauge registered", "name", name){{else if eq .Logger "zap"}}bm.logger.Info("Custom gauge registered", zap.String("name", name)){{else if eq .Logger "logrus"}}bm.logger.WithField("name", name).Info("Custom gauge registered"){{else if eq .Logger "zerolog"}}bm.logger.Info().Str("name", name).Msg("Custom gauge registered"){{end}}
	
	return gauge, nil
}

// RegisterCustomHistogram creates and registers a custom histogram metric
func (bm *BusinessMetrics) RegisterCustomHistogram(name, help string, labels []string, buckets []float64) (*prometheus.HistogramVec, error) {
	bm.mu.Lock()
	defer bm.mu.Unlock()
	
	if _, exists := bm.customMetrics[name]; exists {
		return nil, prometheus.ErrAlreadyReg
	}
	
	if buckets == nil {
		buckets = prometheus.DefBuckets
	}
	
	histogram := prometheus.NewHistogramVec(
		prometheus.HistogramOpts{
			Name:    name,
			Help:    help,
			Buckets: buckets,
		},
		labels,
	)
	
	if err := bm.registry.Register(histogram); err != nil {
		return nil, err
	}
	
	bm.customMetrics[name] = histogram
	{{if eq .Logger "slog"}}bm.logger.Info("Custom histogram registered", "name", name){{else if eq .Logger "zap"}}bm.logger.Info("Custom histogram registered", zap.String("name", name)){{else if eq .Logger "logrus"}}bm.logger.WithField("name", name).Info("Custom histogram registered"){{else if eq .Logger "zerolog"}}bm.logger.Info().Str("name", name).Msg("Custom histogram registered"){{end}}
	
	return histogram, nil
}

// UnregisterCustomMetric unregisters a custom metric
func (bm *BusinessMetrics) UnregisterCustomMetric(name string) error {
	bm.mu.Lock()
	defer bm.mu.Unlock()
	
	collector, exists := bm.customMetrics[name]
	if !exists {
		return prometheus.ErrNotReg
	}
	
	if !bm.registry.Unregister(collector) {
		return prometheus.ErrNotReg
	}
	
	delete(bm.customMetrics, name)
	{{if eq .Logger "slog"}}bm.logger.Info("Custom metric unregistered", "name", name){{else if eq .Logger "zap"}}bm.logger.Info("Custom metric unregistered", zap.String("name", name)){{else if eq .Logger "logrus"}}bm.logger.WithField("name", name).Info("Custom metric unregistered"){{else if eq .Logger "zerolog"}}bm.logger.Info().Str("name", name).Msg("Custom metric unregistered"){{end}}
	
	return nil
}

// Utility Methods

// TimerFunc returns a function that records operation duration when called
func (bm *BusinessMetrics) TimerFunc(operation, service string) func(status string) {
	start := time.Now()
	bm.IncrementActiveOperations(operation, service)
	
	return func(status string) {
		duration := time.Since(start)
		bm.DecrementActiveOperations(operation, service)
		bm.RecordOperation(operation, service, status, duration)
	}
}

// WithOperationMetrics wraps a function with automatic operation metrics
func (bm *BusinessMetrics) WithOperationMetrics(operation, service string, fn func() error) error {
	timer := bm.TimerFunc(operation, service)
	
	err := fn()
	
	status := "success"
	if err != nil {
		status = "error"
	}
	
	timer(status)
	return err
}

// WithOperationMetricsCtx wraps a context function with automatic operation metrics
func (bm *BusinessMetrics) WithOperationMetricsCtx(operation, service string, fn func(context.Context) error) func(context.Context) error {
	return func(ctx context.Context) error {
		return bm.WithOperationMetrics(operation, service, func() error {
			return fn(ctx)
		})
	}
}

// GetCustomMetric retrieves a custom metric by name
func (bm *BusinessMetrics) GetCustomMetric(name string) (prometheus.Collector, bool) {
	bm.mu.RLock()
	defer bm.mu.RUnlock()
	
	metric, exists := bm.customMetrics[name]
	return metric, exists
}

// ListCustomMetrics returns the names of all registered custom metrics
func (bm *BusinessMetrics) ListCustomMetrics() []string {
	bm.mu.RLock()
	defer bm.mu.RUnlock()
	
	var names []string
	for name := range bm.customMetrics {
		names = append(names, name)
	}
	
	return names
}

