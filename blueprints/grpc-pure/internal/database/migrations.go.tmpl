//go:embed migrations/*.sql
var migrationFiles embed.FS

// Migration represents a database migration
type Migration struct {
	Version   int       `json:"version"`
	Name      string    `json:"name"`
	UpSQL     string    `json:"up_sql"`
	DownSQL   string    `json:"down_sql"`
	Applied   bool      `json:"applied"`
	AppliedAt time.Time `json:"applied_at"`
}

// MigrationRecord represents a migration record in the database
type MigrationRecord struct {
	Version   int       `{{if eq .DatabaseORM "gorm"}}gorm:"primaryKey;autoIncrement:false"{{end}} json:"version"`
	Name      string    `{{if eq .DatabaseORM "gorm"}}gorm:"size:255;not null"{{end}} json:"name"`
	AppliedAt time.Time `{{if eq .DatabaseORM "gorm"}}gorm:"not null"{{end}} json:"applied_at"`
	Checksum  string    `{{if eq .DatabaseORM "gorm"}}gorm:"size:64"{{end}} json:"checksum"`
}

{{if eq .DatabaseORM "gorm"}}// TableName specifies the table name for GORM
func (MigrationRecord) TableName() string {
	return "{{.ProjectName | lower}}_migrations"
}{{end}}

// MigrationManager handles database migrations
type MigrationManager struct {
	db     {{if eq .DatabaseORM "gorm"}}*gorm.DB{{else if eq .DatabaseORM "sqlx"}}*sqlx.DB{{else}}*sql.DB{{end}}
	logger {{if eq .Logger "slog"}}*slog.Logger{{else if eq .Logger "zap"}}*zap.Logger{{else if eq .Logger "logrus"}}*logrus.Logger{{else if eq .Logger "zerolog"}}*zerolog.Logger{{end}}
	
	migrations []Migration
	tableName  string
}

// NewMigrationManager creates a new migration manager
func NewMigrationManager(db {{if eq .DatabaseORM "gorm"}}*gorm.DB{{else if eq .DatabaseORM "sqlx"}}*sqlx.DB{{else}}*sql.DB{{end}}, logger {{if eq .Logger "slog"}}*slog.Logger{{else if eq .Logger "zap"}}*zap.Logger{{else if eq .Logger "logrus"}}*logrus.Logger{{else if eq .Logger "zerolog"}}*zerolog.Logger{{end}}) (*MigrationManager, error) {
	mm := &MigrationManager{
		db:        db,
		logger:    logger,
		tableName: "{{.ProjectName | lower}}_migrations",
	}
	
	if err := mm.loadMigrations(); err != nil {
		return nil, fmt.Errorf("failed to load migrations: %w", err)
	}
	
	if err := mm.ensureMigrationTable(); err != nil {
		return nil, fmt.Errorf("failed to create migration table: %w", err)
	}
	
	return mm, nil
}

// loadMigrations loads migration files from the embedded filesystem
func (mm *MigrationManager) loadMigrations() error {
	{{if eq .Logger "slog"}}mm.logger.Info("Loading migration files"){{else if eq .Logger "zap"}}mm.logger.Info("Loading migration files"){{else if eq .Logger "logrus"}}mm.logger.Info("Loading migration files"){{else if eq .Logger "zerolog"}}mm.logger.Info().Msg("Loading migration files"){{end}}
	
	entries, err := fs.ReadDir(migrationFiles, "migrations")
	if err != nil {
		return fmt.Errorf("failed to read migrations directory: %w", err)
	}
	
	migrationMap := make(map[int]*Migration)
	
	for _, entry := range entries {
		if entry.IsDir() {
			continue
		}
		
		filename := entry.Name()
		if !strings.HasSuffix(filename, ".sql") {
			continue
		}
		
		migration, err := mm.parseMigrationFile(filename)
		if err != nil {
			{{if eq .Logger "slog"}}mm.logger.Warn("Failed to parse migration file", "filename", filename, "error", err){{else if eq .Logger "zap"}}mm.logger.Warn("Failed to parse migration file", zap.String("filename", filename), zap.Error(err)){{else if eq .Logger "logrus"}}mm.logger.WithFields(logrus.Fields{"filename": filename, "error": err}).Warn("Failed to parse migration file"){{else if eq .Logger "zerolog"}}mm.logger.Warn().Str("filename", filename).Err(err).Msg("Failed to parse migration file"){{end}}
			continue
		}
		
		if existing, exists := migrationMap[migration.Version]; exists {
			if strings.Contains(filename, ".down.") {
				existing.DownSQL = migration.UpSQL
			}
		} else {
			migrationMap[migration.Version] = migration
		}
	}
	
	// Convert map to sorted slice
	versions := make([]int, 0, len(migrationMap))
	for version := range migrationMap {
		versions = append(versions, version)
	}
	sort.Ints(versions)
	
	mm.migrations = make([]Migration, 0, len(versions))
	for _, version := range versions {
		mm.migrations = append(mm.migrations, *migrationMap[version])
	}
	
	{{if eq .Logger "slog"}}mm.logger.Info("Loaded migrations", "count", len(mm.migrations)){{else if eq .Logger "zap"}}mm.logger.Info("Loaded migrations", zap.Int("count", len(mm.migrations))){{else if eq .Logger "logrus"}}mm.logger.WithField("count", len(mm.migrations)).Info("Loaded migrations"){{else if eq .Logger "zerolog"}}mm.logger.Info().Int("count", len(mm.migrations)).Msg("Loaded migrations"){{end}}
	
	return nil
}

// parseMigrationFile parses a migration file and extracts version and content
func (mm *MigrationManager) parseMigrationFile(filename string) (*Migration, error) {
	// Expected format: 001_migration_name.up.sql or 001_migration_name.down.sql
	parts := strings.Split(filename, "_")
	if len(parts) < 2 {
		return nil, fmt.Errorf("invalid migration filename format: %s", filename)
	}
	
	versionStr := parts[0]
	version, err := strconv.Atoi(versionStr)
	if err != nil {
		return nil, fmt.Errorf("invalid version in filename %s: %w", filename, err)
	}
	
	// Extract migration name (everything between version and .up/.down.sql)
	nameEnd := strings.LastIndex(filename, ".up.sql")
	if nameEnd == -1 {
		nameEnd = strings.LastIndex(filename, ".down.sql")
	}
	if nameEnd == -1 {
		return nil, fmt.Errorf("migration file must end with .up.sql or .down.sql: %s", filename)
	}
	
	name := strings.Join(strings.Split(filename[len(versionStr)+1:nameEnd], "_"), " ")
	
	// Read file content
	content, err := fs.ReadFile(migrationFiles, filepath.Join("migrations", filename))
	if err != nil {
		return nil, fmt.Errorf("failed to read migration file %s: %w", filename, err)
	}
	
	migration := &Migration{
		Version: version,
		Name:    name,
		UpSQL:   string(content),
	}
	
	return migration, nil
}

