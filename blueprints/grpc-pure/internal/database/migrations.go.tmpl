	{{if eq .Logger "slog"}}mm.logger.Info("Ensuring migration table exists", "table", mm.tableName){{else if eq .Logger "zap"}}mm.logger.Info("Ensuring migration table exists", zap.String("table", mm.tableName)){{else if eq .Logger "logrus"}}mm.logger.WithField("table", mm.tableName).Info("Ensuring migration table exists"){{else if eq .Logger "zerolog"}}mm.logger.Info().Str("table", mm.tableName).Msg("Ensuring migration table exists"){{end}}
	
{{if eq .DatabaseORM "gorm"}}	// Use GORM auto-migration for the migration table
	if err := mm.db.AutoMigrate(&MigrationRecord{}); err != nil {
		return fmt.Errorf("failed to create migration table: %w", err)
	}{{else}}	var createTableSQL string
	
	switch "{{.DatabaseDriver}}" {
{{if eq .DatabaseDriver "postgres"}}	case "postgres":
		createTableSQL = fmt.Sprintf(`
			CREATE TABLE IF NOT EXISTS %s (
				version INTEGER PRIMARY KEY,
				name VARCHAR(255) NOT NULL,
