// Migrate runs all pending migrations
func (mm *MigrationManager) Migrate(ctx context.Context) error {
	{{if eq .Logger "slog"}}mm.logger.Info("Starting database migration"){{else if eq .Logger "zap"}}mm.logger.Info("Starting database migration"){{else if eq .Logger "logrus"}}mm.logger.Info("Starting database migration"){{else if eq .Logger "zerolog"}}mm.logger.Info().Msg("Starting database migration"){{end}}
	
	appliedMigrations, err := mm.getAppliedMigrations(ctx)
	if err != nil {
		return fmt.Errorf("failed to get applied migrations: %w", err)
	}
	
	appliedVersions := make(map[int]bool)
	for _, migration := range appliedMigrations {
		appliedVersions[migration.Version] = true
	}
	
	var pendingMigrations []Migration
	for _, migration := range mm.migrations {
		if !appliedVersions[migration.Version] {
			pendingMigrations = append(pendingMigrations, migration)
		}
	}
	
	if len(pendingMigrations) == 0 {
		{{if eq .Logger "slog"}}mm.logger.Info("No pending migrations"){{else if eq .Logger "zap"}}mm.logger.Info("No pending migrations"){{else if eq .Logger "logrus"}}mm.logger.Info("No pending migrations"){{else if eq .Logger "zerolog"}}mm.logger.Info().Msg("No pending migrations"){{end}}
		return nil
	}
	
	{{if eq .Logger "slog"}}mm.logger.Info("Applying pending migrations", "count", len(pendingMigrations)){{else if eq .Logger "zap"}}mm.logger.Info("Applying pending migrations", zap.Int("count", len(pendingMigrations))){{else if eq .Logger "logrus"}}mm.logger.WithField("count", len(pendingMigrations)).Info("Applying pending migrations"){{else if eq .Logger "zerolog"}}mm.logger.Info().Int("count", len(pendingMigrations)).Msg("Applying pending migrations"){{end}}
	
	for _, migration := range pendingMigrations {
		if err := mm.applyMigration(ctx, migration); err != nil {
			return fmt.Errorf("failed to apply migration %d (%s): %w", migration.Version, migration.Name, err)
		}
		
		{{if eq .Logger "slog"}}mm.logger.Info("Applied migration", "version", migration.Version, "name", migration.Name){{else if eq .Logger "zap"}}mm.logger.Info("Applied migration", zap.Int("version", migration.Version), zap.String("name", migration.Name)){{else if eq .Logger "logrus"}}mm.logger.WithFields(logrus.Fields{"version": migration.Version, "name": migration.Name}).Info("Applied migration"){{else if eq .Logger "zerolog"}}mm.logger.Info().Int("version", migration.Version).Str("name", migration.Name).Msg("Applied migration"){{end}}
	}
	
	{{if eq .Logger "slog"}}mm.logger.Info("Database migration completed successfully"){{else if eq .Logger "zap"}}mm.logger.Info("Database migration completed successfully"){{else if eq .Logger "logrus"}}mm.logger.Info("Database migration completed successfully"){{else if eq .Logger "zerolog"}}mm.logger.Info().Msg("Database migration completed successfully"){{end}}
	
	return nil
}

// Rollback rolls back the last applied migration
func (mm *MigrationManager) Rollback(ctx context.Context) error {
	{{if eq .Logger "slog"}}mm.logger.Info("Starting migration rollback"){{else if eq .Logger "zap"}}mm.logger.Info("Starting migration rollback"){{else if eq .Logger "logrus"}}mm.logger.Info("Starting migration rollback"){{else if eq .Logger "zerolog"}}mm.logger.Info().Msg("Starting migration rollback"){{end}}
	
	appliedMigrations, err := mm.getAppliedMigrations(ctx)
	if err != nil {
		return fmt.Errorf("failed to get applied migrations: %w", err)
	}
	
	if len(appliedMigrations) == 0 {
		{{if eq .Logger "slog"}}mm.logger.Info("No migrations to rollback"){{else if eq .Logger "zap"}}mm.logger.Info("No migrations to rollback"){{else if eq .Logger "logrus"}}mm.logger.Info("No migrations to rollback"){{else if eq .Logger "zerolog"}}mm.logger.Info().Msg("No migrations to rollback"){{end}}
		return nil
	}
	
	// Find the last applied migration
	lastApplied := appliedMigrations[len(appliedMigrations)-1]
	
	// Find the corresponding migration with down SQL
	var migrationToRollback *Migration
	for _, migration := range mm.migrations {
		if migration.Version == lastApplied.Version {
			migrationToRollback = &migration
			break
		}
	}
	
	if migrationToRollback == nil {
		return fmt.Errorf("migration %d not found", lastApplied.Version)
	}
	
	if migrationToRollback.DownSQL == "" {
		return fmt.Errorf("migration %d (%s) has no down SQL", migrationToRollback.Version, migrationToRollback.Name)
	}
	
	if err := mm.rollbackMigration(ctx, *migrationToRollback); err != nil {
		return fmt.Errorf("failed to rollback migration %d (%s): %w", migrationToRollback.Version, migrationToRollback.Name, err)
	}
	
	{{if eq .Logger "slog"}}mm.logger.Info("Migration rollback completed", "version", migrationToRollback.Version, "name", migrationToRollback.Name){{else if eq .Logger "zap"}}mm.logger.Info("Migration rollback completed", zap.Int("version", migrationToRollback.Version), zap.String("name", migrationToRollback.Name)){{else if eq .Logger "logrus"}}mm.logger.WithFields(logrus.Fields{"version": migrationToRollback.Version, "name": migrationToRollback.Name}).Info("Migration rollback completed"){{else if eq .Logger "zerolog"}}mm.logger.Info().Int("version", migrationToRollback.Version).Str("name", migrationToRollback.Name).Msg("Migration rollback completed"){{end}}
	
	return nil
}

// applyMigration applies a single migration
func (mm *MigrationManager) applyMigration(ctx context.Context, migration Migration) error {
{{if eq .DatabaseORM "gorm"}}	return mm.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
		// Execute the migration SQL
		if err := tx.Exec(migration.UpSQL).Error; err != nil {
			return fmt.Errorf("failed to execute migration SQL: %w", err)
		}
		
		// Record the migration
		record := MigrationRecord{
			Version:   migration.Version,
			Name:      migration.Name,
			AppliedAt: time.Now(),
			Checksum:  mm.calculateChecksum(migration.UpSQL),
		}
		
		if err := tx.Create(&record).Error; err != nil {
			return fmt.Errorf("failed to record migration: %w", err)
		}
		
		return nil
	}){{else if eq .DatabaseORM "sqlx"}}	tx, err := mm.db.BeginTxx(ctx, nil)
	if err != nil {
		return fmt.Errorf("failed to begin transaction: %w", err)
	}
	
	defer func() {
		if p := recover(); p != nil {
			tx.Rollback()
			panic(p)
		} else if err != nil {
			tx.Rollback()
		} else {
			err = tx.Commit()
		}
	}()
	
	// Execute the migration SQL
	_, err = tx.ExecContext(ctx, migration.UpSQL)
	if err != nil {
		return fmt.Errorf("failed to execute migration SQL: %w", err)
	}
	
	// Record the migration
	_, err = tx.ExecContext(ctx, fmt.Sprintf(`
		INSERT INTO %s (version, name, applied_at, checksum) 
		VALUES ($1, $2, $3, $4)
	`, mm.tableName), migration.Version, migration.Name, time.Now(), mm.calculateChecksum(migration.UpSQL))
	
	if err != nil {
		return fmt.Errorf("failed to record migration: %w", err)
	}
	
	return nil{{else}}	tx, err := mm.db.BeginTx(ctx, nil)
	if err != nil {
		return fmt.Errorf("failed to begin transaction: %w", err)
	}
	
	defer func() {
		if p := recover(); p != nil {
			tx.Rollback()
			panic(p)
		} else if err != nil {
			tx.Rollback()
		} else {
			err = tx.Commit()
		}
	}()
	
	// Execute the migration SQL
	_, err = tx.ExecContext(ctx, migration.UpSQL)
	if err != nil {
		return fmt.Errorf("failed to execute migration SQL: %w", err)
	}
	
	// Record the migration  
	var placeholder string
	switch "{{.DatabaseDriver}}" {
	case "postgres":
		placeholder = "$1, $2, $3, $4"
	case "mysql":
		placeholder = "?, ?, ?, ?"
	case "sqlite":
		placeholder = "?, ?, ?, ?"
	}
	
	_, err = tx.ExecContext(ctx, fmt.Sprintf(`
		INSERT INTO %s (version, name, applied_at, checksum) 
		VALUES (%s)
	`, mm.tableName, placeholder), migration.Version, migration.Name, time.Now(), mm.calculateChecksum(migration.UpSQL))
	
	if err != nil {
		return fmt.Errorf("failed to record migration: %w", err)
	}
	
	return nil{{end}}
}

// rollbackMigration rolls back a single migration
func (mm *MigrationManager) rollbackMigration(ctx context.Context, migration Migration) error {
{{if eq .DatabaseORM "gorm"}}	return mm.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
		// Execute the rollback SQL
		if err := tx.Exec(migration.DownSQL).Error; err != nil {
			return fmt.Errorf("failed to execute rollback SQL: %w", err)
		}
		
		// Remove the migration record
		if err := tx.Delete(&MigrationRecord{}, "version = ?", migration.Version).Error; err != nil {
			return fmt.Errorf("failed to remove migration record: %w", err)
		}
		
		return nil
	}){{else}}	var err error
{{if eq .DatabaseORM "sqlx"}}	tx, err := mm.db.BeginTxx(ctx, nil){{else}}	tx, err := mm.db.BeginTx(ctx, nil){{end}}
	if err != nil {
		return fmt.Errorf("failed to begin transaction: %w", err)
	}
	
	defer func() {
		if p := recover(); p != nil {
			tx.Rollback()
			panic(p)
		} else if err != nil {
			tx.Rollback()
		} else {
			err = tx.Commit()
		}
	}()
	
	// Execute the rollback SQL
	_, err = tx.ExecContext(ctx, migration.DownSQL)
	if err != nil {
		return fmt.Errorf("failed to execute rollback SQL: %w", err)
	}
	
	// Remove the migration record
	var placeholder string
	switch "{{.DatabaseDriver}}" {
	case "postgres":
		placeholder = "$1"
	case "mysql", "sqlite":
		placeholder = "?"
	}
	
	_, err = tx.ExecContext(ctx, fmt.Sprintf(`
		DELETE FROM %s WHERE version = %s
	`, mm.tableName, placeholder), migration.Version)
	
	if err != nil {
		return fmt.Errorf("failed to remove migration record: %w", err)
	}
	
	return nil{{end}}
}

// getAppliedMigrations retrieves all applied migrations from the database
func (mm *MigrationManager) getAppliedMigrations(ctx context.Context) ([]MigrationRecord, error) {
{{if eq .DatabaseORM "gorm"}}	var records []MigrationRecord
	if err := mm.db.WithContext(ctx).Order("version ASC").Find(&records).Error; err != nil {
		return nil, err
	}
	return records, nil{{else}}	var records []MigrationRecord
	
{{if eq .DatabaseORM "sqlx"}}	err := mm.db.SelectContext(ctx, &records, fmt.Sprintf(`
		SELECT version, name, applied_at, checksum 
		FROM %s 
		ORDER BY version ASC
	`, mm.tableName)){{else}}	rows, err := mm.db.QueryContext(ctx, fmt.Sprintf(`
		SELECT version, name, applied_at, checksum 
		FROM %s 
		ORDER BY version ASC
	`, mm.tableName))
	if err != nil {
		return nil, err
	}
	defer rows.Close()
	
	for rows.Next() {
		var record MigrationRecord
		err := rows.Scan(&record.Version, &record.Name, &record.AppliedAt, &record.Checksum)
		if err != nil {
			return nil, err
		}
		records = append(records, record)
	}
	
	err = rows.Err(){{end}}
	
	if err != nil {
		return nil, err
	}
	
	return records, nil{{end}}
}

// GetStatus returns the current migration status
func (mm *MigrationManager) GetStatus(ctx context.Context) ([]Migration, error) {
	appliedMigrations, err := mm.getAppliedMigrations(ctx)
	if err != nil {
		return nil, fmt.Errorf("failed to get applied migrations: %w", err)
	}
	
	appliedVersions := make(map[int]MigrationRecord)
	for _, migration := range appliedMigrations {
		appliedVersions[migration.Version] = migration
	}
	
	var status []Migration
	for _, migration := range mm.migrations {
		if applied, exists := appliedVersions[migration.Version]; exists {
			migration.Applied = true
			migration.AppliedAt = applied.AppliedAt
		}
		status = append(status, migration)
	}
	
	return status, nil
}

// calculateChecksum calculates a simple checksum for migration content
func (mm *MigrationManager) calculateChecksum(content string) string {
	// Simple checksum - in production you might want to use a proper hash
	hash := 0
	for _, char := range content {
		hash = hash*31 + int(char)
	}
	return fmt.Sprintf("%x", hash)
}

// GetMigrationCount returns the total number of migrations
func (mm *MigrationManager) GetMigrationCount() int {
	return len(mm.migrations)
}

// GetAppliedCount returns the number of applied migrations
func (mm *MigrationManager) GetAppliedCount(ctx context.Context) (int, error) {
	appliedMigrations, err := mm.getAppliedMigrations(ctx)
	if err != nil {
		return 0, err
	}
	return len(appliedMigrations), nil
}

// Reset drops all tables and reapplies all migrations (dangerous!)
func (mm *MigrationManager) Reset(ctx context.Context) error {
	{{if eq .Logger "slog"}}mm.logger.Warn("Resetting database - this will drop all data!"){{else if eq .Logger "zap"}}mm.logger.Warn("Resetting database - this will drop all data!"){{else if eq .Logger "logrus"}}mm.logger.Warn("Resetting database - this will drop all data!"){{else if eq .Logger "zerolog"}}mm.logger.Warn().Msg("Resetting database - this will drop all data!"){{end}}
	
	// Get all applied migrations in reverse order
	appliedMigrations, err := mm.getAppliedMigrations(ctx)
	if err != nil {
		return fmt.Errorf("failed to get applied migrations: %w", err)
	}
	
	// Rollback all migrations
	for i := len(appliedMigrations) - 1; i >= 0; i-- {
		migration := appliedMigrations[i]
		
		// Find the migration with down SQL
		var migrationToRollback *Migration
		for _, m := range mm.migrations {
			if m.Version == migration.Version {
				migrationToRollback = &m
				break
			}
		}
		
		if migrationToRollback != nil && migrationToRollback.DownSQL != "" {
			if err := mm.rollbackMigration(ctx, *migrationToRollback); err != nil {
				{{if eq .Logger "slog"}}mm.logger.Error("Failed to rollback migration during reset", "version", migration.Version, "error", err){{else if eq .Logger "zap"}}mm.logger.Error("Failed to rollback migration during reset", zap.Int("version", migration.Version), zap.Error(err)){{else if eq .Logger "logrus"}}mm.logger.WithFields(logrus.Fields{"version": migration.Version, "error": err}).Error("Failed to rollback migration during reset"){{else if eq .Logger "zerolog"}}mm.logger.Error().Int("version", migration.Version).Err(err).Msg("Failed to rollback migration during reset"){{end}}
			}
		}
	}
	
	// Reapply all migrations
	return mm.Migrate(ctx)
}
