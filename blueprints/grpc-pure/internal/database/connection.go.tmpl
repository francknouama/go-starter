// HealthCheck performs a health check on the database
func (d *Database) HealthCheck(ctx context.Context) error {
	// Check connection
	if err := d.PingContext(ctx); err != nil {
		return fmt.Errorf("database ping failed: %w", err)
	}
	
	// Check connection pool stats
	stats := d.Stats()
	if stats.OpenConnections >= d.config.MaxOpenConns {
		{{if eq .Logger "slog"}}d.logger.Warn("Database connection pool at maximum capacity", "open_connections", stats.OpenConnections, "max_open_conns", d.config.MaxOpenConns){{else if eq .Logger "zap"}}d.logger.Warn("Database connection pool at maximum capacity", zap.Int("open_connections", stats.OpenConnections), zap.Int("max_open_conns", d.config.MaxOpenConns)){{else if eq .Logger "logrus"}}d.logger.WithFields(logrus.Fields{"open_connections": stats.OpenConnections, "max_open_conns": d.config.MaxOpenConns}).Warn("Database connection pool at maximum capacity"){{else if eq .Logger "zerolog"}}d.logger.Warn().Int("open_connections", stats.OpenConnections).Int("max_open_conns", d.config.MaxOpenConns).Msg("Database connection pool at maximum capacity"){{end}}
	}
	
	return nil
}

{{if eq .DatabaseORM "gorm"}}// Transaction operations for GORM

// Transaction executes a function within a database transaction
func (d *Database) Transaction(fn func(*gorm.DB) error) error {
	return d.db.Transaction(fn)
}

// TransactionContext executes a function within a database transaction with context
func (d *Database) TransactionContext(ctx context.Context, fn func(*gorm.DB) error) error {
	return d.db.WithContext(ctx).Transaction(fn)
}{{else if eq .DatabaseORM "sqlx"}}// Transaction operations for sqlx

// Transaction executes a function within a database transaction
func (d *Database) Transaction(fn func(*sqlx.Tx) error) error {
	tx, err := d.db.Beginx()
	if err != nil {
		return err
	}
	
	defer func() {
		if p := recover(); p != nil {
			tx.Rollback()
			panic(p)
		} else if err != nil {
			tx.Rollback()
		} else {
			err = tx.Commit()
		}
	}()
	
	err = fn(tx)
	return err
}

// TransactionContext executes a function within a database transaction with context
func (d *Database) TransactionContext(ctx context.Context, fn func(*sqlx.Tx) error) error {
	tx, err := d.db.BeginTxx(ctx, nil)
	if err != nil {
		return err
	}
	
	defer func() {
		if p := recover(); p != nil {
			tx.Rollback()
			panic(p)
		} else if err != nil {
			tx.Rollback()
		} else {
			err = tx.Commit()
		}
	}()
	
	err = fn(tx)
	return err
}{{else}}// Transaction operations for standard sql

// Transaction executes a function within a database transaction
func (d *Database) Transaction(fn func(*sql.Tx) error) error {
	tx, err := d.db.Begin()
	if err != nil {
		return err
	}
	
	defer func() {
		if p := recover(); p != nil {
			tx.Rollback()
			panic(p)
		} else if err != nil {
			tx.Rollback()
		} else {
			err = tx.Commit()
		}
	}()
	
	err = fn(tx)
	return err
}

// TransactionContext executes a function within a database transaction with context
func (d *Database) TransactionContext(ctx context.Context, fn func(*sql.Tx) error) error {
	tx, err := d.db.BeginTx(ctx, nil)
	if err != nil {
		return err
	}
	
	defer func() {
		if p := recover(); p != nil {
			tx.Rollback()
			panic(p)
		} else if err != nil {
			tx.Rollback()
		} else {
			err = tx.Commit()
		}
	}()
	
	err = fn(tx)
	return err
}{{end}}

// GetConnectionPool returns connection pool statistics as a map
func (d *Database) GetConnectionPool() map[string]interface{} {
	stats := d.Stats()
	return map[string]interface{}{
		"max_open_connections":     stats.MaxOpenConnections,
		"open_connections":         stats.OpenConnections,
		"in_use":                  stats.InUse,
		"idle":                    stats.Idle,
		"wait_count":              stats.WaitCount,
		"wait_duration":           stats.WaitDuration,
		"max_idle_closed":         stats.MaxIdleClosed,
		"max_idle_time_closed":    stats.MaxIdleTimeClosed,
		"max_lifetime_closed":     stats.MaxLifetimeClosed,
	}
}

