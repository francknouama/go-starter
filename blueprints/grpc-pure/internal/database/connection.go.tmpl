// DatabaseManager provides singleton access to database connection
type DatabaseManager struct {
	instance *Database
	once     sync.Once
}

var dbManager *DatabaseManager

// GetDatabaseManager returns the singleton database manager
func GetDatabaseManager() *DatabaseManager {
	if dbManager == nil {
		dbManager = &DatabaseManager{}
	}
	return dbManager
}

// Initialize sets up the database connection
func (dm *DatabaseManager) Initialize(config *DatabaseConfig, logger {{if eq .Logger "slog"}}*slog.Logger{{else if eq .Logger "zap"}}*zap.Logger{{else if eq .Logger "logrus"}}*logrus.Logger{{else if eq .Logger "zerolog"}}*zerolog.Logger{{end}}) error {
	var err error
	dm.once.Do(func() {
		dm.instance, err = NewDatabase(config, logger)
	})
	return err
}

// GetDatabase returns the database instance
func (dm *DatabaseManager) GetDatabase() *Database {
	return dm.instance
}

// Close closes the database connection
func (dm *DatabaseManager) Close() error {
	if dm.instance != nil {
		return dm.instance.Close()
	}
	return nil
}
