// TestHealthService_UpdateComponentHealth tests component health management
func (s *ServiceUnitTestSuite) TestHealthService_UpdateComponentHealth() {
	ctx := context.Background()

	// Update a component health status
	s.healthService.UpdateComponentHealth(
		"test-component",
		commonv1.HealthStatus_HEALTH_STATUS_HEALTHY,
		"Test component is healthy",
		25*time.Millisecond,
	)

	// Get detailed health info with components
	resp, err := s.healthService.GetHealth(ctx, &healthv1.GetHealthRequest{
		IncludeComponents: true,
	})
	s.Require().NoError(err, "GetHealth should not return an error")
	s.Require().NotNil(resp, "Response should not be nil")

	// Check if our test component is present
	if component, exists := resp.Components["test-component"]; exists {
		s.Assert().Equal(commonv1.HealthStatus_HEALTH_STATUS_HEALTHY, component.Status)
		s.Assert().Equal("Test component is healthy", component.Message)
		s.Assert().NotNil(component.LastCheck)
		s.Assert().Greater(component.DurationMs, int64(0))
		s.Assert().Equal(int32(0), component.ErrorCount)
	}
}

// TestHealthService_SetServiceStatus tests service status management
func (s *ServiceUnitTestSuite) TestHealthService_SetServiceStatus() {
	ctx := context.Background()

	// Set service status to not serving
	s.healthService.SetServiceStatus("test-service", healthv1.ServingStatus_SERVING_STATUS_NOT_SERVING)

	// Check the status
	resp, err := s.healthService.Check(ctx, &healthv1.HealthCheckRequest{
		Service: "test-service",
	})
	s.Require().NoError(err, "Health check should not return an error")
	s.Require().NotNil(resp, "Response should not be nil")

	s.Assert().Equal(healthv1.ServingStatus_SERVING_STATUS_NOT_SERVING, resp.Status)
}

// TestHealthService_ComponentFiltering tests component filtering in health checks
func (s *ServiceUnitTestSuite) TestHealthService_ComponentFiltering() {
	ctx := context.Background()

	// Add multiple test components
	s.healthService.UpdateComponentHealth(
		"component-a",
		commonv1.HealthStatus_HEALTH_STATUS_HEALTHY,
		"Component A is healthy",
		25*time.Millisecond,
	)
	s.healthService.UpdateComponentHealth(
		"component-b",
		commonv1.HealthStatus_HEALTH_STATUS_WARNING,
		"Component B has warnings",
		50*time.Millisecond,
	)

	// Test filtering specific components
	resp, err := s.healthService.GetHealth(ctx, &healthv1.GetHealthRequest{
		IncludeComponents: true,
		Components:        []string{"component-a"},
	})
	s.Require().NoError(err, "GetHealth with component filter should not return an error")
	s.Require().NotNil(resp, "Response should not be nil")

	// Should only contain component-a
	s.Assert().Contains(resp.Components, "component-a")
	s.Assert().NotContains(resp.Components, "component-b")
}

