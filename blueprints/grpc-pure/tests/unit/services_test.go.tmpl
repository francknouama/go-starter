// ServiceUnitTestSuite tests service layer functionality
type ServiceUnitTestSuite struct {
	suite.Suite
	
	logger        logger.Logger
	{{- if ne .DatabaseDriver ""}}
	mockUserRepo  *MockUserRepository
	{{- end}}
	mainService   *services.{{.ProjectName}}Service
	healthService *services.HealthService
}

// SetupSuite initializes the unit test environment
func (s *ServiceUnitTestSuite) SetupSuite() {
	// Initialize logger for testing
	var err error
	s.logger, err = logger.NewLogger("test", "error") // Use error level to reduce noise
	s.Require().NoError(err, "Failed to initialize test logger")
}

// SetupTest runs before each test
func (s *ServiceUnitTestSuite) SetupTest() {
	{{- if ne .DatabaseDriver ""}}
	// Create fresh mocks for each test
	s.mockUserRepo = new(MockUserRepository)
	
	// Initialize services with mocks
	s.mainService = services.New{{.ProjectName}}Service(s.logger, s.mockUserRepo)
	s.healthService = services.NewHealthService(s.logger, nil) // No DB for health service in unit tests
	{{- else}}
	// Initialize services
	s.mainService = services.New{{.ProjectName}}Service(s.logger)
	s.healthService = services.NewHealthService(s.logger)
	{{- end}}
}

// TearDownTest runs after each test
func (s *ServiceUnitTestSuite) TearDownTest() {
	{{- if ne .DatabaseDriver ""}}
	// Assert all mock expectations were met
	s.mockUserRepo.AssertExpectations(s.T())
	{{- end}}
}

// Test{{.ProjectName}}Service_GetVersion tests the GetVersion method
func (s *ServiceUnitTestSuite) Test{{.ProjectName}}Service_GetVersion() {
	ctx := context.Background()

	resp, err := s.mainService.GetVersion(ctx, &emptypb.Empty{})
	s.Require().NoError(err, "GetVersion should not return an error")
	s.Require().NotNil(resp, "Response should not be nil")

	s.Assert().Equal("1.0.0", resp.Version)
	s.Assert().Equal("{{.ProjectName | lower}}", resp.ServiceName)
	s.Assert().Equal("{{.GoVersion}}", resp.GoVersion)
	s.Assert().NotNil(resp.Status)
	s.Assert().Equal(commonv1.StatusCode_STATUS_CODE_OK, resp.Status.Code)
}

// Test{{.ProjectName}}Service_GetStatus tests the GetStatus method
func (s *ServiceUnitTestSuite) Test{{.ProjectName}}Service_GetStatus() {
	ctx := context.Background()

	// Test without details
	resp, err := s.mainService.GetStatus(ctx, &{{.ProjectName | lower}}v1.StatusRequest{
		IncludeDetails: false,
	})
	s.Require().NoError(err, "GetStatus should not return an error")
	s.Require().NotNil(resp, "Response should not be nil")

	s.Assert().Equal("{{.ProjectName | lower}}", resp.ServiceName)
	s.Assert().NotEmpty(resp.Uptime)
	s.Assert().NotNil(resp.Status)
	s.Assert().Empty(resp.Details)

	// Test with details
	resp, err = s.mainService.GetStatus(ctx, &{{.ProjectName | lower}}v1.StatusRequest{
		IncludeDetails: true,
	})
	s.Require().NoError(err, "GetStatus with details should not return an error")
	s.Require().NotNil(resp, "Response should not be nil")

	s.Assert().NotEmpty(resp.Details)
	s.Assert().Equal("grpc", resp.Details["service_type"])
	s.Assert().Equal("{{.GoVersion}}", resp.Details["go_version"])
	s.Assert().Equal("{{.Logger}}", resp.Details["logger_type"])
}

