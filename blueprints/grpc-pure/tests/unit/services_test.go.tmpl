// Test{{.ProjectName}}Service_ListUsers tests the ListUsers method
func (s *ServiceUnitTestSuite) Test{{.ProjectName}}Service_ListUsers() {
	ctx := context.Background()

	// Test successful user listing
	expectedUsers := []*models.User{
		{
			ID:        1,
			Name:      "John Doe",
			Email:     "john.doe@example.com",
			CreatedAt: time.Now(),
			UpdatedAt: time.Now(),
		},
		{
			ID:        2,
			Name:      "Jane Smith",
			Email:     "jane.smith@example.com",
			CreatedAt: time.Now(),
			UpdatedAt: time.Now(),
		},
	}

	s.mockUserRepo.On("List", ctx, 1, 10).Return(expectedUsers, 2, nil)

	resp, err := s.mainService.ListUsers(ctx, &{{.ProjectName | lower}}v1.ListUsersRequest{
		Page:     1,
		PageSize: 10,
	})
	s.Require().NoError(err, "ListUsers should not return an error")
	s.Require().NotNil(resp, "Response should not be nil")

	s.Assert().Len(resp.Users, 2)
	s.Assert().Equal("1", resp.Users[0].Id)
	s.Assert().Equal("John Doe", resp.Users[0].Name)
	s.Assert().Equal("2", resp.Users[1].Id)
	s.Assert().Equal("Jane Smith", resp.Users[1].Name)

	s.Assert().NotNil(resp.Pagination)
	s.Assert().Equal(int32(1), resp.Pagination.Page)
	s.Assert().Equal(int32(10), resp.Pagination.PageSize)
	s.Assert().Equal(int64(2), resp.Pagination.Total)
	s.Assert().Equal(int64(1), resp.Pagination.TotalPages)
}

