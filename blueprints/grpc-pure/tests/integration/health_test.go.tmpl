// TestHealthServiceShutdown tests graceful health service shutdown
func (s *HealthIntegrationTestSuite) TestHealthServiceShutdown() {
	// Create a temporary health service for shutdown testing
	tempHealthService := services.NewHealthService(s.logger{{if ne .DatabaseDriver ""}}, s.db{{end}})
	
	// Start health checks
	ctx, cancel := context.WithCancel(context.Background())
	tempHealthService.StartHealthChecks(ctx)
	
	// Wait a moment
	time.Sleep(100 * time.Millisecond)
	
	// Cancel context to stop health checks
	cancel()
	
	// Shutdown the service
	tempHealthService.Shutdown()
	
	// Service should shut down gracefully
	s.Assert().True(true, "Health service should shutdown gracefully")
}

// TestConcurrentHealthChecks tests concurrent health check requests
func (s *HealthIntegrationTestSuite) TestConcurrentHealthChecks() {
	const numRequests = 20

	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()

	// Create a channel to collect results
	results := make(chan error, numRequests)

	// Launch concurrent health check requests
	for i := 0; i < numRequests; i++ {
		go func(id int) {
			_, err := s.extHealthClient.Check(ctx, &healthv1.HealthCheckRequest{
				Service: "",
			})
			results <- err
		}(i)
	}

	// Collect results
	for i := 0; i < numRequests; i++ {
		err := <-results
		s.Assert().NoError(err, "Concurrent health check %d should not return an error", i)
	}
}

// TestHealthCheckFiltering tests component filtering in health checks
func (s *HealthIntegrationTestSuite) TestHealthCheckFiltering() {
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()

	// Add some test components
	s.healthService.UpdateComponentHealth(
		"component-a",
		commonv1.HealthStatus_HEALTH_STATUS_HEALTHY,
		"Component A is healthy",
		25*time.Millisecond,
	)
	s.healthService.UpdateComponentHealth(
		"component-b",
		commonv1.HealthStatus_HEALTH_STATUS_WARNING,
		"Component B has warnings",
		50*time.Millisecond,
	)

	// Wait for updates to be processed
	time.Sleep(100 * time.Millisecond)

	// Test filtering specific components
	resp, err := s.extHealthClient.GetHealth(ctx, &healthv1.GetHealthRequest{
		IncludeComponents: true,
		Components:        []string{"component-a"},
	})
	s.Require().NoError(err, "GetHealth with component filter should not return an error")
	s.Require().NotNil(resp, "Health response should not be nil")

	// Should only contain component-a
	s.Assert().Contains(resp.Components, "component-a")
	s.Assert().NotContains(resp.Components, "component-b")
}

// Run the health integration test suite
func TestHealthIntegrationSuite(t *testing.T) {
	suite.Run(t, new(HealthIntegrationTestSuite))
}