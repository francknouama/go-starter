// TestRateLimitInterceptor tests the rate limiting interceptor
func (s *InterceptorIntegrationTestSuite) TestRateLimitInterceptor() {
	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()

	// Make requests rapidly to potentially trigger rate limiting
	// Note: With a high rate limit (100 req/s), we need many requests to trigger it
	successCount := 0
	rateLimitedCount := 0
	
	for i := 0; i < 10; i++ { // Small number for test efficiency
		_, err := s.client.Echo(ctx, &{{.ProjectName | lower}}v1.EchoRequest{
			Message: fmt.Sprintf("rate limit test %d", i),
		})
		
		if err != nil {
			grpcStatus := status.Convert(err)
			if grpcStatus.Code() == codes.ResourceExhausted {
				rateLimitedCount++
			}
		} else {
			successCount++
		}
	}

	// With normal test load, most requests should succeed
	s.Assert().Greater(successCount, 0, "Some requests should succeed")
	// Rate limiting may or may not be triggered with low request count
}

