// InterceptorIntegrationTestSuite tests gRPC interceptor functionality
type InterceptorIntegrationTestSuite struct {
	suite.Suite
	
	server *server.GRPCServer
	conn   *grpc.ClientConn
	client {{.ProjectName | lower}}v1.{{.ProjectName}}ServiceClient
	
	cfg    *config.Config
	logger logger.Logger
	{{- if ne .DatabaseDriver ""}}
	db     interface{} // Database connection
	{{- end}}
}

// SetupSuite initializes the interceptor test environment
func (s *InterceptorIntegrationTestSuite) SetupSuite() {
	// Initialize logger
	var err error
	s.logger, err = logger.NewLogger("test", "debug")
	s.Require().NoError(err, "Failed to initialize logger")

	// Load test configuration with interceptors enabled
	s.cfg = &config.Config{
		Server: config.ServerConfig{
			GRPCPort:    0, // Use random port for testing
			MetricsPort: 0, // Use random port for testing
			Environment: "test",
		},
		Logger: config.LoggerConfig{
			Level:  "debug",
			Format: "json",
		},
		{{- if ne .DatabaseDriver ""}}
		Database: config.DatabaseConfig{
			Driver: "{{.DatabaseDriver}}",
			{{- if eq .DatabaseDriver "sqlite"}}
			URL:    ":memory:", // Use in-memory database for tests
			{{- else if eq .DatabaseDriver "postgres"}}
			URL:    "postgres://test:test@localhost:5432/test_db?sslmode=disable",
			{{- else if eq .DatabaseDriver "mysql"}}
			URL:    "test:test@tcp(localhost:3306)/test_db?parseTime=true",
			{{- end}}
			MaxOpenConns: 10,
			MaxIdleConns: 5,
		},
		{{- end}}
		{{- if .TracingEnabled}}
		Tracing: config.TracingConfig{
			Enabled:     true, // Enable for interceptor testing
			ServiceName: "{{.ProjectName | lower}}-interceptor-test",
		},
		{{- end}}
		{{- if .MetricsEnabled}}
		Metrics: config.MetricsConfig{
			Enabled: true,
			Path:    "/metrics",
		},
		{{- end}}
		{{- if ne .AuthType ""}}
		Auth: config.AuthConfig{
			Type: "{{.AuthType}}",
			{{- if eq .AuthType "jwt"}}
			JWTSecret: "test-secret-key-for-testing-only",
			{{- end}}
		},
		{{- end}}
		RateLimit: config.RateLimitConfig{
			Enabled: true,
			Rate:    100, // requests per second
			Burst:   200, // burst capacity
		},
	}

	{{- if ne .DatabaseDriver ""}}
	// Initialize database for testing
	s.db, err = database.InitDatabase(s.cfg.Database, s.logger)
	s.Require().NoError(err, "Failed to initialize test database")
	{{- end}}

	// Initialize services
	{{- if ne .DatabaseDriver ""}}
	userRepo := repository.NewUserRepository(s.db, s.logger)
	mainService := services.New{{.ProjectName}}Service(s.logger, userRepo)
	{{- else}}
	mainService := services.New{{.ProjectName}}Service(s.logger)
	{{- end}}
	healthService := services.NewHealthService(s.logger{{if ne .DatabaseDriver ""}}, s.db{{end}})

	// Create gRPC server with interceptors
	s.server, err = server.NewGRPCServer(s.cfg, s.logger)
	s.Require().NoError(err, "Failed to create gRPC server")

	// Register services
	s.server.RegisterServices(mainService, healthService)

	// Start server in background
	go func() {
		if err := s.server.Start(); err != nil {
			s.logger.Error("Failed to start interceptor test server", "error", err)
		}
	}()

	// Wait for server to start
	time.Sleep(100 * time.Millisecond)

	// Create client connection
	s.conn, err = grpc.Dial(
		s.server.GetAddress(),
		grpc.WithTransportCredentials(insecure.NewCredentials()),
		grpc.WithBlock(),
	)
	s.Require().NoError(err, "Failed to connect to interceptor test server")

	// Create service client
	s.client = {{.ProjectName | lower}}v1.New{{.ProjectName}}ServiceClient(s.conn)
}

// TearDownSuite cleans up the interceptor test environment
func (s *InterceptorIntegrationTestSuite) TearDownSuite() {
	if s.conn != nil {
		s.conn.Close()
	}
	if s.server != nil {
		s.server.Shutdown()
	}
}

// TestLoggingInterceptor tests the logging interceptor functionality
func (s *InterceptorIntegrationTestSuite) TestLoggingInterceptor() {
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()

	// Add request ID to context for correlation
	ctx = metadata.AppendToOutgoingContext(ctx, "x-request-id", "test-request-123")

	// Make a request - the logging interceptor should log it
	resp, err := s.client.GetVersion(ctx, &emptypb.Empty{})
	s.Require().NoError(err, "GetVersion should not return an error")
	s.Require().NotNil(resp, "Response should not be nil")

	// Verify response (logging verification would require log capture)
	s.Assert().Equal("1.0.0", resp.Version)
	s.Assert().Equal("{{.ProjectName | lower}}", resp.ServiceName)
}

