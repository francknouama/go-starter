// TestInterceptorChain tests that all interceptors work together
func (s *InterceptorIntegrationTestSuite) TestInterceptorChain() {
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()

	// Add various metadata that different interceptors might use
	ctx = metadata.AppendToOutgoingContext(ctx,
		"x-request-id", "chain-test-request",
		{{- if .TracingEnabled}}
		"x-trace-id", "chain-test-trace",
		{{- end}}
		"user-agent", "interceptor-chain-test/1.0",
	)

	// Make a request that goes through the entire interceptor chain
	resp, err := s.client.Echo(ctx, &{{.ProjectName | lower}}v1.EchoRequest{
		Message: "interceptor chain test",
	})
	s.Require().NoError(err, "Request should succeed through interceptor chain")
	s.Require().NotNil(resp, "Response should not be nil")

	s.Assert().Equal("Echo: interceptor chain test", resp.Message)
	s.Assert().NotNil(resp.Status)
}

// TestInterceptorPerformance tests that interceptors don't significantly impact performance
func (s *InterceptorIntegrationTestSuite) TestInterceptorPerformance() {
	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
	defer cancel()

	const numRequests = 100
	start := time.Now()

	// Make many requests to measure performance
	for i := 0; i < numRequests; i++ {
		_, err := s.client.Echo(ctx, &{{.ProjectName | lower}}v1.EchoRequest{
			Message: fmt.Sprintf("performance test %d", i),
		})
		s.Require().NoError(err, "Performance test request %d should not fail", i)
	}

	duration := time.Since(start)
	avgRequestTime := duration / numRequests

	s.logger.Info("Interceptor performance test completed",
		"total_requests", numRequests,
		"total_duration", duration.String(),
		"avg_request_time", avgRequestTime.String(),
	)

	// Assert that average request time is reasonable (less than 100ms)
	s.Assert().Less(avgRequestTime, 100*time.Millisecond, 
		"Average request time should be reasonable with interceptors")
}

// TestStreamingWithInterceptors tests that streaming requests work with interceptors
func (s *InterceptorIntegrationTestSuite) TestStreamingWithInterceptors() {
	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()

	stream, err := s.client.StreamEcho(ctx)
	s.Require().NoError(err, "StreamEcho should work with interceptors")

	// Send and receive multiple messages through the interceptor chain
	testMessages := []string{
		"streaming message 1",
		"streaming message 2", 
		"streaming message 3",
	}

	for _, msg := range testMessages {
		err := stream.Send(&{{.ProjectName | lower}}v1.EchoRequest{
			Message: msg,
		})
		s.Require().NoError(err, "Failed to send streaming message")

		resp, err := stream.Recv()
		s.Require().NoError(err, "Failed to receive streaming response")
		s.Assert().Equal("Stream Echo: "+msg, resp.Message)
	}

	err = stream.CloseSend()
	s.Require().NoError(err, "Failed to close send stream")
}

