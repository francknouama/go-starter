// TestInterceptorErrorHandling tests error handling through the interceptor chain
func (s *InterceptorIntegrationTestSuite) TestInterceptorErrorHandling() {
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()

	// Try to get a non-existent user (should return NotFound error)
	{{- if ne .DatabaseDriver ""}}
	_, err := s.client.GetUser(ctx, &{{.ProjectName | lower}}v1.GetUserRequest{
		Id: "non-existent-user-id",
	})
	s.Require().Error(err, "GetUser should return an error for non-existent user")

	// Check that the error is properly formatted through interceptors
	grpcStatus := status.Convert(err)
	s.Assert().Equal(codes.NotFound, grpcStatus.Code())
	{{- else}}
	// Test with invalid request (empty message)
	_, err := s.client.Echo(ctx, &{{.ProjectName | lower}}v1.EchoRequest{
		Message: "", // Empty message
	})
	// This should still succeed as echo doesn't validate message content
	s.NoError(err, "Echo should handle empty message")
	{{- end}}
}

// TestConcurrentRequestsWithInterceptors tests concurrent requests through interceptors
func (s *InterceptorIntegrationTestSuite) TestConcurrentRequestsWithInterceptors() {
	const numConcurrentRequests = 20

	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()

	// Create a channel to collect results
	results := make(chan error, numConcurrentRequests)

	// Launch concurrent requests
	for i := 0; i < numConcurrentRequests; i++ {
		go func(id int) {
			requestCtx := metadata.AppendToOutgoingContext(ctx,
				"x-request-id", fmt.Sprintf("concurrent-request-%d", id),
			)
			
			_, err := s.client.Echo(requestCtx, &{{.ProjectName | lower}}v1.EchoRequest{
				Message: fmt.Sprintf("concurrent message %d", id),
			})
			results <- err
		}(i)
	}

	// Collect results
	for i := 0; i < numConcurrentRequests; i++ {
		err := <-results
		s.Assert().NoError(err, "Concurrent request %d should not return an error", i)
	}
}

// Run the interceptor integration test suite
func TestInterceptorIntegrationSuite(t *testing.T) {
	suite.Run(t, new(InterceptorIntegrationTestSuite))
}