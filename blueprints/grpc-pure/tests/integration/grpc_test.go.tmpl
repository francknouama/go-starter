// TestGRPCHealthCheck tests the standard gRPC health check
func (s *GRPCIntegrationTestSuite) TestGRPCHealthCheck() {
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()

	resp, err := s.healthClient.Check(ctx, &grpc_health_v1.HealthCheckRequest{
		Service: "",
	})
	s.Require().NoError(err, "Health check should not return an error")
	s.Require().NotNil(resp, "Health response should not be nil")

	s.Assert().Equal(grpc_health_v1.HealthCheckResponse_SERVING, resp.Status)
}

// TestExtendedHealthCheck tests the extended health check service
func (s *GRPCIntegrationTestSuite) TestExtendedHealthCheck() {
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()

	// Test basic health check
	resp, err := s.extHealthClient.Check(ctx, &healthv1.HealthCheckRequest{
		Service: "",
	})
	s.Require().NoError(err, "Extended health check should not return an error")
	s.Require().NotNil(resp, "Health response should not be nil")

	s.Assert().NotNil(resp.Timestamp)
	s.Assert().NotEmpty(resp.Message)

	// Test detailed health check
	detailResp, err := s.extHealthClient.GetHealth(ctx, &healthv1.GetHealthRequest{
		IncludeComponents: true,
	})
	s.Require().NoError(err, "GetHealth should not return an error")
	s.Require().NotNil(detailResp, "Detailed health response should not be nil")

	s.Assert().NotNil(detailResp.StartedAt)
	s.Assert().NotNil(detailResp.Timestamp)
	s.Assert().Equal("{{.ProjectName}}-v1.0.0", detailResp.Version)
	s.Assert().NotEmpty(detailResp.Metadata)

	// Test readiness check
	readinessResp, err := s.extHealthClient.CheckReadiness(ctx, &healthv1.ReadinessRequest{})
	s.Require().NoError(err, "CheckReadiness should not return an error")
	s.Require().NotNil(readinessResp, "Readiness response should not be nil")

	s.Assert().True(readinessResp.Ready)
	s.Assert().NotEmpty(readinessResp.Message)

	// Test liveness check
	livenessResp, err := s.extHealthClient.CheckLiveness(ctx, &healthv1.LivenessRequest{})
	s.Require().NoError(err, "CheckLiveness should not return an error")
	s.Require().NotNil(livenessResp, "Liveness response should not be nil")

	s.Assert().True(livenessResp.Alive)
	s.Assert().Greater(livenessResp.UptimeSeconds, int64(0))
}

// TestConcurrentRequests tests handling of concurrent requests
func (s *GRPCIntegrationTestSuite) TestConcurrentRequests() {
	const numRequests = 10

	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()

	// Create a channel to collect results
	results := make(chan error, numRequests)

	// Launch concurrent requests
	for i := 0; i < numRequests; i++ {
		go func(id int) {
			_, err := s.client.Echo(ctx, &{{.ProjectName | lower}}v1.EchoRequest{
				Message: fmt.Sprintf("Concurrent message %d", id),
			})
			results <- err
		}(i)
	}

	// Collect results
	for i := 0; i < numRequests; i++ {
		err := <-results
		s.Assert().NoError(err, "Concurrent request %d should not return an error", i)
	}
}

// TestServerShutdown tests graceful server shutdown
func (s *GRPCIntegrationTestSuite) TestServerShutdown() {
	// This test is primarily to ensure the server can shut down gracefully
	// The actual shutdown happens in TearDownSuite
	s.Assert().NotNil(s.server, "Server should be initialized")
}

// Run the integration test suite
func TestGRPCIntegrationSuite(t *testing.T) {
	suite.Run(t, new(GRPCIntegrationTestSuite))
}