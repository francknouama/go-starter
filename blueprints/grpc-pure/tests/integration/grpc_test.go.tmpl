// TestUserCRUD tests the complete user CRUD operations
func (s *GRPCIntegrationTestSuite) TestUserCRUD() {
	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()

	// Test CreateUser
	createResp, err := s.client.CreateUser(ctx, &{{.ProjectName | lower}}v1.CreateUserRequest{
		Name:  "John Doe",
		Email: "john.doe@example.com",
	})
	s.Require().NoError(err, "CreateUser should not return an error")
	s.Require().NotNil(createResp, "Create response should not be nil")
	s.Require().NotNil(createResp.User, "Created user should not be nil")

	userID := createResp.User.Id
	s.Assert().NotEmpty(userID)
	s.Assert().Equal("John Doe", createResp.User.Name)
	s.Assert().Equal("john.doe@example.com", createResp.User.Email)

	// Test GetUser
	getResp, err := s.client.GetUser(ctx, &{{.ProjectName | lower}}v1.GetUserRequest{
		Id: userID,
	})
	s.Require().NoError(err, "GetUser should not return an error")
	s.Require().NotNil(getResp, "Get response should not be nil")
	s.Require().NotNil(getResp.User, "Retrieved user should not be nil")

	s.Assert().Equal(userID, getResp.User.Id)
	s.Assert().Equal("John Doe", getResp.User.Name)
	s.Assert().Equal("john.doe@example.com", getResp.User.Email)

	// Test UpdateUser
	updateResp, err := s.client.UpdateUser(ctx, &{{.ProjectName | lower}}v1.UpdateUserRequest{
		Id:    userID,
		Name:  "John Smith",
		Email: "john.smith@example.com",
	})
	s.Require().NoError(err, "UpdateUser should not return an error")
	s.Require().NotNil(updateResp, "Update response should not be nil")
	s.Require().NotNil(updateResp.User, "Updated user should not be nil")

	s.Assert().Equal(userID, updateResp.User.Id)
	s.Assert().Equal("John Smith", updateResp.User.Name)
	s.Assert().Equal("john.smith@example.com", updateResp.User.Email)

	// Test ListUsers
	listResp, err := s.client.ListUsers(ctx, &{{.ProjectName | lower}}v1.ListUsersRequest{
		Page:     1,
		PageSize: 10,
	})
	s.Require().NoError(err, "ListUsers should not return an error")
	s.Require().NotNil(listResp, "List response should not be nil")

	s.Assert().GreaterOrEqual(len(listResp.Users), 1)
	s.Assert().NotNil(listResp.Pagination)
	s.Assert().Equal(int32(1), listResp.Pagination.Page)

	// Test DeleteUser
	deleteResp, err := s.client.DeleteUser(ctx, &{{.ProjectName | lower}}v1.DeleteUserRequest{
		Id: userID,
	})
	s.Require().NoError(err, "DeleteUser should not return an error")
	s.Require().NotNil(deleteResp, "Delete response should not be nil")
	s.Assert().NotNil(deleteResp.Status)

	// Verify user is deleted
	_, err = s.client.GetUser(ctx, &{{.ProjectName | lower}}v1.GetUserRequest{
		Id: userID,
	})
	s.Assert().Error(err, "GetUser should return an error for deleted user")
}

