// GRPCIntegrationTestSuite tests the complete gRPC service integration
type GRPCIntegrationTestSuite struct {
	suite.Suite
	
	server     *server.GRPCServer
	conn       *grpc.ClientConn
	client     {{.ProjectName | lower}}v1.{{.ProjectName}}ServiceClient
	healthClient grpc_health_v1.HealthClient
	extHealthClient healthv1.HealthServiceClient
	
	cfg        *config.Config
	logger     logger.Logger
	{{- if ne .DatabaseDriver ""}}
	db         interface{} // Database connection
	{{- end}}
	
	testPort   int
}

// SetupSuite initializes the test environment
func (s *GRPCIntegrationTestSuite) SetupSuite() {
	// Initialize logger
	var err error
	s.logger, err = logger.NewLogger("test", "debug")
	s.Require().NoError(err, "Failed to initialize logger")

	// Load test configuration
	s.cfg = &config.Config{
		Server: config.ServerConfig{
			GRPCPort:    0, // Use random port for testing
			MetricsPort: 0, // Use random port for testing
			Environment: "test",
		},
		Logger: config.LoggerConfig{
			Level:  "debug",
			Format: "json",
		},
		{{- if ne .DatabaseDriver ""}}
		Database: config.DatabaseConfig{
			Driver: "{{.DatabaseDriver}}",
			{{- if eq .DatabaseDriver "sqlite"}}
			URL:    ":memory:", // Use in-memory database for tests
			{{- else if eq .DatabaseDriver "postgres"}}
			URL:    "postgres://test:test@localhost:5432/test_db?sslmode=disable",
			{{- else if eq .DatabaseDriver "mysql"}}
			URL:    "test:test@tcp(localhost:3306)/test_db?parseTime=true",
			{{- end}}
			MaxOpenConns: 10,
			MaxIdleConns: 5,
		},
		{{- end}}
		{{- if .TracingEnabled}}
		Tracing: config.TracingConfig{
			Enabled:     false, // Disable for integration tests
			ServiceName: "{{.ProjectName | lower}}-test",
		},
		{{- end}}
		{{- if .MetricsEnabled}}
		Metrics: config.MetricsConfig{
			Enabled: true,
			Path:    "/metrics",
		},
		{{- end}}
	}

	{{- if ne .DatabaseDriver ""}}
	// Initialize database for testing
	s.db, err = database.InitDatabase(s.cfg.Database, s.logger)
	s.Require().NoError(err, "Failed to initialize test database")
	{{- end}}

	// Initialize services
	{{- if ne .DatabaseDriver ""}}
	userRepo := repository.NewUserRepository(s.db, s.logger)
	mainService := services.New{{.ProjectName}}Service(s.logger, userRepo)
	{{- else}}
	mainService := services.New{{.ProjectName}}Service(s.logger)
	{{- end}}
	healthService := services.NewHealthService(s.logger{{if ne .DatabaseDriver ""}}, s.db{{end}})

	// Create gRPC server
	s.server, err = server.NewGRPCServer(s.cfg, s.logger)
	s.Require().NoError(err, "Failed to create gRPC server")

	// Register services
	s.server.RegisterServices(mainService, healthService)

	// Start server in background
	go func() {
		if err := s.server.Start(); err != nil {
			s.logger.Error("Failed to start test server", "error", err)
		}
	}()

	// Wait for server to start
	time.Sleep(100 * time.Millisecond)

	// Get the actual port assigned by the server
	s.testPort = s.server.GetPort()
	s.Require().NotZero(s.testPort, "Server port should be assigned")

	// Create client connection
	s.conn, err = grpc.Dial(
		s.server.GetAddress(),
		grpc.WithTransportCredentials(insecure.NewCredentials()),
		grpc.WithBlock(),
	)
	s.Require().NoError(err, "Failed to connect to test server")

	// Create service clients
	s.client = {{.ProjectName | lower}}v1.New{{.ProjectName}}ServiceClient(s.conn)
	s.healthClient = grpc_health_v1.NewHealthClient(s.conn)
	s.extHealthClient = healthv1.NewHealthServiceClient(s.conn)
}

// TearDownSuite cleans up the test environment
func (s *GRPCIntegrationTestSuite) TearDownSuite() {
	if s.conn != nil {
		s.conn.Close()
	}
	if s.server != nil {
		s.server.Shutdown()
	}
}

// TestGetVersion tests the GetVersion service method
func (s *GRPCIntegrationTestSuite) TestGetVersion() {
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()

	resp, err := s.client.GetVersion(ctx, &emptypb.Empty{})
	s.Require().NoError(err, "GetVersion should not return an error")
	s.Require().NotNil(resp, "Response should not be nil")

	s.Assert().Equal("1.0.0", resp.Version)
	s.Assert().Equal("{{.ProjectName | lower}}", resp.ServiceName)
	s.Assert().Equal("{{.GoVersion}}", resp.GoVersion)
	s.Assert().NotNil(resp.Status)
	s.Assert().Equal(int32(0), int32(resp.Status.Code)) // STATUS_CODE_OK
}

// TestGetStatus tests the GetStatus service method
func (s *GRPCIntegrationTestSuite) TestGetStatus() {
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()

	// Test without details
	resp, err := s.client.GetStatus(ctx, &{{.ProjectName | lower}}v1.StatusRequest{
		IncludeDetails: false,
	})
	s.Require().NoError(err, "GetStatus should not return an error")
	s.Require().NotNil(resp, "Response should not be nil")

	s.Assert().Equal("{{.ProjectName | lower}}", resp.ServiceName)
	s.Assert().NotEmpty(resp.Uptime)
	s.Assert().NotNil(resp.Status)
	s.Assert().Empty(resp.Details)

	// Test with details
	resp, err = s.client.GetStatus(ctx, &{{.ProjectName | lower}}v1.StatusRequest{
		IncludeDetails: true,
	})
	s.Require().NoError(err, "GetStatus with details should not return an error")
	s.Require().NotNil(resp, "Response should not be nil")

	s.Assert().NotEmpty(resp.Details)
	s.Assert().Equal("grpc", resp.Details["service_type"])
	s.Assert().Equal("{{.GoVersion}}", resp.Details["go_version"])
	s.Assert().Equal("{{.Logger}}", resp.Details["logger_type"])
	{{- if ne .DatabaseDriver ""}}
	s.Assert().Equal("{{.DatabaseDriver}}", resp.Details["database"])
	{{- end}}
}

// TestEcho tests the Echo service method
func (s *GRPCIntegrationTestSuite) TestEcho() {
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()

	testMessage := "Hello, gRPC!"
	resp, err := s.client.Echo(ctx, &{{.ProjectName | lower}}v1.EchoRequest{
		Message: testMessage,
	})
	s.Require().NoError(err, "Echo should not return an error")
	s.Require().NotNil(resp, "Response should not be nil")

	s.Assert().Equal("Echo: "+testMessage, resp.Message)
	s.Assert().NotNil(resp.Status)
	s.Assert().Equal(int32(0), int32(resp.Status.Code)) // STATUS_CODE_OK
}

// TestStreamEcho tests the bidirectional streaming echo service
func (s *GRPCIntegrationTestSuite) TestStreamEcho() {
	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()

	stream, err := s.client.StreamEcho(ctx)
	s.Require().NoError(err, "StreamEcho should not return an error")

	// Test multiple messages
	testMessages := []string{
		"First message",
		"Second message",
		"Third message",
	}

	// Send messages and receive responses
	for _, msg := range testMessages {
		err := stream.Send(&{{.ProjectName | lower}}v1.EchoRequest{
			Message: msg,
		})
		s.Require().NoError(err, "Failed to send message")

		resp, err := stream.Recv()
		s.Require().NoError(err, "Failed to receive response")
		s.Assert().Equal("Stream Echo: "+msg, resp.Message)
		s.Assert().NotNil(resp.Status)
	}

	// Close the stream
	err = stream.CloseSend()
	s.Require().NoError(err, "Failed to close send stream")
}

