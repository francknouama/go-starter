// TestStreamingLoadTest tests bidirectional streaming under load
func (s *GRPCLoadTestSuite) TestStreamingLoadTest() {
	const (
		numStreams = 10
		messagesPerStream = 20
	)

	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
	defer cancel()

	var wg sync.WaitGroup
	results := make(chan LoadTestResult, numStreams)

	for i := 0; i < numStreams; i++ {
		wg.Add(1)
		go func(streamID int) {
			defer wg.Done()

			start := time.Now()
			var errors []string
			successCount := 0

			stream, err := s.client.StreamEcho(ctx)
			if err != nil {
				errors = append(errors, fmt.Sprintf("Failed to create stream: %v", err))
				results <- LoadTestResult{
					TotalRequests: messagesPerStream,
					FailedReqs:    messagesPerStream,
					Errors:        errors,
				}
				return
			}

			// Send messages
			for j := 0; j < messagesPerStream; j++ {
				err := stream.Send(&{{.ProjectName | lower}}v1.EchoRequest{
					Message: fmt.Sprintf("Stream %d message %d", streamID, j),
				})
				if err != nil {
					errors = append(errors, fmt.Sprintf("Send failed: %v", err))
					continue
				}

				_, err = stream.Recv()
				if err != nil {
					errors = append(errors, fmt.Sprintf("Recv failed: %v", err))
					continue
				}

				successCount++
			}

			stream.CloseSend()
			duration := time.Since(start)

			results <- LoadTestResult{
				TotalRequests:   messagesPerStream,
				SuccessfulReqs:  successCount,
				FailedReqs:      messagesPerStream - successCount,
				TotalDuration:   duration,
				AvgResponseTime: duration / time.Duration(messagesPerStream),
				RequestsPerSec:  float64(messagesPerStream) / duration.Seconds(),
				Errors:          errors,
			}
		}(i)
	}

	wg.Wait()
	close(results)

	// Aggregate results
	totalSuccess := 0
	totalFailed := 0
	totalReqs := 0
	var allErrors []string

	for result := range results {
		totalSuccess += result.SuccessfulReqs
		totalFailed += result.FailedReqs
		totalReqs += result.TotalRequests
		allErrors = append(allErrors, result.Errors...)
	}

	s.logger.Info("Streaming Load Test Results",
		"total_streams", numStreams,
		"messages_per_stream", messagesPerStream,
		"total_requests", totalReqs,
		"successful_requests", totalSuccess,
		"failed_requests", totalFailed,
		"success_rate", float64(totalSuccess)/float64(totalReqs)*100,
	)

	// Assertions
	s.Assert().Equal(numStreams*messagesPerStream, totalReqs)
	s.Assert().Greater(totalSuccess, totalReqs*80/100, "At least 80% success rate expected for streaming")
	s.Assert().LessOrEqual(len(allErrors), totalReqs*20/100, "Error rate should be less than 20%")
}

// TestMixedWorkloadLoadTest tests a mixed workload scenario
func (s *GRPCLoadTestSuite) TestMixedWorkloadLoadTest() {
	const (
		numGoroutines = 30
		requestsPerGoroutine = 15
		totalRequests = numGoroutines * requestsPerGoroutine
	)

	ctx, cancel := context.WithTimeout(context.Background(), 45*time.Second)
	defer cancel()

	// Define mixed workload operations
	operations := []func(context.Context, int) error{
		// Health check (40% of requests)
		func(ctx context.Context, id int) error {
			_, err := s.healthClient.Check(ctx, &grpc_health_v1.HealthCheckRequest{Service: ""})
			return err
		},
		// Echo (30% of requests)
		func(ctx context.Context, id int) error {
			_, err := s.client.Echo(ctx, &{{.ProjectName | lower}}v1.EchoRequest{
				Message: fmt.Sprintf("Mixed workload echo %d", id),
			})
			return err
		},
		// GetVersion (20% of requests)
		func(ctx context.Context, id int) error {
			_, err := s.client.GetVersion(ctx, &emptypb.Empty{})
			return err
		},
		// GetStatus (10% of requests)
		func(ctx context.Context, id int) error {
			_, err := s.client.GetStatus(ctx, &{{.ProjectName | lower}}v1.StatusRequest{IncludeDetails: false})
			return err
		},
	}

	weights := []int{40, 30, 20, 10} // Percentage weights

	result := s.runLoadTest(ctx, "Mixed Workload Load Test", numGoroutines, requestsPerGoroutine, func(ctx context.Context, id int) error {
		// Select operation based on weights
		opIndex := s.selectOperationByWeight(id, weights)
		return operations[opIndex](ctx, id)
	})

	s.logLoadTestResult("Mixed Workload Load Test", result)

	// Assertions
	s.Assert().Equal(totalRequests, result.TotalRequests)
	s.Assert().Greater(result.SuccessfulReqs, totalRequests*90/100, "At least 90% success rate expected for mixed workload")
	s.Assert().Less(result.AvgResponseTime, 150*time.Millisecond, "Mixed workload should maintain good performance")
	s.Assert().Greater(result.RequestsPerSec, 80.0, "Should handle at least 80 requests per second with mixed workload")
}

// runLoadTest executes a load test with the given parameters
func (s *GRPCLoadTestSuite) runLoadTest(
	ctx context.Context,
	testName string,
	numGoroutines int,
	requestsPerGoroutine int,
	operation func(context.Context, int) error,
) LoadTestResult {
	var wg sync.WaitGroup
	results := make(chan time.Duration, numGoroutines*requestsPerGoroutine)
	errors := make(chan string, numGoroutines*requestsPerGoroutine)

	start := time.Now()

	// Launch goroutines
	for i := 0; i < numGoroutines; i++ {
		wg.Add(1)
		go func(goroutineID int) {
			defer wg.Done()

			for j := 0; j < requestsPerGoroutine; j++ {
				requestStart := time.Now()
				requestID := goroutineID*requestsPerGoroutine + j

				err := operation(ctx, requestID)
				requestDuration := time.Since(requestStart)

				if err != nil {
					errors <- fmt.Sprintf("Request %d failed: %v", requestID, err)
				} else {
					results <- requestDuration
				}
			}
		}(i)
	}

	wg.Wait()
	totalDuration := time.Since(start)

	close(results)
	close(errors)

	// Collect results
	var responseTimes []time.Duration
	var errorList []string

	for duration := range results {
		responseTimes = append(responseTimes, duration)
	}

	for err := range errors {
		errorList = append(errorList, err)
	}

	// Calculate statistics
	totalRequests := numGoroutines * requestsPerGoroutine
	successfulReqs := len(responseTimes)
	failedReqs := len(errorList)

	result := LoadTestResult{
		TotalRequests:  totalRequests,
		SuccessfulReqs: successfulReqs,
		FailedReqs:     failedReqs,
		TotalDuration:  totalDuration,
		RequestsPerSec: float64(totalRequests) / totalDuration.Seconds(),
		Errors:         errorList,
	}

	if len(responseTimes) > 0 {
		// Calculate average response time
		var totalTime time.Duration
		minTime := responseTimes[0]
		maxTime := responseTimes[0]

		for _, duration := range responseTimes {
			totalTime += duration
			if duration < minTime {
				minTime = duration
			}
			if duration > maxTime {
				maxTime = duration
			}
		}

		result.AvgResponseTime = totalTime / time.Duration(len(responseTimes))
		result.MinResponseTime = minTime
		result.MaxResponseTime = maxTime
	}

	return result
}

// selectOperationByWeight selects an operation index based on weights
func (s *GRPCLoadTestSuite) selectOperationByWeight(id int, weights []int) int {
	totalWeight := 0
	for _, weight := range weights {
		totalWeight += weight
	}

	selector := id % totalWeight
	currentWeight := 0

	for i, weight := range weights {
		currentWeight += weight
		if selector < currentWeight {
			return i
		}
	}

	return 0 // Fallback
}

// logLoadTestResult logs detailed load test results
func (s *GRPCLoadTestSuite) logLoadTestResult(testName string, result LoadTestResult) {
	successRate := float64(result.SuccessfulReqs) / float64(result.TotalRequests) * 100

	s.logger.Info("Load Test Results",
		"test_name", testName,
		"total_requests", result.TotalRequests,
		"successful_requests", result.SuccessfulReqs,
		"failed_requests", result.FailedReqs,
		"success_rate_percent", fmt.Sprintf("%.2f", successRate),
		"total_duration", result.TotalDuration.String(),
		"avg_response_time", result.AvgResponseTime.String(),
		"min_response_time", result.MinResponseTime.String(),
		"max_response_time", result.MaxResponseTime.String(),
		"requests_per_second", fmt.Sprintf("%.2f", result.RequestsPerSec),
		"error_count", len(result.Errors),
	)

	if len(result.Errors) > 0 {
		s.logger.Warn("Load test errors occurred",
			"test_name", testName,
			"error_count", len(result.Errors),
			"first_few_errors", result.Errors[:min(5, len(result.Errors))],
		)
	}
}

// min returns the minimum of two integers
func min(a, b int) int {
	if a < b {
		return a
	}
	return b
}

// Run the load test suite
func TestGRPCLoadTestSuite(t *testing.T) {
	// Skip load tests in short mode
	if testing.Short() {
		t.Skip("Skipping load tests in short mode")
	}

	suite.Run(t, new(GRPCLoadTestSuite))
}