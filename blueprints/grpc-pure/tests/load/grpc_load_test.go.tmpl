// LoadTestResult represents the results of a load test
type LoadTestResult struct {
	TotalRequests    int
	SuccessfulReqs   int
	FailedReqs       int
	TotalDuration    time.Duration
	AvgResponseTime  time.Duration
	MinResponseTime  time.Duration
	MaxResponseTime  time.Duration
	RequestsPerSec   float64
	Errors           []string
}

// GRPCLoadTestSuite tests gRPC service performance under load
type GRPCLoadTestSuite struct {
	suite.Suite
	
	server       *server.GRPCServer
	conn         *grpc.ClientConn
	client       {{.ProjectName | lower}}v1.{{.ProjectName}}ServiceClient
	healthClient grpc_health_v1.HealthClient
	extHealthClient healthv1.HealthServiceClient
	
	cfg    *config.Config
	logger logger.Logger
	{{- if ne .DatabaseDriver ""}}
	db     interface{} // Database connection
	{{- end}}
}

// SetupSuite initializes the load test environment
func (s *GRPCLoadTestSuite) SetupSuite() {
	// Initialize logger with higher level to reduce noise during load testing
	var err error
	s.logger, err = logger.NewLogger("load-test", "warn")
	s.Require().NoError(err, "Failed to initialize load test logger")

	// Load optimized configuration for load testing
	s.cfg = &config.Config{
		Server: config.ServerConfig{
			GRPCPort:    0, // Use random port for testing
			MetricsPort: 0, // Use random port for testing
			Environment: "load-test",
		},
		Logger: config.LoggerConfig{
			Level:  "warn", // Reduce logging overhead
			Format: "json",
		},
		{{- if ne .DatabaseDriver ""}}
		Database: config.DatabaseConfig{
			Driver: "{{.DatabaseDriver}}",
			{{- if eq .DatabaseDriver "sqlite"}}
			URL:    ":memory:", // Use in-memory database for load tests
			{{- else if eq .DatabaseDriver "postgres"}}
			URL:    "postgres://test:test@localhost:5432/load_test_db?sslmode=disable",
			{{- else if eq .DatabaseDriver "mysql"}}
			URL:    "test:test@tcp(localhost:3306)/load_test_db?parseTime=true",
			{{- end}}
			MaxOpenConns: 50,  // Increased for load testing
			MaxIdleConns: 25,  // Increased for load testing
		},
		{{- end}}
		{{- if .TracingEnabled}}
		Tracing: config.TracingConfig{
			Enabled:     false, // Disable tracing for load tests to reduce overhead
			ServiceName: "{{.ProjectName | lower}}-load-test",
		},
		{{- end}}
		{{- if .MetricsEnabled}}
		Metrics: config.MetricsConfig{
			Enabled: true,
			Path:    "/metrics",
		},
		{{- end}}
		RateLimit: config.RateLimitConfig{
			Enabled: false, // Disable rate limiting for load tests
		},
	}

	{{- if ne .DatabaseDriver ""}}
	// Initialize database for load testing
	s.db, err = database.InitDatabase(s.cfg.Database, s.logger)
	s.Require().NoError(err, "Failed to initialize load test database")
	{{- end}}

	// Initialize services
	{{- if ne .DatabaseDriver ""}}
	userRepo := repository.NewUserRepository(s.db, s.logger)
	mainService := services.New{{.ProjectName}}Service(s.logger, userRepo)
	{{- else}}
	mainService := services.New{{.ProjectName}}Service(s.logger)
	{{- end}}
	healthService := services.NewHealthService(s.logger{{if ne .DatabaseDriver ""}}, s.db{{end}})

	// Create optimized gRPC server for load testing
	s.server, err = server.NewGRPCServer(s.cfg, s.logger)
	s.Require().NoError(err, "Failed to create load test gRPC server")

	// Register services
	s.server.RegisterServices(mainService, healthService)

	// Start server in background
	go func() {
		if err := s.server.Start(); err != nil {
			s.logger.Error("Failed to start load test server", "error", err)
		}
	}()

	// Wait for server to start
	time.Sleep(200 * time.Millisecond)

	// Create client connection with optimized settings
	s.conn, err = grpc.Dial(
		s.server.GetAddress(),
		grpc.WithTransportCredentials(insecure.NewCredentials()),
		grpc.WithBlock(),
		grpc.WithDefaultCallOptions(
			grpc.MaxCallRecvMsgSize(4*1024*1024), // 4MB
			grpc.MaxCallSendMsgSize(4*1024*1024), // 4MB
		),
	)
	s.Require().NoError(err, "Failed to connect to load test server")

	// Create service clients
	s.client = {{.ProjectName | lower}}v1.New{{.ProjectName}}ServiceClient(s.conn)
	s.healthClient = grpc_health_v1.NewHealthClient(s.conn)
	s.extHealthClient = healthv1.NewHealthServiceClient(s.conn)
}

// TearDownSuite cleans up the load test environment
func (s *GRPCLoadTestSuite) TearDownSuite() {
	if s.conn != nil {
		s.conn.Close()
	}
	if s.server != nil {
		s.server.Shutdown()
	}
}

// TestEchoLoadTest tests Echo service under load
func (s *GRPCLoadTestSuite) TestEchoLoadTest() {
	const (
		numGoroutines = 50
		requestsPerGoroutine = 20
		totalRequests = numGoroutines * requestsPerGoroutine
	)

	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
	defer cancel()

	result := s.runLoadTest(ctx, "Echo Load Test", numGoroutines, requestsPerGoroutine, func(ctx context.Context, id int) error {
		_, err := s.client.Echo(ctx, &{{.ProjectName | lower}}v1.EchoRequest{
			Message: fmt.Sprintf("Load test message %d", id),
		})
		return err
	})

	s.logLoadTestResult("Echo Load Test", result)

	// Assertions
	s.Assert().Equal(totalRequests, result.TotalRequests)
	s.Assert().Greater(result.SuccessfulReqs, totalRequests*90/100, "At least 90% success rate expected")
	s.Assert().Less(result.AvgResponseTime, 100*time.Millisecond, "Average response time should be under 100ms")
	s.Assert().Greater(result.RequestsPerSec, 100.0, "Should handle at least 100 requests per second")
}

