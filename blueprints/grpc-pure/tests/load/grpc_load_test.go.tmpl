// TestUserCRUDLoadTest tests user CRUD operations under load
func (s *GRPCLoadTestSuite) TestUserCRUDLoadTest() {
	const (
		numGoroutines = 20
		requestsPerGoroutine = 10
		totalRequests = numGoroutines * requestsPerGoroutine
	)

	ctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)
	defer cancel()

	result := s.runLoadTest(ctx, "User CRUD Load Test", numGoroutines, requestsPerGoroutine, func(ctx context.Context, id int) error {
		// Create user
		createResp, err := s.client.CreateUser(ctx, &{{.ProjectName | lower}}v1.CreateUserRequest{
			Name:  fmt.Sprintf("Load Test User %d", id),
			Email: fmt.Sprintf("loadtest%d@example.com", id),
		})
		if err != nil {
			return fmt.Errorf("create user failed: %w", err)
		}

		userID := createResp.User.Id

		// Get user
		_, err = s.client.GetUser(ctx, &{{.ProjectName | lower}}v1.GetUserRequest{
			Id: userID,
		})
		if err != nil {
			return fmt.Errorf("get user failed: %w", err)
		}

		// Update user
		_, err = s.client.UpdateUser(ctx, &{{.ProjectName | lower}}v1.UpdateUserRequest{
			Id:    userID,
			Name:  fmt.Sprintf("Updated Load Test User %d", id),
			Email: fmt.Sprintf("updated.loadtest%d@example.com", id),
		})
		if err != nil {
			return fmt.Errorf("update user failed: %w", err)
		}

		// Delete user
		_, err = s.client.DeleteUser(ctx, &{{.ProjectName | lower}}v1.DeleteUserRequest{
			Id: userID,
		})
		if err != nil {
			return fmt.Errorf("delete user failed: %w", err)
		}

		return nil
	})

	s.logLoadTestResult("User CRUD Load Test", result)

	// Assertions (more lenient for database operations)
	s.Assert().Equal(totalRequests, result.TotalRequests)
	s.Assert().Greater(result.SuccessfulReqs, totalRequests*80/100, "At least 80% success rate expected for CRUD operations")
	s.Assert().Less(result.AvgResponseTime, 500*time.Millisecond, "CRUD operations should complete within 500ms on average")
	s.Assert().Greater(result.RequestsPerSec, 20.0, "Should handle at least 20 CRUD sequences per second")
}

