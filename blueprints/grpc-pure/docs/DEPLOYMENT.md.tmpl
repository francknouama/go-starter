**2. PrometheusRule:**
```yaml
apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: {{.ProjectName | lower}}
  namespace: {{.ProjectName | lower}}
spec:
  groups:
  - name: {{.ProjectName | lower}}.rules
    rules:
    - alert: HighErrorRate
      expr: rate(grpc_server_requests_total{grpc_code!="OK"}[5m]) > 0.1
      for: 5m
      labels:
        severity: warning
      annotations:
        summary: "High error rate detected"
    - alert: HighLatency
      expr: histogram_quantile(0.95, rate(grpc_server_request_duration_seconds_bucket[5m])) > 0.5
      for: 5m
      labels:
        severity: warning
      annotations:
        summary: "High latency detected"
```
{{- end}}

