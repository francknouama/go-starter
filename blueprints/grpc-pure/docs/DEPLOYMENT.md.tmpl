## Kubernetes Deployment

### Basic Deployment

**1. Namespace:**
```yaml
apiVersion: v1
kind: Namespace
metadata:
  name: {{.ProjectName | lower}}
  labels:
    app.kubernetes.io/name: {{.ProjectName | lower}}
    app.kubernetes.io/version: "v1.0.0"
```

**2. ConfigMap:**
```yaml
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{.ProjectName | lower}}-config
  namespace: {{.ProjectName | lower}}
data:
  config.yaml: |
    server:
      grpc_port: {{.GrpcPort | default 50051}}
      {{- if .MetricsEnabled}}
      metrics_port: {{.MetricsPort | default 8080}}
      {{- end}}
    logging:
      level: info
      format: json
```

**3. Secret:**
```yaml
apiVersion: v1
kind: Secret
metadata:
  name: {{.ProjectName | lower}}-secrets
  namespace: {{.ProjectName | lower}}
type: Opaque
data:
  {{- if eq .AuthType "jwt"}}
  jwt-secret: <base64-encoded-jwt-secret>
  {{- end}}
  {{- if ne .DatabaseDriver ""}}
  database-url: <base64-encoded-database-url>
  {{- end}}
  # TLS certificates
  tls.crt: <base64-encoded-cert>
  tls.key: <base64-encoded-key>
```

**4. Deployment:**
```yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{.ProjectName | lower}}
  namespace: {{.ProjectName | lower}}
  labels:
    app.kubernetes.io/name: {{.ProjectName | lower}}
    app.kubernetes.io/component: grpc-service
spec:
  replicas: 3
  selector:
    matchLabels:
      app.kubernetes.io/name: {{.ProjectName | lower}}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{.ProjectName | lower}}
        app.kubernetes.io/component: grpc-service
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        fsGroup: 1000
      containers:
      - name: {{.ProjectName | lower}}
        image: {{.ProjectName | lower}}:v1.0.0
        ports:
        - containerPort: {{.GrpcPort | default 50051}}
          name: grpc
          protocol: TCP
        {{- if .MetricsEnabled}}
        - containerPort: {{.MetricsPort | default 8080}}
          name: metrics
          protocol: TCP
        {{- end}}
        env:
        - name: GRPC_PORT
          value: "{{.GrpcPort | default 50051}}"
        {{- if .MetricsEnabled}}
        - name: METRICS_PORT
          value: "{{.MetricsPort | default 8080}}"
        {{- end}}
        {{- if ne .DatabaseDriver ""}}
        - name: DATABASE_URL
          valueFrom:
            secretKeyRef:
              name: {{.ProjectName | lower}}-secrets
              key: database-url
        {{- end}}
        {{- if eq .AuthType "jwt"}}
        - name: JWT_SECRET
          valueFrom:
            secretKeyRef:
              name: {{.ProjectName | lower}}-secrets
              key: jwt-secret
        {{- end}}
        volumeMounts:
        - name: config
          mountPath: /app/config.yaml
          subPath: config.yaml
          readOnly: true
        - name: tls-certs
          mountPath: /app/certs
          readOnly: true
        livenessProbe:
          exec:
            command:
            - grpc_health_probe
            - -addr=:{{.GrpcPort | default 50051}}
          initialDelaySeconds: 10
          periodSeconds: 30
        readinessProbe:
          exec:
            command:
            - grpc_health_probe
            - -addr=:{{.GrpcPort | default 50051}}
          initialDelaySeconds: 5
          periodSeconds: 10
        resources:
          limits:
            cpu: 500m
            memory: 512Mi
          requests:
            cpu: 250m
            memory: 256Mi
      volumes:
      - name: config
        configMap:
          name: {{.ProjectName | lower}}-config
      - name: tls-certs
        secret:
          secretName: {{.ProjectName | lower}}-secrets
          items:
          - key: tls.crt
            path: server.crt
          - key: tls.key
            path: server.key
```

**5. Service:**
```yaml
apiVersion: v1
kind: Service
metadata:
  name: {{.ProjectName | lower}}
  namespace: {{.ProjectName | lower}}
  labels:
    app.kubernetes.io/name: {{.ProjectName | lower}}
    app.kubernetes.io/component: grpc-service
spec:
  type: ClusterIP
  ports:
  - port: {{.GrpcPort | default 50051}}
    targetPort: grpc
    protocol: TCP
    name: grpc
  {{- if .MetricsEnabled}}
  - port: {{.MetricsPort | default 8080}}
    targetPort: metrics
    protocol: TCP
    name: metrics
  {{- end}}
  selector:
    app.kubernetes.io/name: {{.ProjectName | lower}}
```

