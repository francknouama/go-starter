    with grpc.insecure_channel('localhost:{{.GrpcPort | default 50051}}') as channel:
        # Create stub
        stub = {{.ProjectName | lower}}_pb2_grpc.{{.ProjectName}}ServiceStub(channel)
        
        # Call GetVersion
        response = stub.GetVersion({{.ProjectName | lower}}_pb2.Empty())
