module {{.ModulePath}}

go {{.GoVersion}}

require (
	// Core gRPC dependencies with all required subpackages
	google.golang.org/grpc v1.67.1
	google.golang.org/protobuf v1.35.1
	
	// gRPC Gateway ecosystem - Updated to latest secure versions
	github.com/grpc-ecosystem/grpc-gateway/v2 v2.22.0
	google.golang.org/genproto/googleapis/api v0.0.0-20241104194629-dd2ea8efbc28
	google.golang.org/genproto/googleapis/rpc v0.0.0-20241104194629-dd2ea8efbc28
	
	// HTTP framework and utilities
	github.com/gin-gonic/gin v1.10.0
	github.com/spf13/viper v1.18.2
	github.com/go-playground/validator/v10 v10.20.0
	github.com/google/uuid v1.6.0
	
	// Testing framework
	github.com/stretchr/testify v1.9.0
	
	// Additional required protobuf and googleapis dependencies  
	google.golang.org/genproto v0.0.0-20241104194629-dd2ea8efbc28
	{{- if eq .Logger "zap"}}
	go.uber.org/zap v1.27.0
	{{- else if eq .Logger "logrus"}}
	github.com/sirupsen/logrus v1.9.3
	{{- else if eq .Logger "zerolog"}}
	github.com/rs/zerolog v1.33.0
	{{- end}}
	
	// Rate limiting (conditional)
	{{- if .EnableRateLimiting}}
	golang.org/x/time v0.5.0
	{{- end}}
{{- if ne .DatabaseDriver ""}}
	{{- if eq .DatabaseORM "gorm"}}
	gorm.io/gorm v1.25.4
		{{- if eq .DatabaseDriver "postgres"}}
	gorm.io/driver/postgres v1.5.2
		{{- else if eq .DatabaseDriver "mysql"}}
	gorm.io/driver/mysql v1.5.2
		{{- else if eq .DatabaseDriver "sqlite"}}
	gorm.io/driver/sqlite v1.5.4
		{{- end}}
	{{- else if eq .DatabaseORM "sqlx"}}
	github.com/jmoiron/sqlx v1.3.5
		{{- if eq .DatabaseDriver "postgres"}}
	github.com/lib/pq v1.10.9
		{{- else if eq .DatabaseDriver "mysql"}}
	github.com/go-sql-driver/mysql v1.7.1
		{{- else if eq .DatabaseDriver "sqlite"}}
	github.com/mattn/go-sqlite3 v1.14.17
		{{- end}}
	{{- else}}
		{{- if eq .DatabaseDriver "postgres"}}
	github.com/lib/pq v1.10.9
		{{- else if eq .DatabaseDriver "mysql"}}
	github.com/go-sql-driver/mysql v1.7.1
		{{- else if eq .DatabaseDriver "sqlite"}}
	github.com/mattn/go-sqlite3 v1.14.17
		{{- end}}
	{{- end}}
{{- end}}
	{{- if ne .AuthType ""}}
	golang.org/x/crypto v0.23.0
	{{- end}}
	{{- if eq .AuthType "jwt"}}
	github.com/golang-jwt/jwt/v5 v5.2.1
	{{- else if eq .AuthType "oauth2"}}
	golang.org/x/oauth2 v0.20.0
	{{- end}}
)