version: v2
managed:
  enabled: true
  override:
    - file_option: go_package_prefix
      value: {{.ModulePath}}/gen
inputs:
  - directory: proto
plugins:
  # Go protobuf code generation
  - remote: buf.build/protocolbuffers/go:v1.35.1
    out: gen
    opt:
      - paths=source_relative
  # gRPC service stubs
  - remote: buf.build/grpc/go:v1.5.1
    out: gen
    opt:
      - paths=source_relative
  # gRPC Gateway REST proxy generation
  - remote: buf.build/grpc-ecosystem/grpc-gateway:v2.22.0
    out: gen
    opt:
      - paths=source_relative
      - generate_unbound_methods=true
  # OpenAPI v2 documentation generation
  - remote: buf.build/grpc-ecosystem/openapiv2:v2.22.0
    out: api
    opt:
      - logtostderr=true
      - allow_merge=true
      - merge_file_name={{.ProjectName}}.swagger.json