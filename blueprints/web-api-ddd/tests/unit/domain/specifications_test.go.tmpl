	spec := {{.DomainName}}.NewNamePatternSpecification(allowedPatterns)

	tests := []struct {
		name           string
		user           *{{.DomainName}}.{{.DomainName | title}}Aggregate
		expectedResult bool
		expectError    bool
	}{
		{
			name:           "nil user should not satisfy",
			user:           nil,
			expectedResult: false,
			expectError:    true,
		},
		{
			name: "user with allowed name should satisfy",
			user: func() *{{.DomainName}}.{{.DomainName | title}}Aggregate {
				user, _ := {{.DomainName}}.New{{.DomainName | title}}Aggregate("John Doe", "john@example.com", "Test user")
				return user
			}(),
			expectedResult: true,
			expectError:    false,
		},
		{
			name: "user with disallowed name should not satisfy",
			user: func() *{{.DomainName}}.{{.DomainName | title}}Aggregate {
				user, _ := {{.DomainName}}.New{{.DomainName | title}}Aggregate("Bob Wilson", "bob@example.com", "Test user")
				return user
			}(),
			expectedResult: false,
			expectError:    true,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			result := spec.IsSatisfiedBy(tt.user)
			assert.Equal(t, tt.expectedResult, result)

			err := spec.WhyNotSatisfiedBy(tt.user)
			if tt.expectError {
				assert.Error(t, err)
			} else {
				assert.NoError(t, err)
			}
		})
	}

	// Test with no patterns (should allow any name)
	t.Run("no patterns should allow any name", func(t *testing.T) {
		emptySpec := {{.DomainName}}.NewNamePatternSpecification([]string{})
		user, _ := {{.DomainName}}.New{{.DomainName | title}}Aggregate("Any Name", "any@example.com", "Test user")

		result := emptySpec.IsSatisfiedBy(user)
		assert.True(t, result)

		err := emptySpec.WhyNotSatisfiedBy(user)
