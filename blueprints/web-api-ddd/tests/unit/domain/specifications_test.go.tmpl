func TestActiveSpecification(t *testing.T) {
	spec := {{.DomainName}}.NewActiveSpecification()

	tests := []struct {
		name           string
		user           *{{.DomainName}}.{{.DomainName | title}}Aggregate
		expectedResult bool
		expectError    bool
	}{
		{
			name:           "nil user should not satisfy",
			user:           nil,
			expectedResult: false,
			expectError:    true,
		},
		{
			name: "active user should satisfy",
			user: func() *{{.DomainName}}.{{.DomainName | title}}Aggregate {
				user, _ := {{.DomainName}}.New{{.DomainName | title}}Aggregate("John Doe", "john@example.com", "Test user")
				return user
			}(),
			expectedResult: true,
			expectError:    false,
		},
		{
			name: "inactive user should not satisfy",
			user: func() *{{.DomainName}}.{{.DomainName | title}}Aggregate {
				user, _ := {{.DomainName}}.New{{.DomainName | title}}Aggregate("Jane Doe", "jane@example.com", "Test user")
				user.Deactivate("test")
				return user
			}(),
			expectedResult: false,
			expectError:    true,
		},
		{
			name: "deleted user should not satisfy",
			user: func() *{{.DomainName}}.{{.DomainName | title}}Aggregate {
				user, _ := {{.DomainName}}.New{{.DomainName | title}}Aggregate("Bob Doe", "bob@example.com", "Test user")
				user.Delete("test")
				return user
			}(),
			expectedResult: false,
			expectError:    true,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			result := spec.IsSatisfiedBy(tt.user)
			assert.Equal(t, tt.expectedResult, result)

			err := spec.WhyNotSatisfiedBy(tt.user)
			if tt.expectError {
				assert.Error(t, err)
			} else {
				assert.NoError(t, err)
			}
		})
	}
}

