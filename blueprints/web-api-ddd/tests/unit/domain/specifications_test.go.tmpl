// Helper function to create users with different states for testing
func createTestUserWithState(name, email string, state string) *{{.DomainName}}.{{.DomainName | title}}Aggregate {
	user, _ := {{.DomainName}}.New{{.DomainName | title}}Aggregate(name, email, "Test user")
	
	switch state {
	case "inactive":
		user.Deactivate("test")
	case "deleted":
		user.Delete("test")
	case "active":
		// Already active by default
	}
	
	return user
}

func TestSpecificationChaining(t *testing.T) {
	// Create test users
	activeUser := createTestUserWithState("Active User", "active@example.com", "active")
	inactiveUser := createTestUserWithState("Inactive User", "inactive@example.com", "inactive")
	deletedUser := createTestUserWithState("Deleted User", "deleted@example.com", "deleted")

	// Create base specifications
	activeSpec := {{.DomainName}}.NewActiveSpecification()
	canBeUpdatedSpec := {{.DomainName}}.NewCanBeUpdatedSpecification()
	canBeDeletedSpec := {{.DomainName}}.NewCanBeDeletedSpecification()

	tests := []struct {
		name     string
		spec     {{.DomainName}}.Specification
		user     *{{.DomainName}}.{{.DomainName | title}}Aggregate
		expected bool
	}{
		{
			name:     "active user satisfies active spec",
			spec:     activeSpec,
			user:     activeUser,
			expected: true,
		},
		{
			name:     "inactive user does not satisfy active spec",
			spec:     activeSpec,
			user:     inactiveUser,
			expected: false,
		},
		{
			name:     "active AND can be updated - active user",
			spec:     activeSpec.And(canBeUpdatedSpec),
			user:     activeUser,
			expected: true,
		},
		{
			name:     "active AND can be updated - inactive user",
			spec:     activeSpec.And(canBeUpdatedSpec),
			user:     inactiveUser,
			expected: false,
		},
		{
			name:     "active OR can be deleted - active user",
			spec:     activeSpec.Or(canBeDeletedSpec),
			user:     activeUser,
			expected: true,
		},
		{
			name:     "active OR can be deleted - inactive user",
			spec:     activeSpec.Or(canBeDeletedSpec),
			user:     inactiveUser,
			expected: true, // Can be deleted
		},
		{
			name:     "active OR can be deleted - deleted user",
			spec:     activeSpec.Or(canBeDeletedSpec),
			user:     deletedUser,
			expected: false, // Neither active nor can be deleted
		},
		{
			name:     "NOT active - active user",
			spec:     activeSpec.Not(),
			user:     activeUser,
			expected: false,
		},
		{
			name:     "NOT active - inactive user",
			spec:     activeSpec.Not(),
			user:     inactiveUser,
			expected: true,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			result := tt.spec.IsSatisfiedBy(tt.user)
			assert.Equal(t, tt.expected, result)

			err := tt.spec.WhyNotSatisfiedBy(tt.user)
			if tt.expected {
				assert.NoError(t, err)
			} else {
				assert.Error(t, err)
			}
		})
	}
}