func TestCompositeSpecifications(t *testing.T) {
	// Create test users
	activeUser, _ := {{.DomainName}}.New{{.DomainName | title}}Aggregate("John Doe", "john@example.com", "Test user")
	
	inactiveUser, _ := {{.DomainName}}.New{{.DomainName | title}}Aggregate("Jane Doe", "jane@example.com", "Test user")
	inactiveUser.Deactivate("test")
	
	deletedUser, _ := {{.DomainName}}.New{{.DomainName | title}}Aggregate("Bob Doe", "bob@example.com", "Test user")
	deletedUser.Delete("test")

	// Create specifications
	activeSpec := {{.DomainName}}.NewActiveSpecification()
	validNameSpec := {{.DomainName}}.NewValidNameSpecification()
	canBeUpdatedSpec := {{.DomainName}}.NewCanBeUpdatedSpecification()

	t.Run("AND specification", func(t *testing.T) {
		// Active AND has valid name
		andSpec := activeSpec.And(validNameSpec)

		// Active user with valid name should satisfy
		assert.True(t, andSpec.IsSatisfiedBy(activeUser))
		assert.NoError(t, andSpec.WhyNotSatisfiedBy(activeUser))

		// Inactive user should not satisfy (fails on first condition)
		assert.False(t, andSpec.IsSatisfiedBy(inactiveUser))
		assert.Error(t, andSpec.WhyNotSatisfiedBy(inactiveUser))

		// Deleted user should not satisfy
		assert.False(t, andSpec.IsSatisfiedBy(deletedUser))
		assert.Error(t, andSpec.WhyNotSatisfiedBy(deletedUser))
	})

	t.Run("OR specification", func(t *testing.T) {
		// Active OR can be updated
		orSpec := activeSpec.Or(canBeUpdatedSpec)

		// Active user should satisfy (first condition true)
		assert.True(t, orSpec.IsSatisfiedBy(activeUser))
		assert.NoError(t, orSpec.WhyNotSatisfiedBy(activeUser))

		// Inactive user should satisfy (second condition true - can be updated)
		assert.True(t, orSpec.IsSatisfiedBy(inactiveUser))
		assert.NoError(t, orSpec.WhyNotSatisfiedBy(inactiveUser))

		// Deleted user should not satisfy (both conditions false)
		assert.False(t, orSpec.IsSatisfiedBy(deletedUser))
		assert.Error(t, orSpec.WhyNotSatisfiedBy(deletedUser))
	})

	t.Run("NOT specification", func(t *testing.T) {
		// NOT active (i.e., inactive or deleted)
		notActiveSpec := activeSpec.Not()

		// Active user should not satisfy
		assert.False(t, notActiveSpec.IsSatisfiedBy(activeUser))
		assert.Error(t, notActiveSpec.WhyNotSatisfiedBy(activeUser))

		// Inactive user should satisfy
		assert.True(t, notActiveSpec.IsSatisfiedBy(inactiveUser))
		assert.NoError(t, notActiveSpec.WhyNotSatisfiedBy(inactiveUser))

		// Deleted user should satisfy
		assert.True(t, notActiveSpec.IsSatisfiedBy(deletedUser))
		assert.NoError(t, notActiveSpec.WhyNotSatisfiedBy(deletedUser))
	})

	t.Run("complex composite specification", func(t *testing.T) {
		// (Active AND ValidName) OR CanBeUpdated
		complexSpec := activeSpec.And(validNameSpec).Or(canBeUpdatedSpec)

		// Active user with valid name should satisfy
		assert.True(t, complexSpec.IsSatisfiedBy(activeUser))
		assert.NoError(t, complexSpec.WhyNotSatisfiedBy(activeUser))

		// Inactive user should satisfy (can be updated)
		assert.True(t, complexSpec.IsSatisfiedBy(inactiveUser))
		assert.NoError(t, complexSpec.WhyNotSatisfiedBy(inactiveUser))

		// Deleted user should not satisfy (fails all conditions)
		assert.False(t, complexSpec.IsSatisfiedBy(deletedUser))
		assert.Error(t, complexSpec.WhyNotSatisfiedBy(deletedUser))
	})
}

func TestCustomBusinessSpecification(t *testing.T) {
	// Create a custom specification for testing
	type RecentlyCreatedSpecification struct {
		{{.DomainName}}.CompositeSpecification
		withinDays int
	}
	
	satisfiedByFunc := func(s *RecentlyCreatedSpecification) func(*{{.DomainName}}.{{.DomainName | title}}Aggregate) bool {
		return func(user *{{.DomainName}}.{{.DomainName | title}}Aggregate) bool {
			if user == nil {
				return false
			}
			daysSinceCreation := time.Since(user.CreatedAt()).Hours() / 24
			return daysSinceCreation <= float64(s.withinDays)
		}
	}
	
	whyNotSatisfiedByFunc := func(s *RecentlyCreatedSpecification) func(*{{.DomainName}}.{{.DomainName | title}}Aggregate) error {
		return func(user *{{.DomainName}}.{{.DomainName | title}}Aggregate) error {
			if user == nil {
				return {{.DomainName}}.ErrUserNotFound
			}
			if satisfiedByFunc(s)(user) {
				return nil
			}
			return {{.DomainName}}.ErrUserNotFound.WithDetails("reason", "user not created recently enough")
		}
	}

	// Create test users
	recentUser, _ := {{.DomainName}}.New{{.DomainName | title}}Aggregate("Recent User", "recent@example.com", "Recently created")
	
	// For testing older user, we'd need to manipulate creation time
	// In a real scenario, you'd use the reconstruction method or have test data
	olderUser, _ := {{.DomainName}}.New{{.DomainName | title}}Aggregate("Old User", "old@example.com", "Old user")

	// Test the custom specification
	recentSpec := &RecentlyCreatedSpecification{withinDays: 7}

	t.Run("recently created user satisfies", func(t *testing.T) {
		result := satisfiedByFunc(recentSpec)(recentUser)
		assert.True(t, result)

		err := whyNotSatisfiedByFunc(recentSpec)(recentUser)
		assert.NoError(t, err)
	})

	t.Run("nil user does not satisfy", func(t *testing.T) {
		result := satisfiedByFunc(recentSpec)(nil)
		assert.False(t, result)

		err := whyNotSatisfiedByFunc(recentSpec)(nil)
		assert.Error(t, err)
	})

	t.Run("custom specification concept", func(t *testing.T) {
		activeSpec := {{.DomainName}}.NewActiveSpecification()
		
		// Test that active user satisfies active spec
		result := activeSpec.IsSatisfiedBy(recentUser)
		assert.True(t, result)
		
		// Test that recent user would satisfy the recent spec
		result = satisfiedByFunc(recentSpec)(recentUser)
		assert.True(t, result)
	})
}

func TestSpecificationWithNilHandling(t *testing.T) {
	specifications := []{{.DomainName}}.Specification{
		{{.DomainName}}.NewActiveSpecification(),
		{{.DomainName}}.NewValidNameSpecification(),
		{{.DomainName}}.NewNamePatternSpecification([]string{"Test User"}),
		{{.DomainName}}.NewCanBeUpdatedSpecification(),
		{{.DomainName}}.NewCanBeDeletedSpecification(),
	}

	for i, spec := range specifications {
		t.Run("specification_handles_nil", func(t *testing.T) {
			// All specifications should handle nil gracefully
			result := spec.IsSatisfiedBy(nil)
			assert.False(t, result)

			err := spec.WhyNotSatisfiedBy(nil)
			assert.Error(t, err)
		})
		_ = i // Use i to avoid unused variable error
	}
}

