func TestUserFactoryTestUser(t *testing.T) {
	tests := []struct {
		name      string
		overrides {{.DomainName}}.TestOverrides
		wantErr   bool
	}{
		{
			name: "create test user with defaults",
			overrides: {{.DomainName}}.TestOverrides{
				SkipUniquenessCheck: true,
				DisableAudit:        true,
			},
			wantErr: false,
		},
		{
			name: "create test user with custom data",
			overrides: {{.DomainName}}.TestOverrides{
				Name:                "Custom Test User",
				Email:               "custom.test@example.com",
				Description:         "Custom test description",
				SkipUniquenessCheck: true,
				DisableAudit:        true,
			},
			wantErr: false,
		},
		{
			name: "create test user forced inactive",
			overrides: {{.DomainName}}.TestOverrides{
				ForceInactive:       true,
				SkipUniquenessCheck: true,
				DisableAudit:        true,
			},
			wantErr: false,
		},
		{
			name: "create test user with uniqueness check",
			overrides: {{.DomainName}}.TestOverrides{
				Email:               "unique.test@example.com",
				SkipUniquenessCheck: false,
				DisableAudit:        true,
			},
			wantErr: false,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			// Setup mocks
			mockUniqueness := new(Mock{{.DomainName | title}}UniquenessChecker)
			mockValidator := new(MockDomainValidator)
			mockAuditLogger := new(MockAuditLogger)

			// Setup expectations
			if !tt.overrides.SkipUniquenessCheck {
				expectedEmail := tt.overrides.Email
				if expectedEmail == "" {
					// Factory will generate an email
					mockUniqueness.On("EmailExists", mock.AnythingOfType("string")).Return(false, nil)
				} else {
					mockUniqueness.On("EmailExists", expectedEmail).Return(false, nil)
				}
			}

			if !tt.overrides.DisableAudit {
				mockAuditLogger.On("LogUserCreation", mock.AnythingOfType("valueobjects.ID"), "test", mock.AnythingOfType("string")).Return()
			}

			// Create factory
			factory := {{.DomainName}}.New{{.DomainName | title}}Factory(mockUniqueness, mockValidator, mockAuditLogger)

			// Execute
			user, err := factory.CreateTest{{.DomainName | title}}(tt.overrides)

			// Assert
			if tt.wantErr {
				assert.Error(t, err)
				assert.Nil(t, user)
			} else {
				assert.NoError(t, err)
				require.NotNil(t, user)

				// Verify custom data was applied
				if tt.overrides.Name != "" {
					assert.Equal(t, tt.overrides.Name, user.Name().Value())
				} else {
					assert.NotEmpty(t, user.Name().Value())
				}

				if tt.overrides.Email != "" {
					assert.Equal(t, tt.overrides.Email, user.Email().Value())
				} else {
					assert.NotEmpty(t, user.Email().Value())
				}

				if tt.overrides.Description != "" {
					assert.Equal(t, tt.overrides.Description, user.Description().Value())
				} else {
					assert.NotEmpty(t, user.Description().Value())
				}

				// Verify forced inactive status
				if tt.overrides.ForceInactive {
					assert.True(t, user.IsInactive())
				} else {
					assert.True(t, user.IsActive())
				}

				// Verify domain events
				events := user.DomainEvents()
				if tt.overrides.ForceInactive {
					// Should have creation event + deactivation event
					assert.GreaterOrEqual(t, len(events), 1)
				} else {
					assert.Len(t, events, 1)
					assert.Equal(t, {{.DomainName}}.{{.DomainName | title}}CreatedEventType, events[0].EventType())
				}
			}

			// Verify mock calls
			if !tt.overrides.SkipUniquenessCheck {
				mockUniqueness.AssertExpectations(t)
			}
			if !tt.overrides.DisableAudit {
				mockAuditLogger.AssertExpectations(t)
			}
		})
	}
}

func TestFactoryBusinessRuleApplication(t *testing.T) {
	t.Run("email normalization", func(t *testing.T) {
		mockUniqueness := new(Mock{{.DomainName | title}}UniquenessChecker)
		mockValidator := new(MockDomainValidator)
		mockAuditLogger := new(MockAuditLogger)

		// Setup expectations for normalized email
		normalizedEmail := "test@example.com"
		mockUniqueness.On("EmailExists", normalizedEmail).Return(false, nil)
		mockAuditLogger.On("LogUserCreation", mock.AnythingOfType("valueobjects.ID"), "registration", normalizedEmail).Return()
		mockValidator.On("ValidateRegistration", mock.AnythingOfType("{{.DomainName}}.RegistrationData")).Return(nil)

		factory := {{.DomainName}}.New{{.DomainName | title}}Factory(mockUniqueness, mockValidator, mockAuditLogger)

		// Test with email that needs normalization
		registrationData := {{.DomainName}}.RegistrationData{
			Name:        "Test User",
			Email:       "  TEST@EXAMPLE.COM  ", // Should be normalized
			Description: "Test description",
			Password:    "password",
		}

		user, err := factory.Create{{.DomainName | title}}FromRegistration(registrationData)

		assert.NoError(t, err)
		require.NotNil(t, user)
		
		// Email should be normalized
		assert.Equal(t, normalizedEmail, user.Email().Value())

		mockUniqueness.AssertExpectations(t)
		mockAuditLogger.AssertExpectations(t)
		mockValidator.AssertExpectations(t)
	})
}