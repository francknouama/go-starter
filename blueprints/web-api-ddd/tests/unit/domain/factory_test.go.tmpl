func TestUserFactoryRegistration(t *testing.T) {
	tests := []struct {
		name           string
		registrationData {{.DomainName}}.RegistrationData
		emailExists    bool
		emailExistsErr error
		validationErr  error
		wantErr        bool
		errContains    string
		expectAuditLog bool
	}{
		{
			name: "successful registration with personal email",
			registrationData: {{.DomainName}}.RegistrationData{
				Name:        "John Doe",
				Email:       "john.doe@gmail.com",
				Description: "Software developer",
				Password:    "securepassword",
				IPAddress:   "192.168.1.1",
				UserAgent:   "Mozilla/5.0...",
			},
			emailExists:    false,
			emailExistsErr: nil,
			validationErr:  nil,
			wantErr:        false,
			expectAuditLog: true,
		},
		{
			name: "successful registration with business email",
			registrationData: {{.DomainName}}.RegistrationData{
				Name:        "Jane Smith",
				Email:       "jane.smith@company.com",
				Description: "Product manager",
				Password:    "securepassword",
				IPAddress:   "192.168.1.2",
				UserAgent:   "Mozilla/5.0...",
			},
			emailExists:    false,
			emailExistsErr: nil,
			validationErr:  nil,
			wantErr:        false,
			expectAuditLog: true,
		},
		{
			name: "registration fails when email exists",
			registrationData: {{.DomainName}}.RegistrationData{
				Name:        "Existing User",
				Email:       "existing@example.com",
				Description: "Test user",
				Password:    "password",
				IPAddress:   "192.168.1.3",
				UserAgent:   "Test Agent",
			},
			emailExists:    true,
			emailExistsErr: nil,
			validationErr:  nil,
			wantErr:        true,
			errContains:    "email already exists",
			expectAuditLog: false,
		},
		{
			name: "registration fails with invalid email",
			registrationData: {{.DomainName}}.RegistrationData{
				Name:        "Test User",
				Email:       "",
				Description: "Test description",
				Password:    "password",
				IPAddress:   "192.168.1.4",
				UserAgent:   "Test Agent",
			},
			emailExists:    false,
			emailExistsErr: nil,
			validationErr:  nil,
			wantErr:        true,
			errContains:    "invalid registration data",
			expectAuditLog: false,
		},
		{
			name: "registration fails with invalid name",
			registrationData: {{.DomainName}}.RegistrationData{
				Name:        "",
				Email:       "test@example.com",
				Description: "Test description",
				Password:    "password",
				IPAddress:   "192.168.1.5",
				UserAgent:   "Test Agent",
			},
			emailExists:    false,
			emailExistsErr: nil,
			validationErr:  nil,
			wantErr:        true,
			errContains:    "invalid registration data",
			expectAuditLog: false,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			// Setup mocks
			mockUniqueness := new(Mock{{.DomainName | title}}UniquenessChecker)
			mockValidator := new(MockDomainValidator)
			mockAuditLogger := new(MockAuditLogger)

			// Setup expectations
			if tt.registrationData.Email != "" {
				mockUniqueness.On("EmailExists", tt.registrationData.Email).Return(tt.emailExists, tt.emailExistsErr)
			}

			if tt.validationErr != nil {
				mockValidator.On("ValidateRegistration", tt.registrationData).Return(tt.validationErr)
			} else if tt.registrationData.Email != "" && tt.registrationData.Name != "" {
				mockValidator.On("ValidateRegistration", tt.registrationData).Return(nil)
			}

			if tt.expectAuditLog {
				mockAuditLogger.On("LogUserCreation", mock.AnythingOfType("valueobjects.ID"), "registration", tt.registrationData.Email).Return()
			}

			// Create factory
			factory := {{.DomainName}}.New{{.DomainName | title}}Factory(mockUniqueness, mockValidator, mockAuditLogger)

			// Execute
			user, err := factory.Create{{.DomainName | title}}FromRegistration(tt.registrationData)

			// Assert
			if tt.wantErr {
				assert.Error(t, err)
				if tt.errContains != "" {
					assert.Contains(t, err.Error(), tt.errContains)
				}
				assert.Nil(t, user)
			} else {
				assert.NoError(t, err)
				require.NotNil(t, user)

				// Verify user properties
				assert.Equal(t, tt.registrationData.Name, user.Name().Value())
				assert.Equal(t, tt.registrationData.Email, user.Email().Value())
				assert.Equal(t, tt.registrationData.Description, user.Description().Value())
				assert.Equal(t, {{.DomainName}}.StatusActive, user.Status())

				// Verify business email preferences
				email, _ := {{.DomainName}}.NewEmailAddress(tt.registrationData.Email)
				if email.IsBusinessEmail() {
					// Business users should have different defaults
					assert.True(t, user.Preferences().GetPrivacyPreferences().ProfilePublic)
				} else {
					// Personal users should have private profiles by default
					assert.False(t, user.Preferences().GetPrivacyPreferences().ProfilePublic)
				}

				// Verify domain events
				events := user.DomainEvents()
				assert.Len(t, events, 1)
				assert.Equal(t, {{.DomainName}}.{{.DomainName | title}}CreatedEventType, events[0].EventType())
			}

			// Verify mock calls
			mockUniqueness.AssertExpectations(t)
			mockValidator.AssertExpectations(t)
			mockAuditLogger.AssertExpectations(t)
		})
	}
}

func TestUserFactorySocialAuth(t *testing.T) {
	tests := []struct {
		name         string
		socialData   {{.DomainName}}.SocialAuthData
		emailExists  bool
		wantErr      bool
		errContains  string
	}{
		{
			name: "successful Google social auth",
			socialData: {{.DomainName}}.SocialAuthData{
				Provider:   "google",
				ProviderID: "google-123456",
				Name:       "John Doe",
				Email:      "john.doe@gmail.com",
				Bio:        "Software developer from California",
				Avatar:     "https://avatar.url/image.jpg",
			},
			emailExists: false,
			wantErr:     false,
		},
		{
			name: "successful GitHub social auth",
			socialData: {{.DomainName}}.SocialAuthData{
				Provider:   "github",
				ProviderID: "github-789012",
				Name:       "jane-dev",
				Email:      "jane@company.com",
				Bio:        "Full-stack developer",
				Avatar:     "https://github.com/avatar.jpg",
			},
			emailExists: false,
			wantErr:     false,
		},
		{
			name: "social auth fails when email exists",
			socialData: {{.DomainName}}.SocialAuthData{
				Provider:   "google",
				ProviderID: "google-existing",
				Name:       "Existing User",
				Email:      "existing@example.com",
				Bio:        "Test user",
			},
			emailExists: true,
			wantErr:     true,
			errContains: "user already exists",
		},
		{
			name: "social auth fails with unsupported provider",
			socialData: {{.DomainName}}.SocialAuthData{
				Provider:   "unsupported",
				ProviderID: "unsupported-123",
				Name:       "Test User",
				Email:      "test@example.com",
				Bio:        "Test user",
			},
			emailExists: false,
			wantErr:     true,
			errContains: "invalid social auth data",
		},
		{
			name: "social auth with empty name generates from email",
			socialData: {{.DomainName}}.SocialAuthData{
				Provider:   "google",
				ProviderID: "google-noname",
				Name:       "", // Empty name
				Email:      "testuser@example.com",
				Bio:        "Test user with no name",
			},
			emailExists: false,
			wantErr:     false,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			// Setup mocks
			mockUniqueness := new(Mock{{.DomainName | title}}UniquenessChecker)
			mockValidator := new(MockDomainValidator)
			mockAuditLogger := new(MockAuditLogger)

			// Setup expectations
			if tt.socialData.Email != "" && tt.socialData.Provider != "unsupported" {
				mockUniqueness.On("EmailExists", tt.socialData.Email).Return(tt.emailExists, nil)
			}

			if !tt.wantErr {
				expectedMethod := "social_auth_" + tt.socialData.Provider
				mockAuditLogger.On("LogUserCreation", mock.AnythingOfType("valueobjects.ID"), expectedMethod, tt.socialData.Email).Return()
			}

			// Create factory
			factory := {{.DomainName}}.New{{.DomainName | title}}Factory(mockUniqueness, mockValidator, mockAuditLogger)

			// Execute
			user, err := factory.Create{{.DomainName | title}}FromSocialAuth(tt.socialData)

			// Assert
			if tt.wantErr {
				assert.Error(t, err)
				if tt.errContains != "" {
					assert.Contains(t, err.Error(), tt.errContains)
				}
				assert.Nil(t, user)
			} else {
				assert.NoError(t, err)
				require.NotNil(t, user)

				// Verify user properties
				assert.Equal(t, tt.socialData.Email, user.Email().Value())
				assert.Equal(t, {{.DomainName}}.StatusActive, user.Status())

				// Name should be set (either from social data or generated)
				if tt.socialData.Name != "" {
					assert.Equal(t, tt.socialData.Name, user.Name().Value())
				} else {
					assert.NotEmpty(t, user.Name().Value())
				}

				// Description should be set from bio or generated
				assert.NotEmpty(t, user.Description().Value())

				// Verify domain events
				events := user.DomainEvents()
				assert.Len(t, events, 1)
				assert.Equal(t, {{.DomainName}}.{{.DomainName | title}}CreatedEventType, events[0].EventType())
			}

			// Verify mock calls
			mockUniqueness.AssertExpectations(t)
			mockAuditLogger.AssertExpectations(t)
		})
	}
}

func TestUserFactoryImport(t *testing.T) {
	originalTime := time.Now().UTC().Add(-30 * 24 * time.Hour) // 30 days ago

	tests := []struct {
