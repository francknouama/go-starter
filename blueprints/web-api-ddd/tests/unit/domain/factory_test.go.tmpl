				Name:              "Imported User",
				Email:             "imported@legacy-system.com",
				Description:       "User imported from legacy system",
				Source:            "legacy_system_v1",
				BatchID:           "batch_20240101_001",
				OriginalCreatedAt: &originalTime,
				OriginalUpdatedAt: &originalTime,
