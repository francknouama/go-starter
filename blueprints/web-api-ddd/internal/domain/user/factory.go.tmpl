// Private validation methods

func (f *{{.DomainName}}Factory) validateRegistrationData(data RegistrationData) error {
	if data.Email == "" {
		return errors.ErrInvalidInput.WithDetails("field", "email")
	}
	
	if data.Name == "" {
		return errors.ErrInvalidInput.WithDetails("field", "name")
	}
	
	// Additional business validations
	if f.domainValidator != nil {
		if err := f.domainValidator.ValidateRegistration(data); err != nil {
			return err
		}
	}
	
	return nil
}

func (f *{{.DomainName}}Factory) validateSocialAuthData(data SocialAuthData) error {
	if data.Provider == "" {
		return errors.ErrInvalidInput.WithDetails("field", "provider")
	}
	
	if data.ProviderID == "" {
		return errors.ErrInvalidInput.WithDetails("field", "providerID")
	}
	
	if data.Email == "" {
		return errors.ErrInvalidInput.WithDetails("field", "email")
	}
	
	// Validate provider is supported
	supportedProviders := []string{"google", "facebook", "github", "linkedin", "microsoft"}
	isSupported := false
	for _, provider := range supportedProviders {
		if data.Provider == provider {
			isSupported = true
			break
		}
	}
	
	if !isSupported {
		return errors.ErrInvalidInput.WithDetails("field", "provider").WithDetails("value", data.Provider)
	}
	
	return nil
}

