// Create{{.DomainName | title}}FromRegistration creates a user from standard registration
func (f *{{.DomainName}}Factory) Create{{.DomainName | title}}FromRegistration(data RegistrationData) (*{{.DomainName | title}}Aggregate, error) {
	// Validate registration data
	if err := f.validateRegistrationData(data); err != nil {
		return nil, fmt.Errorf("invalid registration data: %w", err)
	}
	
	// Check email uniqueness
	if exists, err := f.uniquenessChecker.EmailExists(data.Email); err != nil {
		return nil, fmt.Errorf("failed to check email uniqueness: %w", err)
	} else if exists {
		return nil, errors.ErrBusinessRuleViolation.WithDetails("reason", "email already exists")
	}
	
	// Apply business rules for registration
	processedData := f.applyRegistrationBusinessRules(data)
	
	// Create the aggregate
	aggregate, err := New{{.DomainName | title}}Aggregate(
		processedData.Name,
		processedData.Email,
		processedData.Description,
	)
	if err != nil {
		return nil, fmt.Errorf("failed to create {{.DomainName}} aggregate: %w", err)
	}
	
	// Apply registration-specific initialization
	f.initializeRegistrationDefaults(aggregate, processedData)
	
	// Log the creation for audit
	f.auditLogger.LogUserCreation(aggregate.ID(), "registration", data.Email)
	
	return aggregate, nil
}

