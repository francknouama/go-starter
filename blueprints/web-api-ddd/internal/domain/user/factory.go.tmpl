// Private business rule application methods

func (f *{{.DomainName}}Factory) applyRegistrationBusinessRules(data RegistrationData) ProcessedRegistrationData {
	processed := ProcessedRegistrationData{
		Name:        data.Name,
		Email:       data.Email,
		Description: data.Description,
	}
	
	// Business rule: Clean and normalize name
	processed.Name = f.normalizeDisplayName(data.Name)
	
	// Business rule: Normalize email to lowercase
	processed.Email = normalizeEmail(data.Email)
	
	// Business rule: Generate description if empty but welcome
	if processed.Description == "" {
		processed.Description = f.generateWelcomeDescription(data.Name)
	}
	
	return processed
}

func (f *{{.DomainName}}Factory) applySocialAuthBusinessRules(data SocialAuthData) ProcessedSocialAuthData {
	processed := ProcessedSocialAuthData{
		Name:        data.Name,
		Email:       data.Email,
		Description: data.Bio,
		Provider:    data.Provider,
		ProviderID:  data.ProviderID,
		Avatar:      data.Avatar,
	}
	
	// Business rule: Use display name from social provider
	if processed.Name == "" {
		processed.Name = f.generateNameFromEmail(data.Email)
	}
	
	// Business rule: Normalize email
	processed.Email = normalizeEmail(data.Email)
	
	// Business rule: Generate description from social bio
	if processed.Description == "" && data.Bio != "" {
		processed.Description = f.normalizeBioToDescription(data.Bio)
	} else if processed.Description == "" {
		processed.Description = f.generateSocialWelcomeDescription(data.Provider)
	}
	
	return processed
}

func (f *{{.DomainName}}Factory) applyImportBusinessRules(data ImportData) ProcessedImportData {
	processed := ProcessedImportData{
		Name:                data.Name,
		Email:               data.Email,
		Description:         data.Description,
		OriginalCreatedAt:   data.OriginalCreatedAt,
		OriginalUpdatedAt:   data.OriginalUpdatedAt,
		ImportSource:        data.Source,
		ImportBatch:         data.BatchID,
	}
	
	// Business rule: Generate name if missing
	if processed.Name == "" {
		processed.Name = f.generateNameFromEmail(data.Email)
	}
	
	// Business rule: Normalize email
	processed.Email = normalizeEmail(data.Email)
	
	// Business rule: Generate description for imported users
	if processed.Description == "" {
		processed.Description = f.generateImportDescription(data.Source)
	}
	
	return processed
}

