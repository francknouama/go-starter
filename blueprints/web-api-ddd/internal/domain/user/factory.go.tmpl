}

// ProcessedRegistrationData represents processed registration data
type ProcessedRegistrationData struct {
	Name        string
	Email       string
	Description string
}

// SocialAuthData represents data from social authentication
type SocialAuthData struct {
	Provider    string // google, facebook, github, etc.
	ProviderID  string // Provider's user ID
	Name        string
	Email       string
	Bio         string
	Avatar      string
	AccessToken string // Not stored in aggregate
}

// ProcessedSocialAuthData represents processed social auth data
type ProcessedSocialAuthData struct {
	Name        string
	Email       string
	Description string
	Provider    string
	ProviderID  string
	Avatar      string
}

// ImportData represents data from import operations
type ImportData struct {
	Name              string
	Email             string
	Description       string
	Source            string     // Source system name
	BatchID           string     // Import batch identifier
	OriginalCreatedAt *time.Time // Original creation timestamp
	OriginalUpdatedAt *time.Time // Original update timestamp
}

// ProcessedImportData represents processed import data
type ProcessedImportData struct {
	Name              string
	Email             string
	Description       string
	ImportSource      string
	ImportBatch       string
