// Supporting types for repository operations

// PaginationSpec defines pagination parameters
type PaginationSpec struct {
	Limit  int    `json:"limit"`
	Offset int    `json:"offset"`
	SortBy string `json:"sort_by,omitempty"`
	Order  string `json:"order,omitempty"` // ASC or DESC
}

// NewPaginationSpec creates a new pagination specification
func NewPaginationSpec(limit, offset int, sortBy, order string) PaginationSpec {
	// Apply sensible defaults
	if limit <= 0 || limit > 1000 {
		limit = 50 // Default page size
	}
	if offset < 0 {
		offset = 0
	}
	if order != "ASC" && order != "DESC" {
		order = "DESC" // Default to newest first
	}
	if sortBy == "" {
		sortBy = "created_at"
	}
	
	return PaginationSpec{
		Limit:  limit,
		Offset: offset,
		SortBy: sortBy,
		Order:  order,
	}
}

