// Business rule methods

// CanPerformAction checks if user can perform a specific action
func (a *{{.DomainName | title}}Aggregate) CanPerformAction(action string) bool {
	if a.status == StatusDeleted {
		return false
	}
	
	if a.status == StatusInactive {
		// Inactive users can only perform limited actions
		allowedActions := []string{"login", "activate", "view_profile"}
		for _, allowed := range allowedActions {
			if action == allowed {
				return true
			}
		}
		return false
	}
	
	return true // Active users can perform most actions
}

// GetEngagementLevel returns the user's engagement level
func (a *{{.DomainName | title}}Aggregate) GetEngagementLevel() string {
	if a.lastLoginAt == nil {
		return "new"
	}
	
	daysSinceLogin := time.Since(*a.lastLoginAt).Hours() / 24
	
	switch {
	case daysSinceLogin <= 1:
		return "highly_active"
	case daysSinceLogin <= 7:
		return "active"
	case daysSinceLogin <= 30:
		return "somewhat_active"
	case daysSinceLogin <= 90:
		return "dormant"
	default:
		return "inactive"
	}
}

