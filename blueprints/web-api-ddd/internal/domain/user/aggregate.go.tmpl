// ChangeHistory tracks changes for business rule enforcement
type ChangeHistory struct {
	lastNameChange  *time.Time
	lastEmailChange *time.Time
	changeCount     int
}

// NewChangeHistory creates a new change history
func NewChangeHistory() *ChangeHistory {
	return &ChangeHistory{
		lastNameChange:  nil,
		lastEmailChange: nil,
		changeCount:     0,
	}
}

// RecordNameChange records a name change
func (ch *ChangeHistory) RecordNameChange(timestamp time.Time) {
	ch.lastNameChange = &timestamp
	ch.changeCount++
}

// RecordEmailChange records an email change
func (ch *ChangeHistory) RecordEmailChange(timestamp time.Time) {
	ch.lastEmailChange = &timestamp
	ch.changeCount++
}

// HasRecentNameChange checks if name was changed recently
func (ch *ChangeHistory) HasRecentNameChange() bool {
	if ch.lastNameChange == nil {
		return false
	}
	return time.Since(*ch.lastNameChange) < 30*24*time.Hour // 30 days
}

// HasRecentEmailChange checks if email was changed recently
func (ch *ChangeHistory) HasRecentEmailChange() bool {
	if ch.lastEmailChange == nil {
		return false
	}
	return time.Since(*ch.lastEmailChange) < 7*24*time.Hour // 7 days
}

// GetChangeCount returns the total number of changes
func (ch *ChangeHistory) GetChangeCount() int {
	return ch.changeCount
}