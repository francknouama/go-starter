// AggregateRoot defines the base behavior for all aggregate roots
type AggregateRoot interface {
	ID() valueobjects.ID
	Version() int
	DomainEvents() []events.DomainEvent
	ClearDomainEvents()
	MarkEventsAsCommitted()
}

// BaseAggregate provides base functionality for aggregate roots
type BaseAggregate struct {
	id           valueobjects.ID
	version      int
	domainEvents []events.DomainEvent
	uncommittedEventCount int
}

// NewBaseAggregate creates a new base aggregate
func NewBaseAggregate(id valueobjects.ID) BaseAggregate {
	return BaseAggregate{
		id:           id,
		version:      1,
		domainEvents: make([]events.DomainEvent, 0),
		uncommittedEventCount: 0,
	}
}

// ID returns the aggregate ID
func (a *BaseAggregate) ID() valueobjects.ID {
	return a.id
}

// Version returns the aggregate version for optimistic locking
func (a *BaseAggregate) Version() int {
	return a.version
}

// IncrementVersion increments the version for optimistic locking
func (a *BaseAggregate) IncrementVersion() {
	a.version++
}

// DomainEvents returns uncommitted domain events
func (a *BaseAggregate) DomainEvents() []events.DomainEvent {
	return a.domainEvents
}

// UncommittedEvents returns only uncommitted events
func (a *BaseAggregate) UncommittedEvents() []events.DomainEvent {
	if a.uncommittedEventCount == 0 {
		return make([]events.DomainEvent, 0)
	}
	
	startIndex := len(a.domainEvents) - a.uncommittedEventCount
	return a.domainEvents[startIndex:]
}

// ClearDomainEvents clears all domain events
func (a *BaseAggregate) ClearDomainEvents() {
	a.domainEvents = make([]events.DomainEvent, 0)
	a.uncommittedEventCount = 0
}

// MarkEventsAsCommitted marks current events as committed
func (a *BaseAggregate) MarkEventsAsCommitted() {
	a.uncommittedEventCount = 0
}

// AddDomainEvent adds a domain event to the aggregate
func (a *BaseAggregate) AddDomainEvent(event events.DomainEvent) {
	a.domainEvents = append(a.domainEvents, event)
	a.uncommittedEventCount++
}

// HasUncommittedEvents returns true if there are uncommitted events
func (a *BaseAggregate) HasUncommittedEvents() bool {
	return a.uncommittedEventCount > 0
}

// GetUncommittedEventCount returns the number of uncommitted events
func (a *BaseAggregate) GetUncommittedEventCount() int {
	return a.uncommittedEventCount
}

// {{.DomainName | title}}Aggregate represents the {{.DomainName}} aggregate root with strict boundaries
type {{.DomainName | title}}Aggregate struct {
	BaseAggregate
	
	// Core identity and state
	name         UserName        
	email        EmailAddress    
	description  UserDescription 
	status       Status          
	
	// Rich objects with behavior
	profile      UserProfile     
	preferences  UserPreferences 
	
	// Audit information
	createdAt    time.Time
	updatedAt    time.Time
	lastLoginAt  *time.Time
	
	// Business invariants
	changeHistory *ChangeHistory
}

// New{{.DomainName | title}}Aggregate creates a new {{.DomainName}} aggregate with business validation
func New{{.DomainName | title}}Aggregate(nameStr string, emailStr string, descriptionStr string) (*{{.DomainName | title}}Aggregate, error) {
	// Create aggregate ID first
	aggregateID := valueobjects.GenerateID()
	
	// Create rich value objects with built-in validation
	name, err := NewUserName(nameStr)
	if err != nil {
		return nil, fmt.Errorf("invalid name: %w", err)
	}
	
	email, err := NewEmailAddress(emailStr)
	if err != nil {
		return nil, fmt.Errorf("invalid email: %w", err)
	}
	
	description, err := NewUserDescription(descriptionStr)
	if err != nil {
		return nil, fmt.Errorf("invalid description: %w", err)
	}
	
	// Business rule: Email must be unique (enforced by repository)
	// Business rule: Professional emails get different default settings
	defaultPreferences := NewDefaultUserPreferences()
	if email.IsBusinessEmail() {
		defaultPreferences = NewBusinessUserPreferences()
	}
	
	now := time.Now().UTC()
	
	aggregate := &{{.DomainName | title}}Aggregate{
		BaseAggregate: NewBaseAggregate(aggregateID),
		name:         name,
		email:        email,
		description:  description,
		status:       StatusActive,
		profile:      NewUserProfile(email.GetProviderType()),
		preferences:  defaultPreferences,
		createdAt:    now,
		updatedAt:    now,
		lastLoginAt:  nil,
		changeHistory: NewChangeHistory(),
	}
	
	// Raise domain event with rich information
	event := New{{.DomainName | title}}CreatedEvent(
		aggregate.id, 
		aggregate.name.Value(),
		aggregate.email.Value(),
		aggregate.email.GetProviderType(),
	)
	aggregate.AddDomainEvent(event)
	
	return aggregate, nil
}

// Reconstruct{{.DomainName | title}}Aggregate reconstructs an aggregate from persistence
func Reconstruct{{.DomainName | title}}Aggregate(
	id valueobjects.ID,
	name string,
	email string,
	description string,
	status Status,
	createdAt, updatedAt time.Time,
	lastLoginAt *time.Time,
	version int,
) (*{{.DomainName | title}}Aggregate, error) {
	
	// Validate and create value objects
	userName, err := NewUserName(name)
	if err != nil {
		return nil, fmt.Errorf("invalid name during reconstruction: %w", err)
	}
	
	userEmail, err := NewEmailAddress(email)
	if err != nil {
		return nil, fmt.Errorf("invalid email during reconstruction: %w", err)
	}
	
	userDesc, err := NewUserDescription(description)
	if err != nil {
		return nil, fmt.Errorf("invalid description during reconstruction: %w", err)
	}
	
	baseAggregate := NewBaseAggregate(id)
	baseAggregate.version = version
	
	aggregate := &{{.DomainName | title}}Aggregate{
		BaseAggregate: baseAggregate,
		name:         userName,
		email:        userEmail,
		description:  userDesc,
		status:       status,
		profile:      NewUserProfile(userEmail.GetProviderType()),
		preferences:  NewDefaultUserPreferences(),
		createdAt:    createdAt,
		updatedAt:    updatedAt,
		lastLoginAt:  lastLoginAt,
		changeHistory: NewChangeHistory(), // Could be loaded from event store
	}
	
	// Apply business preferences based on email type
	if userEmail.IsBusinessEmail() {
		aggregate.preferences = NewBusinessUserPreferences()
	}
	
	return aggregate, nil
}

