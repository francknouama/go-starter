// Business behavior methods

// ChangeEmail changes the user's email with strict business rules
func (a *{{.DomainName | title}}Aggregate) ChangeEmail(newEmailStr string, verificationToken string) error {
	// Business invariant: Cannot change email if deleted
	if a.status == StatusDeleted {
		return errors.ErrInvalidEntityState.WithDetails("reason", "cannot change email of deleted user")
	}
	
	// Business invariant: Cannot change email too frequently  
	if a.changeHistory.HasRecentEmailChange() {
		return errors.ErrBusinessRuleViolation.WithDetails("reason", "email can only be changed once per week")
	}
	
	newEmail, err := NewEmailAddress(newEmailStr)
	if err != nil {
		return fmt.Errorf("invalid new email: %w", err)
	}
	
	// Business rule: No change if same email
	if a.email.Equals(newEmail) {
		return nil
	}
	
	// Business rule: Verification required for email changes (simplified here)
	if verificationToken == "" {
		return errors.ErrBusinessRuleViolation.WithDetails("reason", "email verification required")
	}
	
	oldEmail := a.email.Value()
	a.email = newEmail
	a.updatedAt = time.Now().UTC()
	a.IncrementVersion()
	
	// Update preferences if switching between business/personal
	oldEmailObj, _ := NewEmailAddress(oldEmail)
	if oldEmailObj.IsBusinessEmail() != newEmail.IsBusinessEmail() {
		if newEmail.IsBusinessEmail() {
			a.preferences = a.preferences.ToBusinessDefaults()
		} else {
			a.preferences = a.preferences.ToPersonalDefaults()
		}
	}
	
	// Record the change
	a.changeHistory.RecordEmailChange(time.Now().UTC())
	
	// Raise domain event
	event := New{{.DomainName | title}}EmailChangedEvent(a.id, oldEmail, newEmail.Value(), newEmail.GetProviderType())
	a.AddDomainEvent(event)
	
	return nil
}

// ChangeName changes the user's name with business validation
func (a *{{.DomainName | title}}Aggregate) ChangeName(newNameStr string) error {
	// Business invariant: Cannot change name if deleted
	if a.status == StatusDeleted {
		return errors.ErrInvalidEntityState.WithDetails("reason", "cannot change name of deleted user")
	}
	
	// Business invariant: Cannot change name too frequently
	if a.changeHistory.HasRecentNameChange() {
		return errors.ErrBusinessRuleViolation.WithDetails("reason", "name can only be changed once per month")
	}
	
	newName, err := NewUserName(newNameStr)
	if err != nil {
		return fmt.Errorf("invalid new name: %w", err)
	}
	
	// Business rule: No change if same name
	if a.name.Equals(newName) {
		return nil
	}
	
	oldName := a.name.Value()
	a.name = newName
	a.updatedAt = time.Now().UTC()
	a.IncrementVersion()
	
	// Update profile with name change
	a.profile = a.profile.WithNameChange()
	
	// Record the change
	a.changeHistory.RecordNameChange(time.Now().UTC())
	
	// Raise domain event
	event := New{{.DomainName | title}}NameChangedEvent(a.id, oldName, newName.Value())
	a.AddDomainEvent(event)
	
	return nil
}

// Activate activates the user account
func (a *{{.DomainName | title}}Aggregate) Activate() error {
	if a.status == StatusActive {
		return nil // Already active
	}
	
	if a.status == StatusDeleted {
		return errors.ErrInvalidEntityState.WithDetails("reason", "cannot activate deleted user")
	}
	
	oldStatus := a.status
	a.status = StatusActive
	a.updatedAt = time.Now().UTC()
	a.IncrementVersion()
	
	// Raise domain event
	event := New{{.DomainName | title}}StatusChangedEvent(a.id, oldStatus, StatusActive)
	a.AddDomainEvent(event)
	
	return nil
}

// Deactivate deactivates the user account
func (a *{{.DomainName | title}}Aggregate) Deactivate(reason string) error {
	if a.status == StatusInactive {
		return nil // Already inactive
	}
	
	if a.status == StatusDeleted {
		return errors.ErrInvalidEntityState.WithDetails("reason", "cannot deactivate deleted user")
	}
	
	oldStatus := a.status
	a.status = StatusInactive
	a.updatedAt = time.Now().UTC()
	a.IncrementVersion()
	
	// Raise domain event with reason
	event := New{{.DomainName | title}}DeactivatedEvent(a.id, reason)
	a.AddDomainEvent(event)
	
	return nil
}

// Delete marks the user as deleted (soft delete)
func (a *{{.DomainName | title}}Aggregate) Delete(reason string) error {
	if a.status == StatusDeleted {
		return nil // Already deleted
	}
	
	oldStatus := a.status
	a.status = StatusDeleted
	a.updatedAt = time.Now().UTC()
	a.IncrementVersion()
	
	// Clear sensitive data (GDPR compliance)
	a.clearSensitiveData()
	
	// Raise domain event with reason
	event := New{{.DomainName | title}}DeletedEvent(a.id, reason)
	a.AddDomainEvent(event)
	
	return nil
}

// RecordLogin records a successful login with business logic
func (a *{{.DomainName | title}}Aggregate) RecordLogin(loginContext LoginContext) error {
	// Business invariant: Cannot login if deleted or inactive
	if a.status == StatusDeleted {
		return errors.ErrInvalidEntityState.WithDetails("reason", "deleted user cannot login")
	}
	
	if a.status == StatusInactive {
		return errors.ErrInvalidEntityState.WithDetails("reason", "inactive user cannot login")
	}
	
	now := time.Now().UTC()
	a.lastLoginAt = &now
	a.updatedAt = now
	
	// Update profile with login activity
	a.profile = a.profile.WithLoginActivity()
	
	// Raise domain event with context
	event := New{{.DomainName | title}}LoggedInEvent(a.id, a.email.Value(), now, loginContext)
	a.AddDomainEvent(event)
	
	return nil
}

