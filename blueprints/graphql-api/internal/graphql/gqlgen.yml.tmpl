# gqlgen configuration for {{.ProjectName}}

# Where are all the schema files located?
schema:
  - internal/graphql/*.graphql

# Where should the generated server code go?
exec:
  filename: internal/graphql/generated/generated.go
  package: generated

# Where should any generated models go?
model:
  filename: internal/graphql/generated/models_gen.go
  package: generated

# Where should the resolver implementations go?
resolver:
  layout: follow-schema
  dir: internal/graphql/resolvers
  package: resolvers

# Optional: set to true to use []Thing instead of []*Thing for slices
omit_slice_element_pointers: false

# Optional: set to true to use struct tags in the generated models
struct_tag: json

# Optional: set to true to generate resolver method stubs for fields as well as types
field_resolvers: true

# Optional: set to skip generation of specified fields
skip_validation: false

# Optional: set to not generate runtime type assertions
skip_runtime: false

# gqlgen will search for any type names in the schema in these go packages
# if they match it will use them, otherwise it will generate them.
autobind:
  - "{{.ModulePath}}/internal/graphql/models"

# This section declares type mapping between the GraphQL and Go type systems
models:
  ID:
    model:
      - github.com/99designs/gqlgen/graphql.ID
      - github.com/99designs/gqlgen/graphql.Int
      - github.com/99designs/gqlgen/graphql.Int64
      - github.com/99designs/gqlgen/graphql.Int32
  Int:
    model:
      - github.com/99designs/gqlgen/graphql.Int
      - github.com/99designs/gqlgen/graphql.Int64
      - github.com/99designs/gqlgen/graphql.Int32
  Time:
    model: github.com/99designs/gqlgen/graphql.Time
  User:
    model: "{{.ModulePath}}/internal/graphql/models.User"
    fields:
      todos:
        resolver: true
  Todo:
    model: "{{.ModulePath}}/internal/graphql/models.Todo"
    fields:
      user:
        resolver: true