AWSTemplateFormatVersion: '2010-09-09'
Transform: AWS::Serverless-2016-10-31
Description: >
  {{.ProjectName}} - Production-grade Lambda event processing function
  
  This template creates a comprehensive event processing Lambda function with:
  - Multi-source event handling (SQS, SNS, EventBridge{{- if or (and (kindIs "string" .EventSources) (eq .EventSources "dynamodb-streams")) (and (kindIs "slice" .EventSources) (has "dynamodb-streams" .EventSources))}}, DynamoDB Streams{{- end}}{{- if or (and (kindIs "string" .EventSources) (eq .EventSources "kinesis")) (and (kindIs "slice" .EventSources) (has "kinesis" .EventSources))}}, Kinesis{{- end}})
  - Advanced observability (X-Ray tracing, CloudWatch metrics, structured logging)
  - Resilience patterns (circuit breakers{{- if or (and (kindIs "string" .ResilienceFeatures) (eq .ResilienceFeatures "dlq")) (and (kindIs "slice" .ResilienceFeatures) (has "dlq" .ResilienceFeatures))}}, DLQ handling{{- end}}, retry logic)
  - Enterprise security (input validation, secrets management)
  - Performance optimization (cold start mitigation, memory tuning)

# Global configuration
Globals:
  Function:
    Runtime: provided.al2
    Architecture: {{- if eq .GoVersion "1.21"}} arm64 {{- else}} x86_64 {{- end}}
    Timeout: 300
    MemorySize: 256
    Environment:
      Variables:
        LOG_LEVEL: !Ref LogLevel
        AWS_LAMBDA_GO_VERSION: "{{.GoVersion}}"
        PROCESSING_PATTERN: "{{.ProcessingPattern}}"
        OBSERVABILITY_LEVEL: "{{.ObservabilityLevel}}"
    Tracing: Active
{{- if ne .ObservabilityLevel "basic"}}
    DeadLetterQueue:
      Type: SQS
      TargetArn: !GetAtt ProcessingDLQ.Arn
{{- end}}
    ReservedConcurrencyLimit: 100

# Template parameters
Parameters:
  Environment:
    Type: String
    Default: dev
    AllowedValues: [dev, staging, prod]
    Description: Deployment environment
  
  LogLevel:
    Type: String
    Default: info
    AllowedValues: [debug, info, warn, error]
    Description: Log level for the Lambda function
  
  VpcConfig:
    Type: String
    Default: 'false'
    AllowedValues: ['true', 'false']
    Description: Whether to deploy the Lambda in a VPC

{{- if or (and (kindIs "string" .EventSources) (eq .EventSources "sqs")) (and (kindIs "slice" .EventSources) (has "sqs" .EventSources))}}
  SQSQueueName:
    Type: String
    Default: {{.ProjectName}}-processing-queue
    Description: Name of the SQS queue for event processing
{{- end}}

{{- if or (and (kindIs "string" .EventSources) (eq .EventSources "sns")) (and (kindIs "slice" .EventSources) (has "sns" .EventSources))}}
  SNSTopicName:
    Type: String
    Default: {{.ProjectName}}-notifications
    Description: Name of the SNS topic for notifications
{{- end}}

# Conditions for conditional resource creation
Conditions:
  IsProduction: !Equals [!Ref Environment, prod]
  IsVpcDeployment: !Equals [!Ref VpcConfig, 'true']
{{- if ne .ObservabilityLevel "basic"}}
  EnableAdvancedObservability: true
{{- else}}
  EnableAdvancedObservability: false
{{- end}}
{{- if or (and (kindIs "string" .ResilienceFeatures) (eq .ResilienceFeatures "dlq")) (and (kindIs "slice" .ResilienceFeatures) (has "dlq" .ResilienceFeatures))}}
  EnableDLQ: true
{{- else}}
  EnableDLQ: false
{{- end}}

# Resources
Resources:
  # Main Lambda function
  EventProcessingFunction:
    Type: AWS::Serverless::Function
    Properties:
      FunctionName: !Sub '${AWS::StackName}-event-processor'
      CodeUri: .
      Handler: bootstrap
      Description: !Sub 'Production-grade event processing function for ${Environment}'
      Environment:
        Variables:
          ENVIRONMENT: !Ref Environment
{{- if or (and (kindIs "string" .EventSources) (eq .EventSources "sqs")) (and (kindIs "slice" .EventSources) (has "sqs" .EventSources))}}
          SQS_QUEUE_URL: !Ref ProcessingQueue
{{- end}}
{{- if or (and (kindIs "string" .EventSources) (eq .EventSources "sns")) (and (kindIs "slice" .EventSources) (has "sns" .EventSources))}}
          SNS_TOPIC_ARN: !Ref NotificationTopic
{{- end}}
{{- if or (and (kindIs "string" .SecurityFeatures) (eq .SecurityFeatures "secrets-manager")) (and (kindIs "slice" .SecurityFeatures) (has "secrets-manager" .SecurityFeatures))}}
          SECRETS_MANAGER_ENABLED: 'true'
{{- end}}
{{- if or (and (kindIs "string" .ResilienceFeatures) (eq .ResilienceFeatures "dlq")) (and (kindIs "slice" .ResilienceFeatures) (has "dlq" .ResilienceFeatures))}}
          DLQ_QUEUE_URL: !Ref ProcessingDLQ
{{- end}}
      Events:
{{- if or (and (kindIs "string" .EventSources) (eq .EventSources "sqs")) (and (kindIs "slice" .EventSources) (has "sqs" .EventSources))}}
        SQSEvent:
          Type: SQS
          Properties:
            Queue: !GetAtt ProcessingQueue.Arn
            BatchSize: {{- if eq .ProcessingPattern "batch"}} 10 {{- else}} 1 {{- end}}
            MaximumBatchingWindowInSeconds: {{- if eq .ProcessingPattern "batch"}} 5 {{- else}} 0 {{- end}}
            FunctionResponseTypes:
              - ReportBatchItemFailures
{{- end}}
{{- if or (and (kindIs "string" .EventSources) (eq .EventSources "sns")) (and (kindIs "slice" .EventSources) (has "sns" .EventSources))}}
        SNSEvent:
          Type: SNS
          Properties:
            Topic: !Ref NotificationTopic
{{- end}}
{{- if or (and (kindIs "string" .EventSources) (eq .EventSources "eventbridge")) (and (kindIs "slice" .EventSources) (has "eventbridge" .EventSources))}}
        EventBridgeEvent:
          Type: EventBridgeRule
          Properties:
            EventBusName: default
            Pattern:
              source: ["custom.{{.ProjectName}}"]
            RetryPolicy:
              MaximumRetryAttempts: 3
            DeadLetterConfig:
              Arn: !GetAtt ProcessingDLQ.Arn
{{- end}}
      Policies:
        # CloudWatch Logs
        - CloudWatchLogsFullAccess
        # X-Ray Tracing
        - AWSXRayDaemonWriteAccess
        # Custom policies for event sources
{{- if or (and (kindIs "string" .EventSources) (eq .EventSources "sqs")) (and (kindIs "slice" .EventSources) (has "sqs" .EventSources))}}
        - SQSPollerPolicy:
            QueueName: !GetAtt ProcessingQueue.QueueName
{{- end}}
{{- if or (and (kindIs "string" .EventSources) (eq .EventSources "sns")) (and (kindIs "slice" .EventSources) (has "sns" .EventSources))}}
        - SNSCrudPolicy:
            TopicName: !GetAtt NotificationTopic.TopicName
{{- end}}
{{- if or (and (kindIs "string" .EventSources) (eq .EventSources "eventbridge")) (and (kindIs "slice" .EventSources) (has "eventbridge" .EventSources))}}
        - EventBridgePutEventsPolicy:
            EventBusName: default
{{- end}}
{{- if or (and (kindIs "string" .SecurityFeatures) (eq .SecurityFeatures "secrets-manager")) (and (kindIs "slice" .SecurityFeatures) (has "secrets-manager" .SecurityFeatures))}}
        - AWSSecretsManagerGetSecretValuePolicy:
            SecretArn: !Sub 'arn:aws:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:{{.ProjectName}}/*'
{{- end}}
{{- if or (and (kindIs "string" .ResilienceFeatures) (eq .ResilienceFeatures "dlq")) (and (kindIs "slice" .ResilienceFeatures) (has "dlq" .ResilienceFeatures))}}
        - SQSSendMessagePolicy:
            QueueName: !GetAtt ProcessingDLQ.QueueName
{{- end}}
        # Custom CloudWatch metrics
        - Statement:
            - Effect: Allow
              Action:
                - cloudwatch:PutMetricData
              Resource: '*'
              Condition:
                StringEquals:
                  cloudwatch:namespace: 'AWS/Lambda/{{.ProjectName}}'
    Metadata:
      BuildMethod: makefile

{{- if or (and (kindIs "string" .EventSources) (eq .EventSources "sqs")) (and (kindIs "slice" .EventSources) (has "sqs" .EventSources))}}
  # SQS Queue for event processing
  ProcessingQueue:
    Type: AWS::SQS::Queue
    Properties:
      QueueName: !Sub '${AWS::StackName}-processing-queue'
      VisibilityTimeoutSeconds: 300
      MessageRetentionPeriod: 1209600  # 14 days
      ReceiveMessageWaitTimeSeconds: 20
{{- if or (and (kindIs "string" .ResilienceFeatures) (eq .ResilienceFeatures "dlq")) (and (kindIs "slice" .ResilienceFeatures) (has "dlq" .ResilienceFeatures))}}
      RedrivePolicy:
        deadLetterTargetArn: !GetAtt ProcessingDLQ.Arn
        maxReceiveCount: 3
{{- end}}
      Tags:
        - Key: Environment
          Value: !Ref Environment
        - Key: Project
          Value: {{.ProjectName}}
{{- end}}

{{- if or (and (kindIs "string" .EventSources) (eq .EventSources "sns")) (and (kindIs "slice" .EventSources) (has "sns" .EventSources))}}
  # SNS Topic for notifications
  NotificationTopic:
    Type: AWS::SNS::Topic
    Properties:
      TopicName: !Sub '${AWS::StackName}-notifications'
      DisplayName: !Sub '{{.ProjectName}} Notifications (${Environment})'
      Tags:
        - Key: Environment
          Value: !Ref Environment
        - Key: Project
          Value: {{.ProjectName}}
{{- end}}

{{- if or (and (kindIs "string" .ResilienceFeatures) (eq .ResilienceFeatures "dlq")) (and (kindIs "slice" .ResilienceFeatures) (has "dlq" .ResilienceFeatures))}}
  # Dead Letter Queue for failed messages
  ProcessingDLQ:
    Type: AWS::SQS::Queue
    Properties:
      QueueName: !Sub '${AWS::StackName}-processing-dlq'
      MessageRetentionPeriod: 1209600  # 14 days
      Tags:
        - Key: Environment
          Value: !Ref Environment
        - Key: Project
          Value: {{.ProjectName}}
        - Key: Purpose
          Value: DeadLetterQueue
{{- end}}

{{- if ne .ObservabilityLevel "basic"}}
  # CloudWatch Log Group with retention
  LogGroup:
    Type: AWS::Logs::LogGroup
    Properties:
      LogGroupName: !Sub '/aws/lambda/${EventProcessingFunction}'
      RetentionInDays: !If [IsProduction, 30, 7]

  # Custom CloudWatch Dashboard
  MonitoringDashboard:
    Type: AWS::CloudWatch::Dashboard
    Properties:
      DashboardName: !Sub '${AWS::StackName}-monitoring'
      DashboardBody: !Sub |
        {
          "widgets": [
            {
              "type": "metric",
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 6,
              "properties": {
                "metrics": [
                  [ "AWS/Lambda", "Invocations", "FunctionName", "${EventProcessingFunction}" ],
                  [ ".", "Errors", ".", "." ],
                  [ ".", "Duration", ".", "." ],
                  [ ".", "Throttles", ".", "." ]
                ],
                "view": "timeSeries",
                "stacked": false,
                "region": "${AWS::Region}",
                "title": "Lambda Metrics",
                "period": 300
              }
            },
            {
              "type": "metric",
              "x": 12,
              "y": 0,
              "width": 12,
              "height": 6,
              "properties": {
                "metrics": [
{{- if or (and (kindIs "string" .EventSources) (eq .EventSources "sqs")) (and (kindIs "slice" .EventSources) (has "sqs" .EventSources))}}
                  [ "AWS/SQS", "NumberOfMessagesSent", "QueueName", "${ProcessingQueue}" ],
                  [ ".", "NumberOfMessagesReceived", ".", "." ],
                  [ ".", "ApproximateNumberOfMessages", ".", "." ]
{{- end}}
{{- if or (and (kindIs "string" .EventSources) (eq .EventSources "sns")) (and (kindIs "slice" .EventSources) (has "sns" .EventSources))}}
                  [ "AWS/SNS", "NumberOfMessagesPublished", "TopicName", "${NotificationTopic}" ],
                  [ ".", "NumberOfNotificationsFailed", ".", "." ]
{{- end}}
                ],
                "view": "timeSeries",
                "stacked": false,
                "region": "${AWS::Region}",
                "title": "Event Source Metrics",
                "period": 300
              }
            }
          ]
        }

  # CloudWatch Alarms
  ErrorAlarm:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub '${AWS::StackName}-lambda-errors'
      AlarmDescription: 'Lambda function error rate is too high'
      MetricName: Errors
      Namespace: AWS/Lambda
      Statistic: Sum
      Period: 300
      EvaluationPeriods: 2
      Threshold: 5
      ComparisonOperator: GreaterThanThreshold
      Dimensions:
        - Name: FunctionName
          Value: !Ref EventProcessingFunction
      AlarmActions:
{{- if or (and (kindIs "string" .EventSources) (eq .EventSources "sns")) (and (kindIs "slice" .EventSources) (has "sns" .EventSources))}}
        - !Ref NotificationTopic
{{- end}}

  DurationAlarm:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: !Sub '${AWS::StackName}-lambda-duration'
      AlarmDescription: 'Lambda function duration is too high'
      MetricName: Duration
      Namespace: AWS/Lambda
      Statistic: Average
      Period: 300
      EvaluationPeriods: 3
      Threshold: 30000  # 30 seconds
      ComparisonOperator: GreaterThanThreshold
      Dimensions:
        - Name: FunctionName
          Value: !Ref EventProcessingFunction
{{- end}}

{{- if or (and (kindIs "string" .SecurityFeatures) (eq .SecurityFeatures "secrets-manager")) (and (kindIs "slice" .SecurityFeatures) (has "secrets-manager" .SecurityFeatures))}}
  # Secrets for the application
  ApplicationSecrets:
    Type: AWS::SecretsManager::Secret
    Properties:
      Name: !Sub '{{.ProjectName}}-${Environment}-secrets'
      Description: !Sub 'Application secrets for {{.ProjectName}} in ${Environment}'
      GenerateSecretString:
        SecretStringTemplate: '{"api_key": "placeholder"}'
        GenerateStringKey: 'secret_key'
        PasswordLength: 32
        ExcludeCharacters: '"@/\'
      Tags:
        - Key: Environment
          Value: !Ref Environment
        - Key: Project
          Value: {{.ProjectName}}
{{- end}}

# Outputs
Outputs:
  EventProcessingFunctionArn:
    Description: 'ARN of the event processing Lambda function'
    Value: !GetAtt EventProcessingFunction.Arn
    Export:
      Name: !Sub '${AWS::StackName}-function-arn'

{{- if or (and (kindIs "string" .EventSources) (eq .EventSources "sqs")) (and (kindIs "slice" .EventSources) (has "sqs" .EventSources))}}
  ProcessingQueueUrl:
    Description: 'URL of the SQS processing queue'
    Value: !Ref ProcessingQueue
    Export:
      Name: !Sub '${AWS::StackName}-queue-url'
  
  ProcessingQueueArn:
    Description: 'ARN of the SQS processing queue'
    Value: !GetAtt ProcessingQueue.Arn
    Export:
      Name: !Sub '${AWS::StackName}-queue-arn'
{{- end}}

{{- if or (and (kindIs "string" .EventSources) (eq .EventSources "sns")) (and (kindIs "slice" .EventSources) (has "sns" .EventSources))}}
  NotificationTopicArn:
    Description: 'ARN of the SNS notification topic'
    Value: !Ref NotificationTopic
    Export:
      Name: !Sub '${AWS::StackName}-topic-arn'
{{- end}}

{{- if or (and (kindIs "string" .ResilienceFeatures) (eq .ResilienceFeatures "dlq")) (and (kindIs "slice" .ResilienceFeatures) (has "dlq" .ResilienceFeatures))}}
  ProcessingDLQUrl:
    Description: 'URL of the processing dead letter queue'
    Value: !Ref ProcessingDLQ
    Export:
      Name: !Sub '${AWS::StackName}-dlq-url'
{{- end}}

{{- if ne .ObservabilityLevel "basic"}}
  MonitoringDashboardUrl:
    Description: 'URL of the CloudWatch monitoring dashboard'
    Value: !Sub 'https://console.aws.amazon.com/cloudwatch/home?region=${AWS::Region}#dashboards:name=${MonitoringDashboard}'
    Export:
      Name: !Sub '${AWS::StackName}-dashboard-url'
{{- end}}

  LogGroupName:
    Description: 'Name of the CloudWatch log group'
    Value: !Sub '/aws/lambda/${EventProcessingFunction}'
    Export:
      Name: !Sub '${AWS::StackName}-log-group'