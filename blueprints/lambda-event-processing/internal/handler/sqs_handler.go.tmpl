{{- end}}
)

// SQSHandler processes SQS messages with comprehensive error handling and observability
type SQSHandler struct {
	cfg       *appConfig.Config
	sqsClient *sqs.Client
	logger    observability.Logger
{{- if eq .ProcessingPattern "batch"}}
	processor *processor.BatchProcessor
{{- end}}
{{- if or (and (kindIs "string" .ResilienceFeatures) (eq .ResilienceFeatures "dlq")) (and (kindIs "slice" .ResilienceFeatures) (has "dlq" .ResilienceFeatures))}}
	dlqHandler *resilience.DLQHandler
{{- end}}
{{- if or (and (kindIs "string" .SecurityFeatures) (eq .SecurityFeatures "input-validation")) (and (kindIs "slice" .SecurityFeatures) (has "input-validation" .SecurityFeatures))}}
	validator *security.InputValidator
{{- end}}
}

// NewSQSHandler creates a new SQS event handler with AWS SDK v2
func NewSQSHandler(cfg *appConfig.Config) (*SQSHandler, error) {
	logger := observability.GetLogger()
	
	// Initialize AWS config
	awsCfg, err := config.LoadDefaultConfig(context.Background(),
		config.WithRegion(cfg.AWS.Region),
	)
	if err != nil {
		return nil, fmt.Errorf("failed to load AWS config: %w", err)
	}

	handler := &SQSHandler{
		cfg:       cfg,
		sqsClient: sqs.NewFromConfig(awsCfg),
		logger:    logger,
	}

{{- if eq .ProcessingPattern "batch"}}
	// Initialize batch processor
	handler.processor, err = processor.NewBatchProcessor(cfg.Processing.Batch)
	if err != nil {
		return nil, fmt.Errorf("failed to initialize batch processor: %w", err)
	}
{{- end}}

{{- if or (and (kindIs "string" .ResilienceFeatures) (eq .ResilienceFeatures "dlq")) (and (kindIs "slice" .ResilienceFeatures) (has "dlq" .ResilienceFeatures))}}
	// Initialize DLQ handler
	handler.dlqHandler, err = resilience.NewDLQHandler(cfg.Resilience.DLQ, handler.sqsClient)
	if err != nil {
		return nil, fmt.Errorf("failed to initialize DLQ handler: %w", err)
	}
{{- end}}

{{- if or (and (kindIs "string" .SecurityFeatures) (eq .SecurityFeatures "input-validation")) (and (kindIs "slice" .SecurityFeatures) (has "input-validation" .SecurityFeatures))}}
	// Initialize input validator
	handler.validator = security.NewInputValidator(cfg.Security.Validation)
{{- end}}

	logger.Info("SQS handler initialized", map[string]interface{}{
		"processing_pattern": "{{.ProcessingPattern}}",
		"region":            cfg.AWS.Region,
{{- if or (and (kindIs "string" .ResilienceFeatures) (eq .ResilienceFeatures "dlq")) (and (kindIs "slice" .ResilienceFeatures) (has "dlq" .ResilienceFeatures))}}
		"dlq_enabled":       cfg.Resilience.DLQ.Enabled,
{{- end}}
{{- if or (and (kindIs "string" .SecurityFeatures) (eq .SecurityFeatures "input-validation")) (and (kindIs "slice" .SecurityFeatures) (has "input-validation" .SecurityFeatures))}}
		"validation_enabled": cfg.Security.Validation.Enabled,
{{- end}}
	})

	return handler, nil
}

// HandleEvent processes SQS events with comprehensive error handling
func (h *SQSHandler) HandleEvent(ctx context.Context, event interface{}) (*domain.ProcessingResult, error) {
	sqsEvent, ok := event.(events.SQSEvent)
	if !ok {
		return nil, fmt.Errorf("invalid event type for SQS handler: %T", event)
	}

	h.logger.Info("Processing SQS event", map[string]interface{}{
		"record_count": len(sqsEvent.Records),
		"processing":   "{{.ProcessingPattern}}",
	})

	// Track SQS-specific metrics
	observability.RecordSQSMessageCount(len(sqsEvent.Records))

	// Process based on configured pattern
{{- if eq .ProcessingPattern "batch"}}
	return h.processBatch(ctx, sqsEvent.Records)
{{- else if eq .ProcessingPattern "individual"}}
	return h.processIndividual(ctx, sqsEvent.Records)
{{- else}}
	return h.processDefault(ctx, sqsEvent.Records)
{{- end}}
}

{{- if eq .ProcessingPattern "batch"}}
// processBatch processes multiple SQS messages in parallel batches
func (h *SQSHandler) processBatch(ctx context.Context, records []events.SQSMessage) (*domain.ProcessingResult, error) {
	return observability.TraceSubsegment(ctx, "sqs_batch_processing", func(ctx context.Context) (*domain.ProcessingResult, error) {
		// Convert SQS messages to domain messages
		messages := make([]*domain.Message, len(records))
		for i, record := range records {
			msg, err := h.convertSQSMessage(record)
			if err != nil {
				h.logger.Error("Failed to convert SQS message", map[string]interface{}{
					"message_id": record.MessageId,
					"error":      err.Error(),
				})
				continue
			}
			messages[i] = msg
		}

		// Process batch using the batch processor
		return h.processor.ProcessBatch(ctx, messages)
	})
}
{{- end}}

{{- if eq .ProcessingPattern "individual"}}
// processIndividual processes each SQS message individually with error isolation
func (h *SQSHandler) processIndividual(ctx context.Context, records []events.SQSMessage) (*domain.ProcessingResult, error) {
	result := &domain.ProcessingResult{
		ProcessedCount: 0,
		FailedCount:    0,
		Errors:         make(map[string]error),
	}

	for _, record := range records {
		err := h.processMessage(ctx, record)
		if err != nil {
			result.FailedCount++
			result.Errors[record.MessageId] = err
			h.logger.Error("Failed to process SQS message", map[string]interface{}{
				"message_id": record.MessageId,
				"error":      err.Error(),
			})
{{- if or (and (kindIs "string" .ResilienceFeatures) (eq .ResilienceFeatures "dlq")) (and (kindIs "slice" .ResilienceFeatures) (has "dlq" .ResilienceFeatures))}}
			// Send to DLQ if processing fails
			if dlqErr := h.dlqHandler.SendToDLQ(ctx, record, err); dlqErr != nil {
				h.logger.Error("Failed to send message to DLQ", map[string]interface{}{
					"message_id": record.MessageId,
					"dlq_error":  dlqErr.Error(),
				})
			}
{{- end}}
		} else {
			result.ProcessedCount++
			h.logger.Debug("Successfully processed SQS message", map[string]interface{}{
				"message_id": record.MessageId,
			})
		}
	}

	return result, nil
}
{{- end}}

// processDefault handles standard SQS message processing
func (h *SQSHandler) processDefault(ctx context.Context, records []events.SQSMessage) (*domain.ProcessingResult, error) {
	result := &domain.ProcessingResult{
		ProcessedCount: 0,
		FailedCount:    0,
		Errors:         make(map[string]error),
	}

	// Process messages with controlled concurrency
	semaphore := make(chan struct{}, h.cfg.Processing.MaxConcurrency)
	var wg sync.WaitGroup
	var mu sync.Mutex

	for _, record := range records {
		wg.Add(1)
		go func(msg events.SQSMessage) {
			defer wg.Done()
			
			// Acquire semaphore
			semaphore <- struct{}{}
			defer func() { <-semaphore }()

			err := h.processMessage(ctx, msg)
			
			mu.Lock()
			if err != nil {
				result.FailedCount++
				result.Errors[msg.MessageId] = err
			} else {
				result.ProcessedCount++
			}
			mu.Unlock()
		}(record)
	}

	wg.Wait()
	return result, nil
}

// processMessage processes a single SQS message with comprehensive error handling
func (h *SQSHandler) processMessage(ctx context.Context, record events.SQSMessage) error {
	return observability.TraceSubsegment(ctx, "process_sqs_message", func(ctx context.Context) error {
		// Add message metadata to trace
		observability.AddTraceAnnotation(ctx, "message_id", record.MessageId)
		observability.AddTraceAnnotation(ctx, "queue_name", record.EventSourceARN)
		
		// Parse message body
		var messageBody map[string]interface{}
		if err := json.Unmarshal([]byte(record.Body), &messageBody); err != nil {
			return fmt.Errorf("failed to parse message body: %w", err)
		}

{{- if or (and (kindIs "string" .SecurityFeatures) (eq .SecurityFeatures "input-validation")) (and (kindIs "slice" .SecurityFeatures) (has "input-validation" .SecurityFeatures))}}
		// Validate message input
		if h.validator != nil {
			if err := h.validator.ValidateMessage(messageBody); err != nil {
				return fmt.Errorf("message validation failed: %w", err)
			}
		}
{{- end}}

		// Log message processing start
		h.logger.Debug("Processing SQS message", map[string]interface{}{
			"message_id":      record.MessageId,
			"receipt_handle":  record.ReceiptHandle,
			"queue_arn":       record.EventSourceARN,
			"body_size":       len(record.Body),
		})

		// Add business logic here
		if err := h.processBusinessLogic(ctx, messageBody, record); err != nil {
			return fmt.Errorf("business logic processing failed: %w", err)
		}

		// Record successful processing
		observability.RecordSQSMessageProcessed()
		
		return nil
	})
}

// processBusinessLogic contains the actual business logic for processing messages
func (h *SQSHandler) processBusinessLogic(ctx context.Context, messageBody map[string]interface{}, record events.SQSMessage) error {
	// Extract message type or routing key
	messageType, ok := messageBody["type"].(string)
	if !ok {
		messageType = "unknown"
	}

	h.logger.Info("Processing business logic", map[string]interface{}{
		"message_id":   record.MessageId,
		"message_type": messageType,
	})

	// Add your business logic here
	// This is where you would:
	// 1. Transform the message data
	// 2. Call external APIs
	// 3. Store data in databases
	// 4. Trigger downstream processes
	
	// Example business logic (replace with your actual logic)
	switch messageType {
	case "user_created":
		return h.handleUserCreated(ctx, messageBody)
	case "order_placed":
		return h.handleOrderPlaced(ctx, messageBody)
	case "payment_processed":
		return h.handlePaymentProcessed(ctx, messageBody)
	default:
		h.logger.Warn("Unknown message type", map[string]interface{}{
			"message_type": messageType,
			"message_id":   record.MessageId,
		})
		// Don't return an error for unknown types to avoid infinite reprocessing
		return nil
	}
}

