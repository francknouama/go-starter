// convertSQSMessage converts an SQS message to a domain message
func (h *SQSHandler) convertSQSMessage(record events.SQSMessage) (*domain.Message, error) {
	msg := &domain.Message{
		ID:          record.MessageId,
		Body:        record.Body,
		Attributes:  make(map[string]interface{}),
		Timestamp:   time.Now(),
		Source:      "sqs",
		SourceARN:   record.EventSourceARN,
	}

	// Convert message attributes
	for key, attr := range record.MessageAttributes {
		if attr.StringValue != nil {
			msg.Attributes[key] = *attr.StringValue
		}
	}

	// Add SQS-specific metadata
	msg.Metadata = map[string]interface{}{
		"receipt_handle":      record.ReceiptHandle,
		"approximate_receive_count": record.Attributes["ApproximateReceiveCount"],
		"sent_timestamp":      record.Attributes["SentTimestamp"],
	}

	return msg, nil
}

// GetEventType returns the event type this handler processes
func (h *SQSHandler) GetEventType() string {
	return "sqs"
}

// Validate checks if the event is a valid SQS event
func (h *SQSHandler) Validate(event interface{}) error {
	sqsEvent, ok := event.(events.SQSEvent)
	if !ok {
		return fmt.Errorf("event is not an SQS event: %T", event)
	}

	if len(sqsEvent.Records) == 0 {
		return fmt.Errorf("SQS event contains no records")
	}

	// Validate each record
	for i, record := range sqsEvent.Records {
		if record.MessageId == "" {
			return fmt.Errorf("SQS record %d missing message ID", i)
		}
		if record.Body == "" {
			return fmt.Errorf("SQS record %d missing body", i)
		}
		if record.EventSource != "aws:sqs" {
			return fmt.Errorf("SQS record %d has invalid event source: %s", i, record.EventSource)
		}
	}

	return nil
}

// HealthCheck verifies the SQS handler is functioning correctly
func (h *SQSHandler) HealthCheck(ctx context.Context) error {
	// Check SQS client connectivity
	_, err := h.sqsClient.ListQueues(ctx, &sqs.ListQueuesInput{
		MaxResults: aws.Int32(1),
	})
	if err != nil {
		return fmt.Errorf("SQS health check failed: %w", err)
	}

{{- if eq .ProcessingPattern "batch"}}
	// Check batch processor health
	if err := h.processor.HealthCheck(ctx); err != nil {
		return fmt.Errorf("batch processor health check failed: %w", err)
	}
{{- end}}

	return nil
}

// GetMetrics returns handler-specific metrics
func (h *SQSHandler) GetMetrics() map[string]interface{} {
	metrics := map[string]interface{}{
		"handler_type": "sqs",
		"processing_pattern": "{{.ProcessingPattern}}",
	}

{{- if eq .ProcessingPattern "batch"}}
	if h.processor != nil {
		processorMetrics := h.processor.GetMetrics()
		for key, value := range processorMetrics {
			metrics["processor_"+key] = value
		}
	}
{{- end}}

	return metrics
}