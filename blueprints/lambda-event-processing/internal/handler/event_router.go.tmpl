// Utility functions
func getHandlerTypes(handlers map[string]EventHandler) []string {
	types := make([]string, 0, len(handlers))
	for handlerType := range handlers {
		types = append(types, handlerType)
	}
	return types
}

func getEventSize(event interface{}) int {
	if eventBytes, err := json.Marshal(event); err == nil {
		return len(eventBytes)
	}
	return 0
}

// GetRegisteredHandlers returns a list of registered handler types
func (r *EventRouter) GetRegisteredHandlers() []string {
	return getHandlerTypes(r.handlers)
}

// GetHandler returns a specific handler by type (useful for testing)
func (r *EventRouter) GetHandler(eventType string) (EventHandler, bool) {
	handler, exists := r.handlers[eventType]
	return handler, exists
}

// HealthCheck verifies all handlers are functioning correctly
func (r *EventRouter) HealthCheck(ctx context.Context) error {
	for handlerType, handler := range r.handlers {
		// Check if handler has a health check method
		if healthChecker, ok := handler.(interface{ HealthCheck(context.Context) error }); ok {
			if err := healthChecker.HealthCheck(ctx); err != nil {
				return fmt.Errorf("handler %s health check failed: %w", handlerType, err)
			}
		}
	}
	return nil
}