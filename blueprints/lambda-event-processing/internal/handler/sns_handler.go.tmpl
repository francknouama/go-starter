// convertSNSMessage converts an SNS message to a domain message
func (h *SNSHandler) convertSNSMessage(message events.SNSMessage) (*domain.Message, error) {
	msg := &domain.Message{
		ID:          message.MessageId,
		Body:        message.Message,
		Attributes:  make(map[string]interface{}),
		Timestamp:   time.Now(),
		Source:      "sns",
		SourceARN:   message.TopicArn,
	}

	// Convert message attributes
	for key, attr := range message.MessageAttributes {
		if attr.Value != nil {
			msg.Attributes[key] = *attr.Value
		}
	}

	// Add SNS-specific metadata
	msg.Metadata = map[string]interface{}{
		"subject":         message.Subject,
		"message_id":      message.MessageId,
		"signature":       message.Signature,
		"signature_version": message.SignatureVersion,
		"signing_cert_url": message.SigningCertURL,
		"unsubscribe_url": message.UnsubscribeURL,
	}

	return msg, nil
}

// GetEventType returns the event type this handler processes
func (h *SNSHandler) GetEventType() string {
	return "sns"
}

// Validate checks if the event is a valid SNS event
func (h *SNSHandler) Validate(event interface{}) error {
	snsEvent, ok := event.(events.SNSEvent)
	if !ok {
		return fmt.Errorf("event is not an SNS event: %T", event)
	}

	if len(snsEvent.Records) == 0 {
		return fmt.Errorf("SNS event contains no records")
	}

	// Validate each record
	for i, record := range snsEvent.Records {
		if record.SNS.MessageId == "" {
			return fmt.Errorf("SNS record %d missing message ID", i)
		}
		if record.SNS.Message == "" {
			return fmt.Errorf("SNS record %d missing message body", i)
		}
		if record.EventSource != "aws:sns" {
			return fmt.Errorf("SNS record %d has invalid event source: %s", i, record.EventSource)
		}
		if record.SNS.TopicArn == "" {
			return fmt.Errorf("SNS record %d missing topic ARN", i)
		}
	}

	return nil
}

// HealthCheck verifies the SNS handler is functioning correctly
func (h *SNSHandler) HealthCheck(ctx context.Context) error {
	// Check SNS client connectivity
	_, err := h.snsClient.ListTopics(ctx, &sns.ListTopicsInput{})
	if err != nil {
		return fmt.Errorf("SNS health check failed: %w", err)
	}

{{- if eq .ProcessingPattern "fanout"}}
	// Check fanout processor health
	if err := h.processor.HealthCheck(ctx); err != nil {
		return fmt.Errorf("fanout processor health check failed: %w", err)
	}
{{- end}}

	return nil
}

// GetMetrics returns handler-specific metrics
func (h *SNSHandler) GetMetrics() map[string]interface{} {
	metrics := map[string]interface{}{
		"handler_type": "sns",
		"processing_pattern": "{{.ProcessingPattern}}",
	}

{{- if eq .ProcessingPattern "fanout"}}
	if h.processor != nil {
		processorMetrics := h.processor.GetMetrics()
		for key, value := range processorMetrics {
			metrics["processor_"+key] = value
		}
	}
{{- end}}

	return metrics
}