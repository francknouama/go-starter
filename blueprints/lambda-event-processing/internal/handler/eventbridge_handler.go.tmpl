// convertEventBridgeEvent converts an EventBridge event to a domain message
func (h *EventBridgeHandler) convertEventBridgeEvent(event events.CloudWatchEvent) (*domain.Message, error) {
	msg := &domain.Message{
		ID:        event.ID,
		Body:      string(event.Detail),
		Attributes: map[string]interface{}{
			"source":      event.Source,
			"detail_type": event.DetailType,
			"account":     event.Account,
			"region":      event.Region,
		},
		Timestamp: event.Time,
		Source:    "eventbridge",
		SourceARN: fmt.Sprintf("arn:aws:events:%s:%s:event-bus/%s", event.Region, event.Account, "default"),
	}

	// Add EventBridge-specific metadata
	msg.Metadata = map[string]interface{}{
		"version":     event.Version,
		"resources":   event.Resources,
		"source":      event.Source,
		"detail_type": event.DetailType,
	}

	return msg, nil
}

// GetEventType returns the event type this handler processes
func (h *EventBridgeHandler) GetEventType() string {
	return "eventbridge"
}

// Validate checks if the event is a valid EventBridge event
func (h *EventBridgeHandler) Validate(event interface{}) error {
	// Try to validate as CloudWatchEvent
	if cwEvent, ok := event.(events.CloudWatchEvent); ok {
		return h.validateCloudWatchEvent(cwEvent)
	}
	
	// Try to convert and validate
	eventBytes, err := json.Marshal(event)
	if err != nil {
		return fmt.Errorf("failed to marshal event for validation: %w", err)
	}
	
	var cwEvent events.CloudWatchEvent
	if err := json.Unmarshal(eventBytes, &cwEvent); err != nil {
		return fmt.Errorf("event is not a valid EventBridge event: %T, error: %w", event, err)
	}
	
	return h.validateCloudWatchEvent(cwEvent)
}

// validateCloudWatchEvent validates a CloudWatch event structure
func (h *EventBridgeHandler) validateCloudWatchEvent(event events.CloudWatchEvent) error {
	if event.ID == "" {
		return fmt.Errorf("EventBridge event missing ID")
	}
	if event.Source == "" {
		return fmt.Errorf("EventBridge event missing source")
	}
	if event.DetailType == "" {
		return fmt.Errorf("EventBridge event missing detail type")
	}
	if len(event.Detail) == 0 {
		return fmt.Errorf("EventBridge event missing detail")
	}
	if event.Account == "" {
		return fmt.Errorf("EventBridge event missing account")
	}
	if event.Region == "" {
		return fmt.Errorf("EventBridge event missing region")
	}

	return nil
}

// HealthCheck verifies the EventBridge handler is functioning correctly
func (h *EventBridgeHandler) HealthCheck(ctx context.Context) error {
	// Check EventBridge client connectivity
	_, err := h.eventBridgeClient.ListEventBuses(ctx, &eventbridge.ListEventBusesInput{
		Limit: aws.Int32(1),
	})
	if err != nil {
		return fmt.Errorf("EventBridge health check failed: %w", err)
	}

	return nil
}

