func (bp *BatchProcessor) processMessage(ctx context.Context, message *domain.Message) error {
	return observability.TraceSubsegment(ctx, "process_batch_message", func(ctx context.Context) error {
		bp.logger.Debug("Processing batch message", map[string]interface{}{
			"message_id": message.ID,
			"source": message.Source,
			"body_size": len(message.Body),
		})

		// Add your business logic here
		// This is where you would:
		// 1. Parse and validate the message
		// 2. Transform the data
		// 3. Call external services
		// 4. Store results in databases
		// 5. Trigger downstream processes

		// Example processing delay (remove in production)
		select {
		case <-time.After(10 * time.Millisecond): // Simulate processing time
		case <-ctx.Done():
			return ctx.Err()
		}

		// Example business logic based on message attributes
		if messageType, exists := message.Attributes["type"]; exists {
			switch messageType {
			case "user_event":
				return bp.processUserEvent(ctx, message)
			case "order_event":
				return bp.processOrderEvent(ctx, message)
			case "payment_event":
				return bp.processPaymentEvent(ctx, message)
			default:
				bp.logger.Warn("Unknown message type in batch", map[string]interface{}{
					"message_type": messageType,
					"message_id": message.ID,
				})
			}
		}

		return nil
	})
}

