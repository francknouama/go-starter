// updateStats updates processing statistics
func (bp *BatchProcessor) updateStats(messageCount int, duration time.Duration) {
	bp.mu.Lock()
	defer bp.mu.Unlock()
	
	bp.stats.BatchesProcessed++
	bp.stats.MessagesProcessed += int64(messageCount)
	bp.stats.LastProcessed = time.Now()
	
	// Calculate moving average for latency
	if bp.stats.BatchesProcessed == 1 {
		bp.stats.AverageLatency = duration
	} else {
		// Simple moving average
		bp.stats.AverageLatency = time.Duration(
			(int64(bp.stats.AverageLatency) + int64(duration)) / 2,
		)
	}
}

// GetStats returns current processing statistics
func (bp *BatchProcessor) GetStats() BatchStats {
	bp.mu.RLock()
	defer bp.mu.RUnlock()
	return bp.stats
}

// GetMetrics returns processor metrics
func (bp *BatchProcessor) GetMetrics() map[string]interface{} {
	stats := bp.GetStats()
	return map[string]interface{}{
		"batches_processed": stats.BatchesProcessed,
		"messages_processed": stats.MessagesProcessed,
		"average_latency_ms": stats.AverageLatency.Milliseconds(),
		"last_processed": stats.LastProcessed.Format(time.RFC3339),
		"config_batch_size": bp.config.Size,
		"config_workers": bp.config.Workers,
	}
}

// HealthCheck verifies the batch processor is functioning correctly
func (bp *BatchProcessor) HealthCheck(ctx context.Context) error {
	// Test with a dummy message
	testMessage := &domain.Message{
		ID:        "health-check",
		Body:      "test",
		Source:    "health-check",
		Timestamp: time.Now(),
		Attributes: map[string]interface{}{
			"type": "health_check",
		},
	}
	
	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
	defer cancel()
	
	err := bp.processMessage(ctx, testMessage)
	if err != nil {
		return fmt.Errorf("batch processor health check failed: %w", err)
	}
	
	return nil
}