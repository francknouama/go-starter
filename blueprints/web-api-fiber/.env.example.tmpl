# Environment Configuration
# Copy this file to .env and configure your environment variables

# Environment (development, staging, production)
ENVIRONMENT=development

# Database Configuration
{{- if eq .DatabaseDriver "postgres"}}
DB_HOST=localhost
DB_PORT=5432
DB_NAME={{.ProjectName}}_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable
{{- else if eq .DatabaseDriver "mysql"}}
DB_HOST=localhost
DB_PORT=3306
DB_NAME={{.ProjectName}}_dev
DB_USER=root
DB_PASSWORD=root
{{- else if eq .DatabaseDriver "sqlite"}}
DB_NAME={{.ProjectName}}_dev.db
{{- end}}

# Server Configuration
PORT=8080
HOST=0.0.0.0

{{- if ne .AuthType ""}}
# Authentication Configuration
AUTH_SECRET=your-super-secret-key-change-this-in-production
{{- if eq .AuthType "oauth2"}}

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/google/callback

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/github/callback
{{- else if eq .AuthType "session"}}

# Session Configuration
SESSION_DOMAIN=localhost
{{- end}}
{{- end}}

# Logging
LOG_LEVEL=debug
LOG_FORMAT=text

# Optional: External Services
# REDIS_URL=redis://localhost:6379
# ELASTICSEARCH_URL=http://localhost:9200