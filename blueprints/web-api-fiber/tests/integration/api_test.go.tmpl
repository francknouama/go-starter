package integration

import (
	"bytes"
	"encoding/json"
	"net/http"
	"net/http/httptest"
	"testing"

	"github.com/gofiber/fiber/v2"
	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"

	"{{.ModulePath}}/internal/config"
	"{{.ModulePath}}/internal/logger"
	"{{.ModulePath}}/internal/server"
{{- if ne .DatabaseDriver ""}}
	"{{.ModulePath}}/internal/database"
{{- end}}
)

func setupTestApp(t *testing.T) *fiber.App {
	// Load test configuration
	cfg, err := config.Load()
	require.NoError(t, err)
	cfg.Environment = "test"

	// Initialize logger
	log := logger.New("error", "test")

{{- if ne .DatabaseDriver ""}}
	// Initialize test database
	db, err := database.Connect(cfg.Database)
	require.NoError(t, err)

	// Run migrations
	err = database.Migrate(db)
	require.NoError(t, err)
{{- end}}

	// Create server dependencies
	deps := &server.Dependencies{
		Config: cfg,
		Logger: log,
{{- if ne .DatabaseDriver ""}}
		DB:     db,
{{- end}}
	}

	// Create and return test app
	return server.New(deps)
}

func TestHealthEndpoints(t *testing.T) {
	app := setupTestApp(t)

	tests := []struct {
		name           string
		path           string
		expectedStatus int
	}{
		{
			name:           "Health check",
			path:           "/health",
			expectedStatus: http.StatusOK,
		},
		{
			name:           "Readiness check",
			path:           "/ready",
			expectedStatus: http.StatusOK,
		},
		{
			name:           "Liveness check",
			path:           "/live",
			expectedStatus: http.StatusOK,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			req := httptest.NewRequest(http.MethodGet, tt.path, nil)
			resp, err := app.Test(req)
			
			require.NoError(t, err)
			assert.Equal(t, tt.expectedStatus, resp.StatusCode)
			
			// Check content type
			assert.Equal(t, "application/json", resp.Header.Get("Content-Type"))
		})
	}
}

{{- if ne .AuthType ""}}
func TestAuthEndpoints(t *testing.T) {
	app := setupTestApp(t)

	t.Run("Register user", func(t *testing.T) {
		reqBody := map[string]string{
			"email":    "test@example.com",
			"password": "password123",
			"name":     "Test User",
		}
		
		jsonBody, _ := json.Marshal(reqBody)
		req := httptest.NewRequest(http.MethodPost, "/api/v1/auth/register", bytes.NewBuffer(jsonBody))
		req.Header.Set("Content-Type", "application/json")
		
		resp, err := app.Test(req)
		require.NoError(t, err)
		
		// Should create user successfully
		assert.Equal(t, http.StatusCreated, resp.StatusCode)
	})

	t.Run("Login user", func(t *testing.T) {
		// First register a user
		reqBody := map[string]string{
			"email":    "login@example.com",
			"password": "password123",
			"name":     "Login User",
		}
		jsonBody, _ := json.Marshal(reqBody)
		req := httptest.NewRequest(http.MethodPost, "/api/v1/auth/register", bytes.NewBuffer(jsonBody))
		req.Header.Set("Content-Type", "application/json")
		_, err := app.Test(req)
		require.NoError(t, err)

		// Now login
		loginBody := map[string]string{
			"email":    "login@example.com",
			"password": "password123",
		}
		jsonBody, _ = json.Marshal(loginBody)
		req = httptest.NewRequest(http.MethodPost, "/api/v1/auth/login", bytes.NewBuffer(jsonBody))
		req.Header.Set("Content-Type", "application/json")
		
		resp, err := app.Test(req)
		require.NoError(t, err)
		assert.Equal(t, http.StatusOK, resp.StatusCode)
	})

	t.Run("Login with invalid credentials", func(t *testing.T) {
		reqBody := map[string]string{
			"email":    "nonexistent@example.com",
			"password": "wrongpassword",
		}
		
		jsonBody, _ := json.Marshal(reqBody)
		req := httptest.NewRequest(http.MethodPost, "/api/v1/auth/login", bytes.NewBuffer(jsonBody))
		req.Header.Set("Content-Type", "application/json")
		
		resp, err := app.Test(req)
		require.NoError(t, err)
		assert.Equal(t, http.StatusUnauthorized, resp.StatusCode)
	})
}
{{- end}}

{{- if ne .DatabaseDriver ""}}
func TestUserEndpoints(t *testing.T) {
	app := setupTestApp(t)

{{- if ne .AuthType ""}}
	// Helper function to get auth token
	getAuthToken := func(t *testing.T) string {
		reqBody := map[string]string{
			"email":    "auth@example.com",
			"password": "password123",
			"name":     "Auth User",
		}
		jsonBody, _ := json.Marshal(reqBody)
		req := httptest.NewRequest(http.MethodPost, "/api/v1/auth/register", bytes.NewBuffer(jsonBody))
		req.Header.Set("Content-Type", "application/json")
		
		resp, err := app.Test(req)
		require.NoError(t, err)
		
		var authResp map[string]interface{}
		err = json.NewDecoder(resp.Body).Decode(&authResp)
		require.NoError(t, err)
		
		return authResp["token"].(string)
	}

	token := getAuthToken(t)
{{- end}}

	t.Run("Get users", func(t *testing.T) {
		req := httptest.NewRequest(http.MethodGet, "/api/v1/users", nil)
{{- if ne .AuthType ""}}
		req.Header.Set("Authorization", "Bearer "+token)
{{- end}}
		
		resp, err := app.Test(req)
		require.NoError(t, err)
		assert.Equal(t, http.StatusOK, resp.StatusCode)
	})

	t.Run("Create user", func(t *testing.T) {
		reqBody := map[string]string{
			"email":    "newuser@example.com",
			"password": "password123",
			"name":     "New User",
		}
		
		jsonBody, _ := json.Marshal(reqBody)
		req := httptest.NewRequest(http.MethodPost, "/api/v1/users", bytes.NewBuffer(jsonBody))
		req.Header.Set("Content-Type", "application/json")
{{- if ne .AuthType ""}}
		req.Header.Set("Authorization", "Bearer "+token)
{{- end}}
		
		resp, err := app.Test(req)
		require.NoError(t, err)
		assert.Equal(t, http.StatusCreated, resp.StatusCode)
	})

{{- if ne .AuthType ""}}
	t.Run("Get current user", func(t *testing.T) {
		req := httptest.NewRequest(http.MethodGet, "/api/v1/users/me", nil)
		req.Header.Set("Authorization", "Bearer "+token)
		
		resp, err := app.Test(req)
		require.NoError(t, err)
		assert.Equal(t, http.StatusOK, resp.StatusCode)
	})

	t.Run("Unauthorized access", func(t *testing.T) {
		req := httptest.NewRequest(http.MethodGet, "/api/v1/users/me", nil)
		// No authorization header
		
		resp, err := app.Test(req)
		require.NoError(t, err)
		assert.Equal(t, http.StatusUnauthorized, resp.StatusCode)
	})
{{- end}}
}
{{- end}}

func TestNotFoundHandler(t *testing.T) {
	app := setupTestApp(t)

	req := httptest.NewRequest(http.MethodGet, "/nonexistent", nil)
	resp, err := app.Test(req)
	
	require.NoError(t, err)
	assert.Equal(t, http.StatusNotFound, resp.StatusCode)
	assert.Equal(t, "application/json", resp.Header.Get("Content-Type"))
}