func (suite *MiddlewareTestSuite) TestCompressionMiddleware() {
	// Apply Compression middleware
	suite.app.Use(middleware.Compression())

	// Create a test route
	suite.app.Get("/test", func(c *fiber.Ctx) error {
		return c.SendString("test response data that should be compressed")
	})

	// Create request with compression accept header
	req, _ := http.NewRequest(http.MethodGet, "/test", nil)
	req.Header.Set("Accept-Encoding", "gzip")

	// Test
	resp, err := suite.app.Test(req, -1)

	// Assertions
	assert.NoError(suite.T(), err)
	assert.Equal(suite.T(), http.StatusOK, resp.StatusCode)

	// Check if compression header is set (Fiber middleware handles this)
	body, err := io.ReadAll(resp.Body)
	assert.NoError(suite.T(), err)
	assert.NotEmpty(suite.T(), body)
}

