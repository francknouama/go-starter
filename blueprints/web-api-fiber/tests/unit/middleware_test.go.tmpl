func (suite *MiddlewareTestSuite) TestRecoveryMiddleware() {
	// Apply Recovery middleware
	suite.app.Use(middleware.Recovery())

	// Create a test route that panics
	suite.app.Get("/panic", func(c *fiber.Ctx) error {
		panic("test panic")
	})

	// Create request
	req, _ := http.NewRequest(http.MethodGet, "/panic", nil)

	// Test - should not crash the server
	resp, err := suite.app.Test(req, -1)
	
	// Assertions - recovery should handle the panic
	assert.NoError(suite.T(), err)
	// Status should be 500 Internal Server Error
	assert.Equal(suite.T(), http.StatusInternalServerError, resp.StatusCode)
}

func (suite *MiddlewareTestSuite) TestCacheMiddleware() {
	// Apply Cache middleware
	suite.app.Use(middleware.Cache())

	// Create a test route
	suite.app.Get("/test", func(c *fiber.Ctx) error {
		return c.SendString("cached response")
	})

	// Create request
	req1, _ := http.NewRequest(http.MethodGet, "/test", nil)

	// First request
	resp1, err := suite.app.Test(req1, -1)
	assert.NoError(suite.T(), err)
	assert.Equal(suite.T(), http.StatusOK, resp1.StatusCode)

	// Second request (should potentially be cached)
	req2, _ := http.NewRequest(http.MethodGet, "/test", nil)
	resp2, err := suite.app.Test(req2, -1)
	assert.NoError(suite.T(), err)
	assert.Equal(suite.T(), http.StatusOK, resp2.StatusCode)

	// Check cache headers if implemented
	// Note: The actual caching behavior depends on the middleware implementation
}

// Run the test suite
func TestMiddlewareTestSuite(t *testing.T) {
	suite.Run(t, new(MiddlewareTestSuite))
}