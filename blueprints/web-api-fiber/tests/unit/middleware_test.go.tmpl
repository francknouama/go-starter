// MiddlewareTestSuite tests middleware functions
type MiddlewareTestSuite struct {
	suite.Suite
	app *fiber.App
}

func (suite *MiddlewareTestSuite) SetupTest() {
	suite.app = fiber.New()
}

func (suite *MiddlewareTestSuite) TestCORSMiddleware() {
	// Apply CORS middleware
	suite.app.Use(middleware.CORS())

	// Create a test route
	suite.app.Get("/test", func(c *fiber.Ctx) error {
		return c.SendString("test")
	})

	// Create request
	req, _ := http.NewRequest(http.MethodGet, "/test", nil)
	req.Header.Set("Origin", "http://localhost:3000")

	// Test
	resp, err := suite.app.Test(req, -1)

	// Assertions
	assert.NoError(suite.T(), err)
	assert.Equal(suite.T(), http.StatusOK, resp.StatusCode)
	
	// Check CORS headers are set
	assert.Contains(suite.T(), resp.Header, "Access-Control-Allow-Origin")
	assert.Contains(suite.T(), resp.Header, "Access-Control-Allow-Methods")
	assert.Contains(suite.T(), resp.Header, "Access-Control-Allow-Headers")
}

func (suite *MiddlewareTestSuite) TestCORSPreflightRequest() {
	// Apply CORS middleware
	suite.app.Use(middleware.CORS())

	// Create preflight request
	req, _ := http.NewRequest(http.MethodOptions, "/test", nil)
	req.Header.Set("Origin", "http://localhost:3000")
	req.Header.Set("Access-Control-Request-Method", "POST")
	req.Header.Set("Access-Control-Request-Headers", "Content-Type")

	// Test
	resp, err := suite.app.Test(req, -1)

	// Assertions
	assert.NoError(suite.T(), err)
	
	// Check CORS headers are set for preflight
	assert.Contains(suite.T(), resp.Header, "Access-Control-Allow-Origin")
	assert.Contains(suite.T(), resp.Header, "Access-Control-Allow-Methods")
	assert.Contains(suite.T(), resp.Header, "Access-Control-Allow-Headers")
	assert.Contains(suite.T(), resp.Header, "Access-Control-Max-Age")
}

func (suite *MiddlewareTestSuite) TestSecurityMiddleware() {
	// Apply Security middleware
	suite.app.Use(middleware.Security())

	// Create a test route
	suite.app.Get("/test", func(c *fiber.Ctx) error {
		return c.SendString("test")
	})

	// Create request
	req, _ := http.NewRequest(http.MethodGet, "/test", nil)

	// Test
	resp, err := suite.app.Test(req, -1)

	// Assertions
	assert.NoError(suite.T(), err)
	assert.Equal(suite.T(), http.StatusOK, resp.StatusCode)
	
	// Check security headers are set
	assert.Contains(suite.T(), resp.Header, "X-Frame-Options")
	assert.Contains(suite.T(), resp.Header, "X-Content-Type-Options")
	assert.Contains(suite.T(), resp.Header, "X-Xss-Protection")
	assert.Contains(suite.T(), resp.Header, "Strict-Transport-Security")
