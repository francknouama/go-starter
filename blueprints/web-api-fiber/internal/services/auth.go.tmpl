// generateAuthResult creates tokens for OAuth authentication
func (s *AuthService) generateAuthResult(user *models.User) (*AuthResult, error) {
	// For OAuth, you might use different token generation logic
	// This is a placeholder implementation
	expiresAt := time.Now().Add(s.config.Auth.TokenExpiry)

	// Generate a simple token (in production, use proper token generation)
	token := fmt.Sprintf("oauth_token_%d_%d", user.ID, time.Now().Unix())

	return &AuthResult{
		Token:     token,
		ExpiresAt: expiresAt,
		User:      user,
	}, nil
}

{{- else}}
// generateAuthResult creates auth result for session-based auth
func (s *AuthService) generateAuthResult(user *models.User) (*AuthResult, error) {
	// For session-based auth, you might return a session ID
	expiresAt := time.Now().Add(24 * time.Hour) // Default session expiry

	// Generate session token (placeholder)
	token := fmt.Sprintf("session_%d_%d", user.ID, time.Now().Unix())

	return &AuthResult{
		Token:     token,
		ExpiresAt: expiresAt,
		User:      user,
	}, nil
}
