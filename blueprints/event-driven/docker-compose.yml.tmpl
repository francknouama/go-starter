version: '3.8'

services:
  {{.ProjectName}}:
    build:
      context: .
      dockerfile: Dockerfile
    ports:
      - "8080:8080"
    environment:
      - GO_ENV=development
      - LOG_LEVEL=info
{{- if eq .DatabaseType "postgres"}}
      - DB_HOST=postgres
      - DB_PORT=5432
      - DB_NAME={{.ProjectName}}_dev
      - DB_USER=postgres
      - DB_PASSWORD=password
{{- else if eq .DatabaseType "mongodb"}}
      - DB_HOST=mongodb
      - DB_PORT=27017
      - DB_NAME={{.ProjectName}}_dev
      - DB_USER=root
      - DB_PASSWORD=password
{{- else if eq .DatabaseType "mysql"}}
      - DB_HOST=mysql
      - DB_PORT=3306
      - DB_NAME={{.ProjectName}}_dev
      - DB_USER=root
      - DB_PASSWORD=password
{{- end}}
{{- if eq .MessageQueue "nats"}}
      - NATS_URL=nats://nats:4222
{{- else if eq .MessageQueue "redis"}}
      - REDIS_URL=redis://redis:6379
{{- else if eq .MessageQueue "kafka"}}
      - KAFKA_BROKERS=kafka:9092
{{- else if eq .MessageQueue "rabbitmq"}}
      - RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
{{- end}}
    depends_on:
{{- if eq .DatabaseType "postgres"}}
      - postgres
{{- else if eq .DatabaseType "mongodb"}}
      - mongodb
{{- else if eq .DatabaseType "mysql"}}
      - mysql
{{- end}}
{{- if eq .MessageQueue "nats"}}
      - nats
{{- else if eq .MessageQueue "redis"}}
      - redis
{{- else if eq .MessageQueue "kafka"}}
      - kafka
{{- else if eq .MessageQueue "rabbitmq"}}
      - rabbitmq
{{- end}}
    networks:
      - event-driven-network
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

{{- if eq .DatabaseType "postgres"}}
  postgres:
    image: postgres:15-alpine
    environment:
      POSTGRES_DB: {{.ProjectName}}_dev
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: password
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - event-driven-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d {{.ProjectName}}_dev"]
      interval: 10s
      timeout: 5s
      retries: 5
{{- else if eq .DatabaseType "mongodb"}}
  mongodb:
    image: mongo:7.0
    environment:
      MONGO_INITDB_ROOT_USERNAME: root
      MONGO_INITDB_ROOT_PASSWORD: password
      MONGO_INITDB_DATABASE: {{.ProjectName}}_dev
    ports:
      - "27017:27017"
    volumes:
      - mongodb_data:/data/db
    networks:
      - event-driven-network
    healthcheck:
      test: ["CMD", "mongosh", "--eval", "db.adminCommand('ping')"]
      interval: 10s
      timeout: 5s
      retries: 5
{{- else if eq .DatabaseType "mysql"}}
  mysql:
    image: mysql:8.0
    environment:
      MYSQL_ROOT_PASSWORD: password
      MYSQL_DATABASE: {{.ProjectName}}_dev
    ports:
      - "3306:3306"
    volumes:
      - mysql_data:/var/lib/mysql
    networks:
      - event-driven-network
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]
      interval: 10s
      timeout: 5s
      retries: 5
{{- end}}

{{- if eq .MessageQueue "nats"}}
  nats:
    image: nats:2.10-alpine
    ports:
      - "4222:4222"
    networks:
      - event-driven-network
    healthcheck:
      test: ["CMD", "nc", "-z", "localhost", "4222"]
      interval: 10s
      timeout: 5s
      retries: 5
{{- else if eq .MessageQueue "redis"}}
  redis:
    image: redis:7-alpine
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data
    networks:
      - event-driven-network
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
{{- else if eq .MessageQueue "kafka"}}
  zookeeper:
    image: confluentinc/cp-zookeeper:7.4.0
    environment:
      ZOOKEEPER_CLIENT_PORT: 2181
      ZOOKEEPER_TICK_TIME: 2000
    networks:
      - event-driven-network

  kafka:
    image: confluentinc/cp-kafka:7.4.0
    depends_on:
      - zookeeper
    ports:
      - "9092:9092"
    environment:
      KAFKA_BROKER_ID: 1
      KAFKA_ZOOKEEPER_CONNECT: zookeeper:2181
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://localhost:9092
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
    networks:
      - event-driven-network
    healthcheck:
      test: ["CMD", "kafka-broker-api-versions", "--bootstrap-server=localhost:9092"]
      interval: 10s
      timeout: 5s
      retries: 5
{{- else if eq .MessageQueue "rabbitmq"}}
  rabbitmq:
    image: rabbitmq:3.12-management-alpine
    ports:
      - "5672:5672"
      - "15672:15672"
    environment:
      RABBITMQ_DEFAULT_USER: guest
      RABBITMQ_DEFAULT_PASS: guest
    volumes:
      - rabbitmq_data:/var/lib/rabbitmq
    networks:
      - event-driven-network
    healthcheck:
      test: ["CMD", "rabbitmqctl", "status"]
      interval: 10s
      timeout: 5s
      retries: 5
{{- end}}

volumes:
{{- if eq .DatabaseType "postgres"}}
  postgres_data:
{{- else if eq .DatabaseType "mongodb"}}
  mongodb_data:
{{- else if eq .DatabaseType "mysql"}}
  mysql_data:
{{- end}}
{{- if eq .MessageQueue "redis"}}
  redis_data:
{{- else if eq .MessageQueue "rabbitmq"}}
  rabbitmq_data:
{{- end}}

networks:
  event-driven-network:
    driver: bridge