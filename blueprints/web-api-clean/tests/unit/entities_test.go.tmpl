func TestUser_NewUser(t *testing.T) {
	t.Run("NewUser_ValidData_Success", func(t *testing.T) {
		email := "john.doe@example.com"
		username := "johndoe"
		firstName := "John"
		lastName := "Doe"
		password := "StrongPass123!"

		user, err := entities.NewUser(email, username, firstName, lastName, password)

		require.NoError(t, err)
		assert.NotNil(t, user)
		assert.Equal(t, email, user.Email().Value())
		assert.Equal(t, username, user.Username())
		assert.Equal(t, firstName, user.FirstName())
		assert.Equal(t, lastName, user.LastName())
		assert.True(t, user.IsActive())
		assert.True(t, user.VerifyPassword(password))
		assert.NotEmpty(t, user.ID().Value())
		
		// Check that user creation event was added
		domainEvents := user.DomainEvents()
		assert.Len(t, domainEvents, 1)
		assert.Equal(t, "user.created", domainEvents[0].EventType())
	})

	t.Run("NewUser_InvalidEmail_Error", func(t *testing.T) {
		user, err := entities.NewUser("invalid-email", "johndoe", "John", "Doe", "StrongPass123!")
		
		assert.Error(t, err)
		assert.Nil(t, user)
	})

	t.Run("NewUser_WeakPassword_Error", func(t *testing.T) {
		user, err := entities.NewUser("john@example.com", "johndoe", "John", "Doe", "weak")
		
		assert.Error(t, err)
		assert.Nil(t, user)
	})

	t.Run("NewUser_InvalidUsername_Error", func(t *testing.T) {
		user, err := entities.NewUser("john@example.com", "", "John", "Doe", "StrongPass123!")
		
		assert.Error(t, err)
		assert.Nil(t, user)
	})
}

func TestUser_NewUserFromPersistence(t *testing.T) {
	t.Run("NewUserFromPersistence_ValidData_Success", func(t *testing.T) {
		id := "123e4567-e89b-12d3-a456-426614174000"
		email := "john@example.com"
		username := "johndoe"
		firstName := "John"
		lastName := "Doe"
		passwordHash := "$2a$10$N9qo8uLOickgx2ZMRZoMye6pYxYyHllSOHSzDi/ac.JSYeu8/H5.6" // Hash for "password"
		isActive := true
		createdAt := time.Now().Add(-24 * time.Hour)
		updatedAt := time.Now()

		user, err := entities.NewUserFromPersistence(id, email, username, firstName, lastName, passwordHash, isActive, createdAt, updatedAt)

		require.NoError(t, err)
		assert.NotNil(t, user)
		assert.Equal(t, id, user.ID().Value())
		assert.Equal(t, email, user.Email().Value())
		assert.Equal(t, username, user.Username())
		assert.Equal(t, firstName, user.FirstName())
		assert.Equal(t, lastName, user.LastName())
		assert.Equal(t, isActive, user.IsActive())
		assert.Equal(t, createdAt, user.CreatedAt())
		assert.Equal(t, updatedAt, user.UpdatedAt())
		
		// No domain events should be added when creating from persistence
		assert.Len(t, user.DomainEvents(), 0)
	})
}

func TestUser_GetFullName(t *testing.T) {
	t.Run("GetFullName_BothNames_ReturnsFullName", func(t *testing.T) {
		user, _ := entities.NewUser("john@example.com", "johndoe", "John", "Doe", "StrongPass123!")
		assert.Equal(t, "John Doe", user.GetFullName())
	})

	t.Run("GetFullName_FirstNameOnly_ReturnsFirstName", func(t *testing.T) {
		user, _ := entities.NewUser("john@example.com", "johndoe", "John", "", "StrongPass123!")
		assert.Equal(t, "John", user.GetFullName())
	})

	t.Run("GetFullName_LastNameOnly_ReturnsLastName", func(t *testing.T) {
		user, _ := entities.NewUser("john@example.com", "johndoe", "", "Doe", "StrongPass123!")
		assert.Equal(t, "Doe", user.GetFullName())
	})

	t.Run("GetFullName_NoNames_ReturnsUsername", func(t *testing.T) {
		user, _ := entities.NewUser("john@example.com", "johndoe", "", "", "StrongPass123!")
		assert.Equal(t, "johndoe", user.GetFullName())
	})

	t.Run("GetFullName_NamesWithSpaces_TrimsSpaces", func(t *testing.T) {
		user, _ := entities.NewUser("john@example.com", "johndoe", "  John  ", "  Doe  ", "StrongPass123!")
		assert.Equal(t, "John Doe", user.GetFullName())
	})
}

func TestUser_UpdateProfile(t *testing.T) {
	t.Run("UpdateProfile_ValidChanges_Success", func(t *testing.T) {
		user, _ := entities.NewUser("john@example.com", "johndoe", "John", "Doe", "StrongPass123!")
		user.ClearDomainEvents() // Clear creation event
		
		err := user.UpdateProfile("Jane", "Smith")
		
		require.NoError(t, err)
		assert.Equal(t, "Jane", user.FirstName())
		assert.Equal(t, "Smith", user.LastName())
		
		// Check that update event was added
		domainEvents := user.DomainEvents()
		assert.Len(t, domainEvents, 1)
		
		updateEvent, ok := domainEvents[0].(*events.UserUpdatedEvent)
		assert.True(t, ok)
		assert.Equal(t, "user.updated", updateEvent.EventType())
		assert.NotEmpty(t, updateEvent.Changes)
	})

	t.Run("UpdateProfile_NoChanges_NoEvent", func(t *testing.T) {
		user, _ := entities.NewUser("john@example.com", "johndoe", "John", "Doe", "StrongPass123!")
		user.ClearDomainEvents() // Clear creation event
		
		err := user.UpdateProfile("John", "Doe") // Same values
		
		require.NoError(t, err)
		assert.Len(t, user.DomainEvents(), 0) // No events should be added
	})

	t.Run("UpdateProfile_InvalidName_Error", func(t *testing.T) {
		user, _ := entities.NewUser("john@example.com", "johndoe", "John", "Doe", "StrongPass123!")
		
		// Try to set a name that's too long
		longName := make([]rune, 101)
		for i := range longName {
			longName[i] = 'a'
		}
		
		err := user.UpdateProfile(string(longName), "Doe")
		
		assert.Error(t, err)
		assert.Equal(t, entities.ErrNameTooLong, err)
	})
}

