}

func TestUser_ChangePassword(t *testing.T) {
	t.Run("ChangePassword_ValidPassword_Success", func(t *testing.T) {
		user, _ := entities.NewUser("john@example.com", "johndoe", "John", "Doe", "StrongPass123!")
		user.ClearDomainEvents() // Clear creation event
		
		newPassword := "NewStrongPass456!"
		err := user.ChangePassword(newPassword)
		
		require.NoError(t, err)
		assert.True(t, user.VerifyPassword(newPassword))
		assert.False(t, user.VerifyPassword("StrongPass123!")) // Old password should not work
		
		// Check that password change event was added
		domainEvents := user.DomainEvents()
		assert.Len(t, domainEvents, 1)
		assert.Equal(t, "user.password_changed", domainEvents[0].EventType())
	})

	t.Run("ChangePassword_WeakPassword_Error", func(t *testing.T) {
		user, _ := entities.NewUser("john@example.com", "johndoe", "John", "Doe", "StrongPass123!")
		
		err := user.ChangePassword("weak")
		
		assert.Error(t, err)
		assert.True(t, user.VerifyPassword("StrongPass123!")) // Old password should still work
	})
}

func TestUser_Activate(t *testing.T) {
	t.Run("Activate_InactiveUser_Success", func(t *testing.T) {
		user, _ := entities.NewUser("john@example.com", "johndoe", "John", "Doe", "StrongPass123!")
		user.Deactivate("test") // First deactivate
		user.ClearDomainEvents() // Clear previous events
		
		err := user.Activate()
		
		require.NoError(t, err)
		assert.True(t, user.IsActive())
		
		// Check that activation event was added
		domainEvents := user.DomainEvents()
		assert.Len(t, domainEvents, 1)
		assert.Equal(t, "user.activated", domainEvents[0].EventType())
	})

	t.Run("Activate_ActiveUser_Error", func(t *testing.T) {
		user, _ := entities.NewUser("john@example.com", "johndoe", "John", "Doe", "StrongPass123!")
		// User is already active by default
		
		err := user.Activate()
		
		assert.Error(t, err)
		assert.Equal(t, entities.ErrUserAlreadyActive, err)
	})
}

func TestUser_Deactivate(t *testing.T) {
	t.Run("Deactivate_ActiveUser_Success", func(t *testing.T) {
		user, _ := entities.NewUser("john@example.com", "johndoe", "John", "Doe", "StrongPass123!")
		user.ClearDomainEvents() // Clear creation event
		
		reason := "Account suspended"
		err := user.Deactivate(reason)
		
		require.NoError(t, err)
		assert.False(t, user.IsActive())
		
		// Check that deactivation event was added
		domainEvents := user.DomainEvents()
		assert.Len(t, domainEvents, 1)
		
		deactivateEvent, ok := domainEvents[0].(*events.UserDeactivatedEvent)
		assert.True(t, ok)
		assert.Equal(t, "user.deactivated", deactivateEvent.EventType())
		assert.Equal(t, reason, deactivateEvent.Reason)
	})

	t.Run("Deactivate_InactiveUser_Error", func(t *testing.T) {
		user, _ := entities.NewUser("john@example.com", "johndoe", "John", "Doe", "StrongPass123!")
		user.Deactivate("first time") // First deactivate
		
		err := user.Deactivate("second time") // Try to deactivate again
		
		assert.Error(t, err)
		assert.Equal(t, entities.ErrUserAlreadyInactive, err)
	})
}

func TestUser_Equals(t *testing.T) {
	t.Run("Equals_SameUser_True", func(t *testing.T) {
		user1, _ := entities.NewUser("john@example.com", "johndoe", "John", "Doe", "StrongPass123!")
		
		assert.True(t, user1.Equals(user1))
	})

	t.Run("Equals_DifferentUsers_False", func(t *testing.T) {
		user1, _ := entities.NewUser("john@example.com", "johndoe", "John", "Doe", "StrongPass123!")
		user2, _ := entities.NewUser("jane@example.com", "janedoe", "Jane", "Doe", "StrongPass123!")
		
		assert.False(t, user1.Equals(user2))
	})

	t.Run("Equals_NilUser_False", func(t *testing.T) {
		user1, _ := entities.NewUser("john@example.com", "johndoe", "John", "Doe", "StrongPass123!")
		
		assert.False(t, user1.Equals(nil))
	})
}

func TestUser_DomainEvents(t *testing.T) {
	t.Run("DomainEvents_NewUser_HasCreationEvent", func(t *testing.T) {
		user, _ := entities.NewUser("john@example.com", "johndoe", "John", "Doe", "StrongPass123!")
		
		events := user.DomainEvents()
		assert.Len(t, events, 1)
		assert.Equal(t, "user.created", events[0].EventType())
	})

	t.Run("DomainEvents_ClearEvents_RemovesAllEvents", func(t *testing.T) {
		user, _ := entities.NewUser("john@example.com", "johndoe", "John", "Doe", "StrongPass123!")
		assert.Len(t, user.DomainEvents(), 1)
		
		user.ClearDomainEvents()
		
		assert.Len(t, user.DomainEvents(), 0)
	})

	t.Run("DomainEvents_MultipleActions_AccumulatesEvents", func(t *testing.T) {
		user, _ := entities.NewUser("john@example.com", "johndoe", "John", "Doe", "StrongPass123!")
		user.ClearDomainEvents()
		
		// Perform multiple actions that generate events
		user.UpdateProfile("Jane", "Smith")
		user.ChangeEmail("jane@example.com")
		user.ChangePassword("NewPassword123!")
		
		events := user.DomainEvents()
		assert.Len(t, events, 3)
		
		eventTypes := make([]string, len(events))
		for i, event := range events {
			eventTypes[i] = event.EventType()
		}
		
		assert.Contains(t, eventTypes, "user.updated")
		assert.Contains(t, eventTypes, "user.email_changed")
		assert.Contains(t, eventTypes, "user.password_changed")
	})
}
