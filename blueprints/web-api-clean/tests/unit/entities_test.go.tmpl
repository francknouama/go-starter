	})

	t.Run("ChangeEmail_InvalidEmail_Error", func(t *testing.T) {
		user, _ := entities.NewUser("john@example.com", "johndoe", "John", "Doe", "StrongPass123!")
		
		err := user.ChangeEmail("invalid-email")
		
