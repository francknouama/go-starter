func TestAuthEvents(t *testing.T) {
	t.Run("NewUserLoggedInEvent_WithContext_Success", func(t *testing.T) {
		userID := valueobjects.NewRandomUserID()
		email, _ := valueobjects.NewEmail("test@example.com")
		ipAddress := "192.168.1.1"
		userAgent := "Mozilla/5.0 (Test Browser)"
		sessionID := "session-123"

		event := events.NewUserLoggedInEvent(*userID, *email, ipAddress, userAgent, sessionID)

		assert.NotNil(t, event)
		assert.Equal(t, "user.logged_in", event.EventType())
		assert.Equal(t, userID.Value(), event.AggregateID())
		assert.Equal(t, ipAddress, event.IPAddress)
		assert.Equal(t, userAgent, event.UserAgent)
		assert.Equal(t, sessionID, event.SessionID)
	})

	t.Run("NewUserLoggedOutEvent_WithReason_Success", func(t *testing.T) {
		userID := valueobjects.NewRandomUserID()
		email, _ := valueobjects.NewEmail("test@example.com")
		sessionID := "session-123"
		reason := "voluntary"

		event := events.NewUserLoggedOutEvent(*userID, *email, sessionID, reason)

		assert.NotNil(t, event)
		assert.Equal(t, "user.logged_out", event.EventType())
		assert.Equal(t, userID.Value(), event.AggregateID())
		assert.Equal(t, sessionID, event.SessionID)
		assert.Equal(t, reason, event.Reason)
	})

	t.Run("NewLoginFailedEvent_WithDetails_Success", func(t *testing.T) {
		email := "test@example.com"
		ipAddress := "192.168.1.1"
		userAgent := "Mozilla/5.0 (Test Browser)"
		reason := "invalid_credentials"
		attemptCount := 3

		event := events.NewLoginFailedEvent(email, ipAddress, userAgent, reason, attemptCount)

		assert.NotNil(t, event)
		assert.Equal(t, "auth.login_failed", event.EventType())
		assert.Equal(t, email, event.AggregateID()) // Email used as aggregate ID for failed attempts
		assert.Equal(t, email, event.Email)
		assert.Equal(t, reason, event.Reason)
		assert.Equal(t, attemptCount, event.AttemptCount)
	})

	t.Run("NewTokenGeneratedEvent_WithExpiry_Success", func(t *testing.T) {
		userID := valueobjects.NewRandomUserID()
		email, _ := valueobjects.NewEmail("test@example.com")
		tokenType := "access"
		expiresAt := time.Now().Add(time.Hour)

		event := events.NewTokenGeneratedEvent(*userID, *email, tokenType, expiresAt, "192.168.1.1", "Test Agent")

		assert.NotNil(t, event)
		assert.Equal(t, "auth.token_generated", event.EventType())
		assert.Equal(t, userID.Value(), event.AggregateID())
		assert.Equal(t, tokenType, event.TokenType)
		assert.WithinDuration(t, expiresAt, event.ExpiresAt, time.Second)
	})

	t.Run("NewPasswordResetRequestedEvent_WithContext_Success", func(t *testing.T) {
		userID := valueobjects.NewRandomUserID()
		email, _ := valueobjects.NewEmail("test@example.com")
		ipAddress := "192.168.1.1"
		userAgent := "Mozilla/5.0 (Test Browser)"

		event := events.NewPasswordResetRequestedEvent(*userID, *email, ipAddress, userAgent)

		assert.NotNil(t, event)
		assert.Equal(t, "auth.password_reset_requested", event.EventType())
		assert.Equal(t, userID.Value(), event.AggregateID())
		assert.Equal(t, ipAddress, event.IPAddress)
		assert.Equal(t, userAgent, event.UserAgent)
	})

	t.Run("NewAccountLockedEvent_WithFailureCount_Success", func(t *testing.T) {
		userID := valueobjects.NewRandomUserID()
		email, _ := valueobjects.NewEmail("test@example.com")
		reason := "too_many_failed_attempts"
		failedAttempts := 5
		lockExpiresAt := time.Now().Add(30 * time.Minute)

		event := events.NewAccountLockedEvent(*userID, *email, reason, failedAttempts, lockExpiresAt)

		assert.NotNil(t, event)
		assert.Equal(t, "auth.account_locked", event.EventType())
		assert.Equal(t, userID.Value(), event.AggregateID())
		assert.Equal(t, reason, event.Reason)
		assert.Equal(t, failedAttempts, event.FailedAttempts)
		assert.WithinDuration(t, lockExpiresAt, event.LockExpiresAt, time.Second)
	})
}

