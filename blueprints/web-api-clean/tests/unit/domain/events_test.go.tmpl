func TestEventSerialization(t *testing.T) {
	t.Run("AllEvents_CanBeSerializedToJSON", func(t *testing.T) {
		userID := valueobjects.NewRandomUserID()
		email, _ := valueobjects.NewEmail("test@example.com")
		
		// Test different event types
		events := []events.DomainEvent{
			events.NewUserCreatedEvent(*userID, *email, "test", "John", "Doe"),
			events.NewUserUpdatedEvent(*userID, *email, "test", "John", "Doe", map[string]interface{}{"field": "value"}),
			events.NewUserDeletedEvent(*userID, *email, "test", "deleted"),
			events.NewUserActivatedEvent(*userID, *email),
			events.NewUserDeactivatedEvent(*userID, *email, "suspended"),
			events.NewUserLoggedInEvent(*userID, *email, "192.168.1.1", "Mozilla", "session-1"),
			events.NewLoginFailedEvent("test@example.com", "192.168.1.1", "Mozilla", "invalid_credentials", 1),
		}

		for _, event := range events {
			jsonData, err := json.Marshal(event)
			assert.NoError(t, err, "Event %s should be serializable", event.EventType())
			assert.NotEmpty(t, jsonData, "JSON data should not be empty for event %s", event.EventType())
			
			// Verify JSON contains expected fields
			var jsonMap map[string]interface{}
			err = json.Unmarshal(jsonData, &jsonMap)
			assert.NoError(t, err, "Should be able to unmarshal JSON for event %s", event.EventType())
			assert.Contains(t, jsonMap, "id", "Event %s should have id field", event.EventType())
			assert.Contains(t, jsonMap, "type", "Event %s should have type field", event.EventType())
			assert.Contains(t, jsonMap, "occurred_at", "Event %s should have occurred_at field", event.EventType())
		}
	})
}