func TestUserCreatedEvent(t *testing.T) {
	t.Run("NewUserCreatedEvent_ValidData_Success", func(t *testing.T) {
		userID := valueobjects.NewRandomUserID()
		email, _ := valueobjects.NewEmail("test@example.com")
		username := "testuser"
		firstName := "John"
		lastName := "Doe"

		event := events.NewUserCreatedEvent(*userID, *email, username, firstName, lastName)

		assert.NotNil(t, event)
		assert.Equal(t, "user.created", event.EventType())
		assert.Equal(t, userID.Value(), event.AggregateID())
		assert.Equal(t, 1, event.EventVersion())
		assert.NotEmpty(t, event.EventID())
		assert.WithinDuration(t, time.Now().UTC(), event.OccurredAt(), time.Second)
		
		// Check event-specific data
		assert.True(t, event.UserID.Equals(*userID))
		assert.True(t, event.Email.Equals(*email))
		assert.Equal(t, username, event.Username)
		assert.Equal(t, firstName, event.FirstName)
		assert.Equal(t, lastName, event.LastName)
	})

	t.Run("UserCreatedEvent_JSON_MarshalUnmarshal", func(t *testing.T) {
		userID := valueobjects.NewRandomUserID()
		email, _ := valueobjects.NewEmail("test@example.com")
		originalEvent := events.NewUserCreatedEvent(*userID, *email, "testuser", "John", "Doe")

		// Marshal to JSON
		jsonData, err := json.Marshal(originalEvent)
		require.NoError(t, err)

		// Unmarshal from JSON
		var unmarshaledEvent events.UserCreatedEvent
		err = json.Unmarshal(jsonData, &unmarshaledEvent)
		require.NoError(t, err)

		assert.Equal(t, originalEvent.EventID(), unmarshaledEvent.EventID())
		assert.Equal(t, originalEvent.EventType(), unmarshaledEvent.EventType())
		assert.Equal(t, originalEvent.AggregateID(), unmarshaledEvent.AggregateID())
		assert.True(t, originalEvent.UserID.Equals(unmarshaledEvent.UserID))
		assert.True(t, originalEvent.Email.Equals(unmarshaledEvent.Email))
	})
}

func TestUserUpdatedEvent(t *testing.T) {
