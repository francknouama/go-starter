}

// LoginFailedEvent is raised when a login attempt fails
type LoginFailedEvent struct {
	BaseEvent
	Email       string `json:"email"`
	IPAddress   string `json:"ip_address,omitempty"`
	UserAgent   string `json:"user_agent,omitempty"`
	Reason      string `json:"reason"` // invalid_credentials, account_locked, etc.
	AttemptCount int   `json:"attempt_count,omitempty"`
}

// NewLoginFailedEvent creates a new LoginFailedEvent
func NewLoginFailedEvent(email, ipAddress, userAgent, reason string, attemptCount int) *LoginFailedEvent {
	return &LoginFailedEvent{
		BaseEvent: BaseEvent{
			ID:          generateEventID(),
			Type:        "auth.login_failed",
			OccurredOn:  time.Now().UTC(),
			Version:     1,
			AggregateId: email, // Use email as aggregate ID for failed attempts
		},
		Email:       email,
		IPAddress:   ipAddress,
		UserAgent:   userAgent,
		Reason:      reason,
		AttemptCount: attemptCount,
	}
}

