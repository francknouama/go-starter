package events

import (
	"time"

	"{{.ModulePath}}/internal/domain/valueobjects"
)

// UserLoggedInEvent is raised when a user successfully logs in
type UserLoggedInEvent struct {
	BaseEvent
	UserID    valueobjects.UserID `json:"user_id"`
	Email     valueobjects.Email  `json:"email"`
	IPAddress string              `json:"ip_address,omitempty"`
	UserAgent string              `json:"user_agent,omitempty"`
	SessionID string              `json:"session_id,omitempty"`
}

// NewUserLoggedInEvent creates a new UserLoggedInEvent
func NewUserLoggedInEvent(userID valueobjects.UserID, email valueobjects.Email, ipAddress, userAgent, sessionID string) *UserLoggedInEvent {
	return &UserLoggedInEvent{
		BaseEvent: BaseEvent{
			ID:          generateEventID(),
			Type:        "user.logged_in",
			OccurredOn:  time.Now().UTC(),
			Version:     1,
			AggregateId: userID.Value(),
		},
		UserID:    userID,
		Email:     email,
		IPAddress: ipAddress,
		UserAgent: userAgent,
		SessionID: sessionID,
	}
}

// UserLoggedOutEvent is raised when a user logs out
type UserLoggedOutEvent struct {
