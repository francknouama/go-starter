package valueobjects

import (
	"crypto/rand"
	"crypto/subtle"
	"errors"
	"regexp"
	"strings"

	"golang.org/x/crypto/bcrypt"
)

// Password represents a secure password with validation rules
// This is an immutable value object that encapsulates password security logic
type Password struct {
	hashedValue string
	isHashed    bool
}

// Domain errors for Password value object
var (
	ErrPasswordTooShort     = errors.New("password must be at least 8 characters long")
	ErrPasswordTooLong      = errors.New("password must be less than 128 characters long")
	ErrPasswordTooWeak      = errors.New("password must contain at least one uppercase, one lowercase, one digit, and one special character")
	ErrEmptyPassword        = errors.New("password cannot be empty")
	ErrPasswordOnlySpaces   = errors.New("password cannot contain only spaces")
	ErrInvalidHashedPassword = errors.New("invalid hashed password format")
)

// Password strength regex patterns
var (
	uppercaseRegex = regexp.MustCompile(`[A-Z]`)
	lowercaseRegex = regexp.MustCompile(`[a-z]`)
	digitRegex     = regexp.MustCompile(`[0-9]`)
	specialRegex   = regexp.MustCompile(`[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]`)
)

// NewPassword creates a new Password from a plain text string
func NewPassword(plaintext string) (*Password, error) {
	if err := validatePasswordStrength(plaintext); err != nil {
		return nil, err
	}

	// Hash the password using bcrypt with default cost
	hashedBytes, err := bcrypt.GenerateFromPassword([]byte(plaintext), bcrypt.DefaultCost)
	if err != nil {
		return nil, err
	}

	return &Password{
		hashedValue: string(hashedBytes),
		isHashed:    true,
	}, nil
}

// NewPasswordFromHash creates a Password from an already hashed value
// This is used when loading from database
func NewPasswordFromHash(hashedValue string) (*Password, error) {
	if strings.TrimSpace(hashedValue) == "" {
		return nil, ErrEmptyPassword
	}

	// Basic validation that it looks like a bcrypt hash
	if !strings.HasPrefix(hashedValue, "$2") {
		return nil, ErrInvalidHashedPassword
	}

	return &Password{
		hashedValue: hashedValue,
		isHashed:    true,
	}, nil
}

// GenerateRandomPassword generates a cryptographically secure random password
func GenerateRandomPassword(length int) (*Password, error) {
	if length < 8 {
		length = 12 // Default secure length
	}
	if length > 128 {
		length = 128 // Maximum allowed length
	}

	// Character sets for password generation
	lowercase := "abcdefghijklmnopqrstuvwxyz"
	uppercase := "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
	digits := "0123456789"
	special := "!@#$%^&*()_+-=[]{}|;:,.<>?"
	allChars := lowercase + uppercase + digits + special

	password := make([]byte, length)
	
	// Ensure at least one character from each required set
	password[0] = lowercase[randomInt(len(lowercase))]
	password[1] = uppercase[randomInt(len(uppercase))]
	password[2] = digits[randomInt(len(digits))]
	password[3] = special[randomInt(len(special))]

	// Fill the rest with random characters from all sets
	for i := 4; i < length; i++ {
		password[i] = allChars[randomInt(len(allChars))]
	}

	// Shuffle the password to avoid predictable pattern
	for i := range password {
		j := randomInt(len(password))
		password[i], password[j] = password[j], password[i]
	}

	return NewPassword(string(password))
}

// Hash returns the hashed value of the password
func (p Password) Hash() string {
	return p.hashedValue
}

// Verify checks if the provided plaintext matches the hashed password
func (p Password) Verify(plaintext string) bool {
	if !p.isHashed {
		return false
	}

	err := bcrypt.CompareHashAndPassword([]byte(p.hashedValue), []byte(plaintext))
	return err == nil
}

// Equals compares two passwords using constant-time comparison
func (p Password) Equals(other Password) bool {
	return subtle.ConstantTimeCompare([]byte(p.hashedValue), []byte(other.hashedValue)) == 1
}

// IsEmpty checks if the password is empty
func (p Password) IsEmpty() bool {
	return p.hashedValue == ""
}

// validatePasswordStrength validates password according to security requirements
func validatePasswordStrength(password string) error {
	if password == "" {
		return ErrEmptyPassword
	}

	trimmed := strings.TrimSpace(password)
	if trimmed == "" {
		return ErrPasswordOnlySpaces
	}

	if len(password) < 8 {
		return ErrPasswordTooShort
	}

	if len(password) > 128 {
		return ErrPasswordTooLong
	}

	// Check for required character types
	if !uppercaseRegex.MatchString(password) ||
		!lowercaseRegex.MatchString(password) ||
		!digitRegex.MatchString(password) ||
		!specialRegex.MatchString(password) {
		return ErrPasswordTooWeak
	}

	return nil
}

// randomInt generates a cryptographically secure random integer in range [0, max)
func randomInt(max int) int {
	if max <= 0 {
		return 0
	}

	// Calculate number of bytes needed
	bytes := make([]byte, 4)
	_, err := rand.Read(bytes)
	if err != nil {
		// Fallback to less secure method if crypto/rand fails
		return 0
	}

	// Convert bytes to int and mod by max
	result := int(bytes[0])<<24 | int(bytes[1])<<16 | int(bytes[2])<<8 | int(bytes[3])
	if result < 0 {
		result = -result
	}

	return result % max
}

// MarshalJSON implements json.Marshaler interface
// Note: Never marshal the actual password hash for security
func (p Password) MarshalJSON() ([]byte, error) {
	return []byte(`"[REDACTED]"`), nil
}

// UnmarshalJSON implements json.Unmarshaler interface
// This should only be used for already hashed passwords from trusted sources
func (p *Password) UnmarshalJSON(data []byte) error {
	// Remove quotes from JSON string
	value := strings.Trim(string(data), `"`)
	
	if value == "[REDACTED]" {
		return errors.New("cannot unmarshal redacted password")
	}
	
	// Assume this is a hashed password from database
	newPassword, err := NewPasswordFromHash(value)
	if err != nil {
		return err
	}
	
	*p = *newPassword
	return nil
}