apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: {{.ProjectName}}-hpa
  namespace: {{if .EnableServiceMesh}}{{.ServiceMesh.Namespace}}{{else}}default{{end}}
  labels:
    app: {{.ProjectName}}
    component: autoscaler
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: {{.ProjectName}}
  minReplicas: {{if eq .Environment "production"}}3{{else}}2{{end}}
  maxReplicas: {{if eq .Environment "production"}}20{{else}}10{{end}}
  metrics:
  # CPU-based scaling
  - type: Resource
    resource:
      name: cpu
      target:
        type: Utilization
        averageUtilization: 70
  # Memory-based scaling
  - type: Resource
    resource:
      name: memory
      target:
        type: Utilization
        averageUtilization: 80
{{if .EnableObservability}}
  # Custom metrics-based scaling
  - type: Pods
    pods:
      metric:
        name: {{.ProjectName | replace "-" "_"}}_{{if eq .CommunicationProtocol "grpc"}}grpc{{else}}http{{end}}_requests_per_second
      target:
        type: AverageValue
        averageValue: "30"
{{end}}
  # Scale down behavior
  behavior:
    scaleDown:
      stabilizationWindowSeconds: 300
      policies:
      - type: Percent
        value: 10
        periodSeconds: 60
      - type: Pods
        value: 2
        periodSeconds: 60
      selectPolicy: Min
    scaleUp:
      stabilizationWindowSeconds: 0
      policies:
      - type: Percent
        value: 50
        periodSeconds: 15
      - type: Pods
        value: 4
        periodSeconds: 15
      selectPolicy: Max