{{else}}
	logger *slog.Logger,
{{end}}
) grpc.StreamServerInterceptor {
	return func(srv interface{}, stream grpc.ServerStream, info *grpc.StreamServerInfo, handler grpc.StreamHandler) error {
		start := time.Now()
		
		// Extract client information
		clientIP := "unknown"
		if peer, ok := peer.FromContext(stream.Context()); ok {
			clientIP = peer.Addr.String()
		}

		err := handler(srv, stream)

		duration := time.Since(start)
		status := "success"
		if err != nil {
			status = "error"
		}

{{if eq .LoggerType "zap"}}
		logger.Info("gRPC stream request",
			zap.String("method", info.FullMethod),
			zap.String("client_ip", clientIP),
			zap.String("status", status),
			zap.Duration("duration", duration),
			zap.Error(err))
{{else if eq .LoggerType "logrus"}}
		logger.WithFields(logrus.Fields{
			"method":    info.FullMethod,
			"client_ip": clientIP,
			"status":    status,
			"duration":  duration,
		}).Info("gRPC stream request")
		if err != nil {
			logger.WithError(err).Error("gRPC stream request error")
		}
{{else if eq .LoggerType "zerolog"}}
		logger.Info().
			Str("method", info.FullMethod).
			Str("client_ip", clientIP).
			Str("status", status).
			Dur("duration", duration).
			Err(err).
			Msg("gRPC stream request")
{{else}}
		logger.Info("gRPC stream request",
			"method", info.FullMethod,
			"client_ip", clientIP,
			"status", status,
			"duration", duration,
			"error", err)
{{end}}

		return err
	}
}

