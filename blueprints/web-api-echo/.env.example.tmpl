# Environment Configuration
ENVIRONMENT=development

# Server Configuration
{{upper .ProjectName}}_SERVER_PORT=8080
{{upper .ProjectName}}_SERVER_HOST=

{{- if ne .DatabaseDriver ""}}

# Database Configuration
{{- if eq .DatabaseDriver "postgres"}}
{{upper .ProjectName}}_DATABASE_HOST=localhost
{{upper .ProjectName}}_DATABASE_PORT=5432
{{upper .ProjectName}}_DATABASE_NAME={{.ProjectName}}_dev
{{upper .ProjectName}}_DATABASE_USER={{.ProjectName}}
{{upper .ProjectName}}_DATABASE_PASSWORD=password
{{upper .ProjectName}}_DATABASE_SSL_MODE=disable
{{- else if eq .DatabaseDriver "mysql"}}
{{upper .ProjectName}}_DATABASE_HOST=localhost
{{upper .ProjectName}}_DATABASE_PORT=3306
{{upper .ProjectName}}_DATABASE_NAME={{.ProjectName}}_dev
{{upper .ProjectName}}_DATABASE_USER={{.ProjectName}}
{{upper .ProjectName}}_DATABASE_PASSWORD=password
{{- else if eq .DatabaseDriver "sqlite"}}
{{upper .ProjectName}}_DATABASE_NAME={{.ProjectName}}_dev.db
{{- end}}
{{- end}}

{{- if eq .AuthType "jwt"}}

# JWT Configuration
{{upper .ProjectName}}_JWT_SECRET=your-secret-key-change-in-production
{{upper .ProjectName}}_JWT_EXPIRATION=24h
{{upper .ProjectName}}_JWT_ISSUER={{.ProjectName}}
{{- end}}

# Logging Configuration
{{upper .ProjectName}}_LOGGING_LEVEL=debug
{{upper .ProjectName}}_LOGGING_FORMAT=json

{{- if .EnableMetrics}}

# Metrics Configuration
{{upper .ProjectName}}_METRICS_ENABLED=true
{{upper .ProjectName}}_METRICS_PORT=9090
{{- end}}

{{- if .EnableTracing}}

# Tracing Configuration
{{upper .ProjectName}}_TRACING_ENABLED=true
{{upper .ProjectName}}_TRACING_SERVICE_NAME={{.ProjectName}}-dev
{{upper .ProjectName}}_TRACING_ENDPOINT=http://localhost:14268/api/traces
{{upper .ProjectName}}_TRACING_SAMPLE_RATE=1.0
{{- end}}