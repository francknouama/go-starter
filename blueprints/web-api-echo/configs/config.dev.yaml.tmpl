environment: development

server:
  port: 8080
  host: ""
  read_timeout: 30s
  write_timeout: 30s
  idle_timeout: 60s
  tls:
    enabled: false

{{- if ne .DatabaseDriver ""}}
database:
{{- if eq .DatabaseDriver "postgres"}}
  host: localhost
  port: 5432
  name: {{.ProjectName}}_dev
  user: {{.ProjectName}}
  password: password
  ssl_mode: disable
{{- else if eq .DatabaseDriver "mysql"}}
  host: localhost
  port: 3306
  name: {{.ProjectName}}_dev
  user: {{.ProjectName}}
  password: password
  charset: utf8mb4
{{- else if eq .DatabaseDriver "sqlite"}}
  name: {{.ProjectName}}_dev.db
{{- end}}
  max_idle_conns: 10
  max_open_conns: 100
  conn_max_lifetime: 1h
  log_level: debug
{{- end}}

{{- if eq .AuthType "jwt"}}
jwt:
  secret: "dev-secret-key-change-in-production"
  expiration: 24h
  issuer: {{.ProjectName}}
  algorithm: HS256
{{- end}}

logging:
  level: debug
  format: json
  structured: true
  output: stdout

{{- if .EnableMetrics}}
metrics:
  enabled: true
  port: 9090
  path: /metrics
{{- end}}

{{- if .EnableTracing}}
tracing:
  enabled: true
  service_name: {{.ProjectName}}-dev
  endpoint: http://localhost:14268/api/traces
  sample_rate: 1.0
{{- end}}