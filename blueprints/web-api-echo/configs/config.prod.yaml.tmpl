environment: production

server:
  port: 8080
  host: ""
  read_timeout: 30s
  write_timeout: 30s
  idle_timeout: 120s
  tls:
    enabled: false
    cert_file: ""
    key_file: ""

{{- if ne .DatabaseDriver ""}}
database:
{{- if eq .DatabaseDriver "postgres"}}
  host: ${DB_HOST:localhost}
  port: ${DB_PORT:5432}
  name: ${DB_NAME:{{.ProjectName}}}
  user: ${DB_USER:{{.ProjectName}}}
  password: ${DB_PASSWORD:}
  ssl_mode: ${DB_SSL_MODE:require}
{{- else if eq .DatabaseDriver "mysql"}}
  host: ${DB_HOST:localhost}
  port: ${DB_PORT:3306}
  name: ${DB_NAME:{{.ProjectName}}}
  user: ${DB_USER:{{.ProjectName}}}
  password: ${DB_PASSWORD:}
  charset: utf8mb4
{{- else if eq .DatabaseDriver "sqlite"}}
  name: ${DB_NAME:{{.ProjectName}}.db}
{{- end}}
  max_idle_conns: 25
  max_open_conns: 200
  conn_max_lifetime: 5m
  log_level: warn
{{- end}}

{{- if eq .AuthType "jwt"}}
jwt:
  secret: ${JWT_SECRET:}
  expiration: ${JWT_EXPIRATION:24h}
  issuer: ${JWT_ISSUER:{{.ProjectName}}}
  algorithm: HS256
{{- end}}

logging:
  level: ${LOG_LEVEL:info}
  format: json
  structured: true
  output: stdout

{{- if .EnableMetrics}}
metrics:
  enabled: ${METRICS_ENABLED:true}
  port: ${METRICS_PORT:9090}
  path: /metrics
{{- end}}

{{- if .EnableTracing}}
tracing:
  enabled: ${TRACING_ENABLED:false}
  service_name: ${TRACING_SERVICE_NAME:{{.ProjectName}}}
  endpoint: ${TRACING_ENDPOINT:}
  sample_rate: ${TRACING_SAMPLE_RATE:0.1}
{{- end}}