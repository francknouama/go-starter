func (suite *MiddlewareTestSuite) TestRecoveryMiddleware() {
	// Create a test handler that panics
	handler := func(c echo.Context) error {
		panic("test panic")
	}

	// Create request
	req := httptest.NewRequest(http.MethodGet, "/test", nil)
	rec := httptest.NewRecorder()
	c := suite.echo.NewContext(req, rec)

	// Apply Recovery middleware
	recoveryMiddleware := middleware.Recovery()
	middlewareHandler := recoveryMiddleware(handler)

	// Test - should not panic
	assert.NotPanics(suite.T(), func() {
		err := middlewareHandler(c)
		// Recovery middleware typically returns an error or handles it internally
		_ = err
	})
}

// Run the test suite
func TestMiddlewareTestSuite(t *testing.T) {
	suite.Run(t, new(MiddlewareTestSuite))
}