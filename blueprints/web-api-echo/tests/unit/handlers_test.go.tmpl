// UserHandlerTestSuite tests the UserHandler
type UserHandlerTestSuite struct {
	suite.Suite
	echo        *echo.Echo
	mockService *MockUserService
	handler     *handlers.UserHandler
}

func (suite *UserHandlerTestSuite) SetupTest() {
	suite.echo = echo.New()
	suite.mockService = new(MockUserService)
	suite.handler = handlers.NewUserHandler(suite.mockService)
}

func (suite *UserHandlerTestSuite) TestGetUsers_Success() {
	// Setup mock data
	expectedUsers := []models.User{
		{ID: 1, Name: "User 1", Email: "user1@example.com", CreatedAt: time.Now()},
		{ID: 2, Name: "User 2", Email: "user2@example.com", CreatedAt: time.Now()},
	}
	expectedTotal := 2

	suite.mockService.On("GetUsers", 1, 10).Return(expectedUsers, expectedTotal, nil)

	// Create request
	req := httptest.NewRequest(http.MethodGet, "/api/v1/users?page=1&limit=10", nil)
	rec := httptest.NewRecorder()
	c := suite.echo.NewContext(req, rec)

	// Test
	err := suite.handler.GetUsers(c)

	// Assertions
	assert.NoError(suite.T(), err)
	assert.Equal(suite.T(), http.StatusOK, rec.Code)

	var response map[string]interface{}
	err = json.Unmarshal(rec.Body.Bytes(), &response)
	assert.NoError(suite.T(), err)
	assert.Equal(suite.T(), "success", response["status"])
	suite.mockService.AssertExpectations(suite.T())
}

func (suite *UserHandlerTestSuite) TestGetUser_Success() {
	// Setup mock data
	expectedUser := &models.User{
		ID:    1,
		Name:  "Test User",
		Email: "test@example.com",
	}

	suite.mockService.On("GetUserByID", uint(1)).Return(expectedUser, nil)

	// Create request
	req := httptest.NewRequest(http.MethodGet, "/api/v1/users/1", nil)
	rec := httptest.NewRecorder()
	c := suite.echo.NewContext(req, rec)
	c.SetPath("/api/v1/users/:id")
	c.SetParamNames("id")
	c.SetParamValues("1")

	// Test
	err := suite.handler.GetUser(c)

	// Assertions
	assert.NoError(suite.T(), err)
	assert.Equal(suite.T(), http.StatusOK, rec.Code)

	var response map[string]interface{}
	err = json.Unmarshal(rec.Body.Bytes(), &response)
	assert.NoError(suite.T(), err)
	assert.Equal(suite.T(), "success", response["status"])
	suite.mockService.AssertExpectations(suite.T())
}

func (suite *UserHandlerTestSuite) TestCreateUser_Success() {
	// Setup
	req := models.CreateUserRequest{
		Name:  "New User",
		Email: "newuser@example.com",
	}

	expectedUser := &models.User{
		ID:    1,
		Name:  req.Name,
		Email: req.Email,
	}

	suite.mockService.On("CreateUser", req).Return(expectedUser, nil)

	// Create request
	reqBody, _ := json.Marshal(req)
	httpReq := httptest.NewRequest(http.MethodPost, "/api/v1/users", bytes.NewReader(reqBody))
	httpReq.Header.Set("Content-Type", "application/json")
	rec := httptest.NewRecorder()
	c := suite.echo.NewContext(httpReq, rec)

	// Test
	err := suite.handler.CreateUser(c)

	// Assertions
	assert.NoError(suite.T(), err)
	assert.Equal(suite.T(), http.StatusCreated, rec.Code)

	var response map[string]interface{}
	err = json.Unmarshal(rec.Body.Bytes(), &response)
	assert.NoError(suite.T(), err)
	assert.Equal(suite.T(), "success", response["status"])
	suite.mockService.AssertExpectations(suite.T())
}

