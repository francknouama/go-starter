package middleware

import (
	"strconv"
	"time"

	"github.com/labstack/echo/v4"
	"github.com/prometheus/client_golang/prometheus"
	"github.com/prometheus/client_golang/prometheus/promauto"

	"{{.ModulePath}}/internal/logger"
)

var (
	// HTTP request metrics
	httpRequestsTotal = promauto.NewCounterVec(
		prometheus.CounterOpts{
			Name: "http_requests_total",
			Help: "Total number of HTTP requests",
		},
		[]string{"method", "endpoint", "status_code"},
	)

	httpRequestDuration = promauto.NewHistogramVec(
		prometheus.HistogramOpts{
			Name:    "http_request_duration_seconds",
			Help:    "HTTP request duration in seconds",
			Buckets: prometheus.DefBuckets,
		},
		[]string{"method", "endpoint", "status_code"},
	)

	httpRequestsInFlight = promauto.NewGauge(
		prometheus.GaugeOpts{
			Name: "http_requests_in_flight",
			Help: "Number of HTTP requests currently being processed",
		},
	)

	// Application metrics
	apiResponseSize = promauto.NewHistogramVec(
		prometheus.HistogramOpts{
			Name:    "api_response_size_bytes",
			Help:    "Size of HTTP responses in bytes",
			Buckets: []float64{100, 1000, 10000, 100000, 1000000},
		},
		[]string{"method", "endpoint"},
	)
)

// Metrics returns a Prometheus metrics middleware for Echo
func Metrics() echo.MiddlewareFunc {
	return func(next echo.HandlerFunc) echo.HandlerFunc {
		return func(c echo.Context) error {
			// Skip metrics for the metrics endpoint itself
			if c.Path() == "/metrics" {
				return next(c)
			}

			start := time.Now()
			
			// Increment in-flight requests
			httpRequestsInFlight.Inc()
			defer httpRequestsInFlight.Dec()

			// Process request
			err := next(c)

			// Calculate duration
			duration := time.Since(start).Seconds()
			
			// Get response details
			method := c.Request().Method
			endpoint := c.Path()
			statusCode := strconv.Itoa(c.Response().Status)
			responseSize := float64(c.Response().Size)

			// Record metrics
			httpRequestsTotal.WithLabelValues(method, endpoint, statusCode).Inc()
			httpRequestDuration.WithLabelValues(method, endpoint, statusCode).Observe(duration)
			apiResponseSize.WithLabelValues(method, endpoint).Observe(responseSize)

			// Log metrics (optional, for debugging)
			logger.Debug("Request metrics recorded",
				"method", method,
				"endpoint", endpoint,
				"status_code", statusCode,
				"duration_seconds", duration,
				"response_size_bytes", responseSize,
			)

			return err
		}
	}
}

// HealthMetrics returns a middleware specifically for health check metrics
func HealthMetrics() echo.MiddlewareFunc {
	healthCheckCounter := promauto.NewCounterVec(
		prometheus.CounterOpts{
			Name: "health_check_requests_total",
			Help: "Total number of health check requests",
		},
		[]string{"endpoint", "status"},
	)

	return func(next echo.HandlerFunc) echo.HandlerFunc {
		return func(c echo.Context) error {
			path := c.Path()
			
			// Only apply to health endpoints
			if path != "/health" && path != "/ready" {
				return next(c)
			}

			err := next(c)
			
			status := "success"
			if c.Response().Status >= 400 {
				status = "failure"
			}
			
			healthCheckCounter.WithLabelValues(path, status).Inc()
			
			return err
		}
	}
}

// CustomMetrics allows for application-specific metrics collection
type CustomMetrics struct {
	UserActions *prometheus.CounterVec
	ErrorRates  *prometheus.CounterVec
}

// NewCustomMetrics initializes custom application metrics
func NewCustomMetrics() *CustomMetrics {
	return &CustomMetrics{
		UserActions: promauto.NewCounterVec(
			prometheus.CounterOpts{
				Name: "user_actions_total",
				Help: "Total number of user actions",
			},
			[]string{"action", "user_id"},
		),
		ErrorRates: promauto.NewCounterVec(
			prometheus.CounterOpts{
				Name: "api_errors_total",
				Help: "Total number of API errors",
			},
			[]string{"endpoint", "error_type"},
		),
	}
}

// UserActionMetrics returns a middleware that tracks user actions
func UserActionMetrics(metrics *CustomMetrics) echo.MiddlewareFunc {
	return func(next echo.HandlerFunc) echo.HandlerFunc {
		return func(c echo.Context) error {
			err := next(c)
			
			// Extract user ID from context (set by auth middleware)
			userID := c.Get("user_id")
			if userID != nil {
				action := determineAction(c.Request().Method, c.Path())
				metrics.UserActions.WithLabelValues(action, userID.(string)).Inc()
			}
			
			return err
		}
	}
}

// determineAction maps HTTP method and path to a user action
func determineAction(method, path string) string {
	switch {
	case method == "POST" && path == "/api/v1/auth/login":
		return "login"
	case method == "POST" && path == "/api/v1/auth/register":
		return "register"
	case method == "POST" && path == "/api/v1/auth/logout":
		return "logout"
	case method == "GET" && path == "/api/v1/users":
		return "list_users"
	case method == "POST" && path == "/api/v1/users":
		return "create_user"
	case method == "PUT":
		return "update_user"
	case method == "DELETE":
		return "delete_user"
	default:
		return "unknown"
	}
}