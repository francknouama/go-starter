	var request RegisterRequest
	
	if err := c.Bind(&request); err != nil {
		logger.Error("Failed to bind register request", "error", err)
		return c.JSON(http.StatusBadRequest, map[string]string{
			"error": "Invalid request body",
		})
	}
	
	if err := c.Validate(&request); err != nil {
		logger.Error("Registration validation failed", "error", err)
		return c.JSON(http.StatusBadRequest, map[string]string{
			"error": "Validation failed",
		})
	}
	
	logger.Info("User registration attempt", "name", request.Name, "email", request.Email)
	
	// For now, return a simple response
	// In a real implementation, you would call h.authService.Register()
{{- if eq .AuthType "jwt"}}
	response := AuthResponse{
		Token: "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...", // Mock JWT token
		User: map[string]interface{}{
			"id":    2,
			"name":  request.Name,
			"email": request.Email,
		},
		Message: "Registration successful",
	}
{{- else if eq .AuthType "session"}}
	response := AuthResponse{
		SessionID: "session_987654321", // Mock session ID
		User: map[string]interface{}{
			"id":    2,
			"name":  request.Name,
			"email": request.Email,
		},
		Message: "Registration successful",
	}
{{- else}}
	response := AuthResponse{
		User: map[string]interface{}{
			"id":    2,
			"name":  request.Name,
			"email": request.Email,
		},
		Message: "Registration successful",
	}
{{- end}}
	
	return c.JSON(http.StatusCreated, response)
}

{{- if eq .AuthType "jwt"}}

// RefreshToken handles POST /auth/refresh
func (h *AuthHandler) RefreshToken(c echo.Context) error {
	var request struct {
		RefreshToken string `json:"refresh_token" validate:"required"`
	}
	
	if err := c.Bind(&request); err != nil {
		logger.Error("Failed to bind refresh token request", "error", err)
		return c.JSON(http.StatusBadRequest, map[string]string{
			"error": "Invalid request body",
		})
	}
	
	if err := c.Validate(&request); err != nil {
		logger.Error("Refresh token validation failed", "error", err)
		return c.JSON(http.StatusBadRequest, map[string]string{
			"error": "Validation failed",
		})
	}
	
	logger.Info("Token refresh attempt")
	
	// For now, return a simple response
	// In a real implementation, you would call h.authService.RefreshToken()
	response := map[string]interface{}{
		"token":         "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...", // Mock new JWT token
		"refresh_token": "new_refresh_token_123456789",                  // Mock new refresh token
		"message":       "Token refreshed successfully",
	}
	
	return c.JSON(http.StatusOK, response)
}

{{- end}}

