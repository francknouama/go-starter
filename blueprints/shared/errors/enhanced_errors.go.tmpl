// ErrorLogger provides structured logging for enhanced errors
type ErrorLogger struct {
{{if eq .Logger "zap"}}
	logger *zap.Logger
{{else if eq .Logger "logrus"}}
	logger *logrus.Logger
{{else if eq .Logger "zerolog"}}
	// zerolog uses global logger
{{else}}
	logger *slog.Logger
{{end}}
	service string
}

// NewErrorLogger creates a new error logger
func NewErrorLogger({{if eq .Logger "zap"}}logger *zap.Logger{{else if eq .Logger "logrus"}}logger *logrus.Logger{{else if eq .Logger "slog"}}logger *slog.Logger{{end}}, service string) *ErrorLogger {
	return &ErrorLogger{
{{if ne .Logger "zerolog"}}
		logger:  logger,
{{end}}
		service: service,
	}
}

// LogError logs an enhanced error with appropriate level based on severity
func (el *ErrorLogger) LogError(err *EnhancedError) {
	// Set service if not already set
	if err.Service == "" {
		err.Service = el.service
	}

{{if eq .Logger "zap"}}
	fields := []zap.Field{
		zap.String("error_type", string(err.Type)),
		zap.String("error_code", err.Code),
		zap.String("severity", string(err.Severity)),
		zap.Bool("retryable", err.Retryable),
		zap.String("service", err.Service),
		zap.String("operation", err.Operation),
		zap.Time("timestamp", err.Timestamp),
	}

	if err.RequestID != "" {
		fields = append(fields, zap.String("request_id", err.RequestID))
	}
	if err.UserID != "" {
		fields = append(fields, zap.String("user_id", err.UserID))
	}
	if err.TenantID != "" {
		fields = append(fields, zap.String("tenant_id", err.TenantID))
	}
	if err.Details != nil {
		fields = append(fields, zap.Any("details", err.Details))
	}
	if err.Tags != nil {
		fields = append(fields, zap.Any("tags", err.Tags))
	}
	if err.Metrics != nil {
		fields = append(fields, zap.Any("metrics", err.Metrics))
	}
	if err.Cause != nil {
		fields = append(fields, zap.Error(err.Cause))
	}

	switch err.Severity {
	case SeverityCritical:
		el.logger.Error(err.Message, fields...)
	case SeverityHigh:
		el.logger.Error(err.Message, fields...)
	case SeverityMedium:
		el.logger.Warn(err.Message, fields...)
	case SeverityLow:
		el.logger.Info(err.Message, fields...)
	default:
		el.logger.Error(err.Message, fields...)
	}

{{else if eq .Logger "logrus"}}
	fields := logrus.Fields{
		"error_type": string(err.Type),
		"error_code": err.Code,
		"severity":   string(err.Severity),
		"retryable":  err.Retryable,
		"service":    err.Service,
		"operation":  err.Operation,
		"timestamp":  err.Timestamp,
	}

	if err.RequestID != "" {
		fields["request_id"] = err.RequestID
	}
	if err.UserID != "" {
		fields["user_id"] = err.UserID
	}
	if err.TenantID != "" {
		fields["tenant_id"] = err.TenantID
	}
	if err.Details != nil {
		fields["details"] = err.Details
	}
	if err.Tags != nil {
		fields["tags"] = err.Tags
	}
	if err.Metrics != nil {
		fields["metrics"] = err.Metrics
	}

	logEntry := el.logger.WithFields(fields)
	if err.Cause != nil {
		logEntry = logEntry.WithError(err.Cause)
	}

	switch err.Severity {
	case SeverityCritical:
		logEntry.Error(err.Message)
	case SeverityHigh:
		logEntry.Error(err.Message)
	case SeverityMedium:
		logEntry.Warn(err.Message)
	case SeverityLow:
		logEntry.Info(err.Message)
	default:
		logEntry.Error(err.Message)
	}

{{else if eq .Logger "zerolog"}}
	event := log.Error()
	
	switch err.Severity {
	case SeverityCritical:
		event = log.Error()
	case SeverityHigh:
		event = log.Error()
	case SeverityMedium:
		event = log.Warn()
	case SeverityLow:
		event = log.Info()
	default:
		event = log.Error()
	}

	event = event.
		Str("error_type", string(err.Type)).
		Str("error_code", err.Code).
		Str("severity", string(err.Severity)).
		Bool("retryable", err.Retryable).
		Str("service", err.Service).
		Str("operation", err.Operation).
		Time("timestamp", err.Timestamp)

	if err.RequestID != "" {
		event = event.Str("request_id", err.RequestID)
	}
	if err.UserID != "" {
		event = event.Str("user_id", err.UserID)
	}
	if err.TenantID != "" {
		event = event.Str("tenant_id", err.TenantID)
	}
	if err.Details != nil {
		event = event.Interface("details", err.Details)
	}
	if err.Tags != nil {
		event = event.Interface("tags", err.Tags)
	}
	if err.Metrics != nil {
		event = event.Interface("metrics", err.Metrics)
	}
	if err.Cause != nil {
		event = event.Err(err.Cause)
	}

	event.Msg(err.Message)

{{else}}
	attrs := []any{
		"error_type", string(err.Type),
		"error_code", err.Code,
		"severity", string(err.Severity),
		"retryable", err.Retryable,
		"service", err.Service,
		"operation", err.Operation,
		"timestamp", err.Timestamp,
	}

	if err.RequestID != "" {
		attrs = append(attrs, "request_id", err.RequestID)
	}
	if err.UserID != "" {
		attrs = append(attrs, "user_id", err.UserID)
	}
	if err.TenantID != "" {
		attrs = append(attrs, "tenant_id", err.TenantID)
	}
	if err.Details != nil {
		attrs = append(attrs, "details", err.Details)
	}
	if err.Tags != nil {
		attrs = append(attrs, "tags", err.Tags)
	}
	if err.Metrics != nil {
		attrs = append(attrs, "metrics", err.Metrics)
	}
	if err.Cause != nil {
		attrs = append(attrs, "cause", err.Cause)
	}

	switch err.Severity {
	case SeverityCritical:
		el.logger.Error(err.Message, attrs...)
	case SeverityHigh:
		el.logger.Error(err.Message, attrs...)
	case SeverityMedium:
		el.logger.Warn(err.Message, attrs...)
	case SeverityLow:
		el.logger.Info(err.Message, attrs...)
	default:
		el.logger.Error(err.Message, attrs...)
	}
{{end}}
}

// ErrorRegistry maintains a registry of known error codes
type ErrorRegistry struct {
	errors map[string]*ErrorDefinition
}

// ErrorDefinition defines metadata for an error code
type ErrorDefinition struct {
	Code        string
	Type        ErrorType
	Message     string
	Severity    ErrorSeverity
	Retryable   bool
	Description string
	Resolution  string
}

// NewErrorRegistry creates a new error registry
func NewErrorRegistry() *ErrorRegistry {
	return &ErrorRegistry{
		errors: make(map[string]*ErrorDefinition),
	}
}

// Register registers an error definition
func (er *ErrorRegistry) Register(def *ErrorDefinition) {
	er.errors[def.Code] = def
}

// Get retrieves an error definition by code
func (er *ErrorRegistry) Get(code string) (*ErrorDefinition, bool) {
	def, exists := er.errors[code]
	return def, exists
}

// CreateError creates an enhanced error from a registered definition
func (er *ErrorRegistry) CreateError(code string, details interface{}) *EnhancedError {
	def, exists := er.errors[code]
	if !exists {
		return InternalError("UNKNOWN_ERROR", fmt.Sprintf("Unknown error code: %s", code), nil)
	}
	
	return NewError(def.Type, def.Code, def.Message).
		WithDetails(details).
		WithSeverity(def.Severity).
		WithRetryable(def.Retryable).
		Build()
}

// GetAllDefinitions returns all registered error definitions
func (er *ErrorRegistry) GetAllDefinitions() map[string]*ErrorDefinition {
	result := make(map[string]*ErrorDefinition)
	for k, v := range er.errors {
		result[k] = v
	}
	return result
}