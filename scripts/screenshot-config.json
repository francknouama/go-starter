{
  "name": "go-starter Web UI Screenshot Configuration",
  "version": "1.0.0",
  "description": "Configuration for automated screenshot generation of go-starter Web UI",
  
  "servers": {
    "frontend": {
      "url": "http://localhost:3000",
      "port": 3000,
      "startCommand": "npm run dev",
      "healthCheck": "/",
      "timeout": 60000
    },
    "backend": {
      "url": "http://localhost:8080", 
      "port": 8080,
      "startCommand": "go run cmd/web-server/main.go",
      "healthCheck": "/api/health",
      "timeout": 30000
    }
  },

  "output": {
    "directory": "./docs/screenshots",
    "format": "png",
    "quality": 90,
    "fullPage": true,
    "omitBackground": false
  },

  "viewports": {
    "desktop": { "width": 1920, "height": 1080 },
    "desktopLarge": { "width": 2560, "height": 1440 },
    "tablet": { "width": 768, "height": 1024 },
    "tabletLandscape": { "width": 1024, "height": 768 },
    "mobile": { "width": 375, "height": 667 },
    "mobileLarge": { "width": 414, "height": 896 }
  },

  "browsers": {
    "chromium": { "enabled": true, "headless": true },
    "firefox": { "enabled": false, "headless": true },
    "webkit": { "enabled": false, "headless": true }
  },

  "scenarios": {
    "basicCli": {
      "name": "simple-cli-tool",
      "type": "cli-simple", 
      "framework": "cobra",
      "logger": "slog",
      "module": "github.com/user/simple-cli-tool",
      "description": "Basic CLI tool with minimal configuration",
      "tags": ["cli", "simple", "beginner"]
    },
    "standardWebApi": {
      "name": "rest-api-service",
      "type": "web-api-standard",
      "framework": "gin", 
      "logger": "slog",
      "module": "github.com/company/rest-api-service",
      "database": "postgres",
      "description": "Standard REST API with database",
      "tags": ["web-api", "rest", "database"]
    },
    "advancedMicroservice": {
      "name": "user-microservice",
      "type": "microservice-standard",
      "framework": "gin",
      "logger": "zap", 
      "module": "github.com/enterprise/user-microservice",
      "database": "postgres",
      "auth": "jwt",
      "observability": "prometheus",
      "description": "Enterprise microservice with full observability",
      "tags": ["microservice", "enterprise", "observability"]
    },
    "enterpriseMonolith": {
      "name": "e-commerce-platform",
      "type": "monolith",
      "framework": "gin",
      "logger": "zap",
      "module": "github.com/enterprise/ecommerce-platform", 
      "database": "postgres",
      "auth": "oauth2",
      "cache": "redis",
      "description": "Full-stack monolithic application",
      "tags": ["monolith", "enterprise", "full-stack"]
    },
    "grpcGateway": {
      "name": "api-gateway",
      "type": "grpc-gateway",
      "framework": "grpc",
      "logger": "zap",
      "module": "github.com/company/api-gateway",
      "database": "postgres", 
      "description": "Dual HTTP/gRPC API gateway",
      "tags": ["grpc", "gateway", "dual-protocol"]
    },
    "serverlessLambda": {
      "name": "event-processor",
      "type": "lambda-standard", 
      "framework": "aws-lambda",
      "logger": "slog",
      "module": "github.com/serverless/event-processor",
      "description": "AWS Lambda serverless function",
      "tags": ["serverless", "lambda", "aws"]
    }
  },

  "categories": {
    "interface": {
      "name": "Core Interface",
      "description": "Primary UI components and layout",
      "priority": 1,
      "screenshots": [
        {
          "filename": "web-ui/01-landing-page.png",
          "description": "Professional React interface with branding and navigation",
          "viewport": "desktop",
          "fullPage": true,
          "essential": true
        },
        {
          "filename": "web-ui/02-blueprint-gallery.png", 
          "description": "Showcase of 12 production-ready blueprint templates",
          "viewport": "desktop",
          "selector": ".blueprint-gallery, [data-testid=\"blueprint-selection\"]",
          "essential": true
        },
        {
          "filename": "web-ui/03-navigation-system.png",
          "description": "Header, sidebar, and menu components",
          "viewport": "desktop",
          "fullPage": true,
          "essential": false
        },
        {
          "filename": "web-ui/04-configuration-panel.png",
          "description": "Dynamic configuration forms with progressive disclosure", 
          "viewport": "desktop",
          "selector": "[data-testid=\"configuration-panel\"]",
          "essential": true
        },
        {
          "filename": "web-ui/05-preview-panel.png",
          "description": "Real-time code preview with syntax highlighting",
          "viewport": "desktop",
          "selector": "[data-testid=\"preview-panel\"]",
          "essential": true
        },
        {
          "filename": "web-ui/06-file-explorer.png",
          "description": "File tree visualization with live updates",
          "viewport": "desktop",
          "selector": "[data-testid=\"file-explorer-panel\"]",
          "essential": false
        }
      ]
    },

    "workflow": {
      "name": "User Workflows",
      "description": "Complete user journeys and interactions",
      "priority": 2,
      "screenshots": [
        {
          "filename": "workflows/01-initial-state.png",
          "description": "Clean interface ready for project configuration",
          "viewport": "desktop",
          "fullPage": true,
          "essential": true
        },
        {
          "filename": "workflows/02-project-type-selected.png", 
          "description": "Project type selection with context-aware options",
          "viewport": "desktop",
          "fullPage": true,
          "essential": false
        },
        {
          "filename": "workflows/03-basic-configuration.png",
          "description": "Basic project configuration filled out", 
          "viewport": "desktop",
          "fullPage": true,
          "essential": false
        },
        {
          "filename": "workflows/04-advanced-options.png",
          "description": "Advanced configuration options revealed",
          "viewport": "desktop", 
          "fullPage": true,
          "essential": false
        },
        {
          "filename": "workflows/05-preview-generated.png",
          "description": "Real-time preview showing generated project structure",
          "viewport": "desktop",
          "fullPage": true,
          "essential": false
        },
        {
          "filename": "workflows/06-ready-to-generate.png",
          "description": "Project ready for generation with preview complete",
          "viewport": "desktop",
          "fullPage": true,
          "essential": false
        }
      ]
    },

    "features": {
      "name": "Feature Demonstrations", 
      "description": "Specific functionality showcases",
      "priority": 3,
      "screenshots": [
        {
          "filename": "features/real-time-preview-1.png",
          "description": "Real-time preview showing basic web API structure",
          "viewport": "desktop",
          "fullPage": true,
          "essential": false
        },
        {
          "filename": "features/real-time-preview-2.png",
          "description": "Real-time preview updated for microservice architecture",
          "viewport": "desktop", 
          "fullPage": true,
          "essential": false
        },
        {
          "filename": "features/progressive-disclosure-basic.png",
          "description": "Basic mode showing essential configuration options only",
          "viewport": "desktop",
          "fullPage": true,
          "essential": false
        },
        {
          "filename": "features/progressive-disclosure-advanced.png",
          "description": "Advanced mode revealing additional configuration options",
          "viewport": "desktop",
          "fullPage": true,
          "essential": false
        },
        {
          "filename": "features/mobile-responsive.png",
          "description": "Mobile-optimized interface with touch-friendly controls",
          "viewport": "mobile",
          "fullPage": true,
          "essential": false
        },
        {
          "filename": "features/form-validation.png",
          "description": "Form validation with helpful error messages",
          "viewport": "desktop",
          "fullPage": true,
          "essential": false
        }
      ]
    },

    "responsive": {
      "name": "Responsive Design",
      "description": "Multi-device compatibility demonstration", 
      "priority": 4,
      "screenshots": [
        {
          "filename": "responsive/desktop/full-interface.png",
          "description": "Full desktop interface at 1920x1080",
          "viewport": "desktop",
          "fullPage": true,
          "essential": true
        },
        {
          "filename": "responsive/desktop/large-desktop.png",
          "description": "Large desktop interface at 2560x1440",
          "viewport": "desktopLarge",
          "fullPage": true,
          "essential": false
        },
        {
          "filename": "responsive/tablet/portrait.png",
          "description": "Tablet portrait view at 768x1024",
          "viewport": "tablet", 
          "fullPage": true,
          "essential": false
        },
        {
          "filename": "responsive/tablet/landscape.png",
          "description": "Tablet landscape view at 1024x768",
          "viewport": "tabletLandscape",
          "fullPage": true,
          "essential": false
        },
        {
          "filename": "responsive/mobile/standard.png",
          "description": "Mobile view at 375x667 (iPhone SE size)",
          "viewport": "mobile",
          "fullPage": true,
          "essential": true
        },
        {
          "filename": "responsive/mobile/large.png", 
          "description": "Large mobile view at 414x896 (iPhone 11 size)",
          "viewport": "mobileLarge",
          "fullPage": true,
          "essential": false
        }
      ]
    },

    "states": {
      "name": "Application States",
      "description": "Different application states and conditions",
      "priority": 5,
      "screenshots": [
        {
          "filename": "states/01-loading.png",
          "description": "Loading state with professional loading indicators",
          "viewport": "desktop",
          "fullPage": true,
          "essential": false
        },
        {
          "filename": "states/02-empty-state.png",
          "description": "Clean initial state ready for user input",
          "viewport": "desktop", 
          "fullPage": true,
          "essential": false
        },
        {
          "filename": "states/03-validation-errors.png",
          "description": "Form validation errors with helpful messaging",
          "viewport": "desktop",
          "fullPage": true,
          "essential": false
        },
        {
          "filename": "states/04-success-state.png",
          "description": "Successful configuration with preview generated",
          "viewport": "desktop",
          "fullPage": true,
          "essential": false
        }
      ]
    }
  },

  "selectors": {
    "configurationPanel": "[data-testid=\"configuration-panel\"], .configuration-panel, form",
    "previewPanel": "[data-testid=\"preview-panel\"], .preview-panel, .code-preview", 
    "fileExplorerPanel": "[data-testid=\"file-explorer-panel\"], .file-explorer, .files",
    "projectName": "input[name=\"name\"], [data-testid=\"project-name\"]",
    "projectType": "select[name=\"type\"], [data-testid=\"project-type\"]",
    "modulePath": "input[name=\"module\"], [data-testid=\"module-path\"]",
    "framework": "select[name=\"framework\"], [data-testid=\"framework\"]",
    "logger": "select[name=\"logger\"], [data-testid=\"logger\"]",
    "generateButton": "[data-testid=\"generate-button\"], button[type=\"submit\"]",
    "advancedToggle": "[data-testid=\"advanced-toggle\"], .advanced-toggle",
    "themeToggle": "[data-testid=\"theme-toggle\"], .theme-toggle, .dark-mode-toggle"
  },

  "timing": {
    "pageLoadTimeout": 30000,
    "elementTimeout": 10000,
    "animationDelay": 1000,
    "formFillDelay": 200,
    "screenshotDelay": 500
  },

  "validation": {
    "minimumFileSize": 10240,
    "essentialScreenshots": [
      "web-ui/01-landing-page.png",
      "web-ui/02-blueprint-gallery.png",
      "web-ui/04-configuration-panel.png", 
      "web-ui/05-preview-panel.png",
      "workflows/01-initial-state.png",
      "responsive/desktop/full-interface.png",
      "responsive/mobile/standard.png"
    ]
  },

  "documentation": {
    "generateIndex": true,
    "generateGallery": true,
    "generateMetadata": true,
    "indexFilename": "README.md",
    "galleryFilename": "gallery.html",
    "metadataFilename": "screenshots-metadata.json"
  }
}